{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " 󰅂 "
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "magenta",
        "at": "white",
        "host": "blue"
      }
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": " Kernel",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "󰥔 Uptime",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": " WM",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "󰆍 Terminal",
      "keyColor": "magenta"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "magenta"
    },
    {
      "type": "gpu",
      "key": "󰍛 GPU",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory",
      "keyColor": "cyan"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
