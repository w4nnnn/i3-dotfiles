/**
 * Catppuccin Mocha - Modern Horizontal Power Menu (Lucide Icons Only)
 **/

configuration {
    show-icons: false;
}

* {
    bg:          #1e1e2ed0;
    surface0:    #313244d0;
    fg:          #cdd6f4;
    mauve:       #cba6f7;
    red:         #f38ba8;
    crust:       #11111b;
}

window {
    transparency:       "real";
    location:           center;
    anchor:             center;
    fullscreen:         false;
    width:              540px;
    border:             2px solid;
    border-color:       @mauve;
    border-radius:      16px;
    background-color:   @bg;
    padding:            20px;
}

mainbox {
    background-color:   transparent;
    spacing:            14px;
    children:           [ "message", "listview" ];
}

message {
    background-color:   @surface0;
    border-radius:      12px;
    padding:            10px 16px;
}

textbox {
    background-color:   transparent;
    text-color:         @fg;
    font:               "JetBrainsMono Nerd Font 10.5";
    horizontal-align:   0.5;
    vertical-align:     0.5;
}

listview {
    background-color:   transparent;
    columns:            5;
    lines:              1;
    spacing:            10px;
    cycle:              true;
    dynamic:            true;
    layout:             vertical;
}

element {
    background-color:   @surface0;
    text-color:         @fg;
    border-radius:      12px;
    padding:            18px 0px;
    cursor:             pointer;
    border:             1.5px solid;
    border-color:       transparent;
}

element-text {
    font:               "lucide 24";
    background-color:   transparent;
    text-color:         inherit;
    cursor:             inherit;
    vertical-align:     0.5;
    horizontal-align:   0.5;
}

element selected.normal {
    background-color:   @mauve;
    text-color:         @crust;
    border-color:       @mauve;
}
