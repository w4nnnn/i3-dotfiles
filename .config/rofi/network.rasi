/**
 * Catppuccin Mocha - Network Manager Menu (networkmanager_dmenu)
 **/

configuration {
    show-icons:                 false;
    font:                       "JetBrainsMono Nerd Font 10.5";
}

* {
    bg:          #1e1e2ed0;
    surface0:    #313244d0;
    fg:          #cdd6f4;
    mauve:       #cba6f7;
    blue:        #89b4fa;
    green:       #a6e3a1;
    red:         #f38ba8;
    crust:       #11111b;
    grey:        #6c7086;
}

window {
    transparency:       "real";
    location:           center;
    anchor:             center;
    fullscreen:         false;
    width:              500px;
    border:             2px solid;
    border-color:       @mauve;
    border-radius:      16px;
    background-color:   @bg;
    padding:            18px;
}

mainbox {
    background-color:   transparent;
    spacing:            12px;
    children:           [ "inputbar", "message", "listview" ];
}

inputbar {
    background-color:   @surface0;
    border-radius:      10px;
    padding:            8px 12px;
    children:           [ "prompt", "entry" ];
}

prompt {
    background-color:   transparent;
    text-color:         @mauve;
    font:               "JetBrainsMono Nerd Font Bold 10.5";
    margin:             0px 6px 0px 0px;
}

entry {
    background-color:   transparent;
    text-color:         @fg;
    placeholder:        "Search or enter password...";
    placeholder-color:  @grey;
}

message {
    background-color:   @surface0;
    border-radius:      8px;
    padding:            8px 12px;
}

textbox {
    background-color:   transparent;
    text-color:         @blue;
    font:               "JetBrainsMono Nerd Font 10";
}

listview {
    background-color:   transparent;
    columns:            1;
    lines:              7;
    spacing:            6px;
    cycle:              true;
    dynamic:            true;
}

element {
    background-color:   transparent;
    text-color:         @fg;
    border-radius:      10px;
    padding:            8px 12px;
    cursor:             pointer;
}

element-text {
    font:               "JetBrainsMono Nerd Font 10.5";
    background-color:   transparent;
    text-color:         inherit;
    cursor:             inherit;
    vertical-align:     0.5;
}

element selected.normal {
    background-color:   @mauve;
    text-color:         @crust;
}
