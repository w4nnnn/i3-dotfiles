/**
 * Rofi Configuration - Windows 11 Start Menu Style (Catppuccin Mocha)
 * Modern floating card with Search, Pinned Grid, and User/Power Footer
 **/

configuration {
    modi:                       "drun,run,window";
    show-icons:                 true;
    icon-theme:                 "Papirus-Dark";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

* {
    bg:             #1e1e2ef0;
    surface0:       #313244;
    surface1:       #45475a;
    border-col:     #cba6f7;
    fg:             #cdd6f4;
    subtext:        #a6adc8;
    overlay:        #6c7086;
    mauve:          #cba6f7;
    blue:           #89b4fa;
    red:            #f38ba8;
    crust:          #11111b;

    background-color:   transparent;
    text-color:         @fg;
    margin:             0;
    padding:            0;
    spacing:            0;
}

window {
    transparency:       "real";
    location:           center;
    anchor:             center;
    fullscreen:         false;
    width:              680px;
    height:             580px;
    border:             2px solid;
    border-color:       @border-col;
    border-radius:      20px;
    background-color:   @bg;
    padding:            20px 24px;
}

mainbox {
    spacing:            14px;
    children:           [ "inputbar", "box-header", "listview", "box-footer" ];
}

/* --- Windows 11 Search Pill --- */
inputbar {
    background-color:   @surface0;
    border-radius:      12px;
    padding:            10px 16px;
    spacing:            10px;
    children:           [ "icon-search", "entry" ];
}

icon-search {
    expand:             false;
    filename:           "search-symbolic";
    size:               18px;
    vertical-align:     0.5;
}

entry {
    font:               "JetBrainsMono Nerd Font 10.5";
    text-color:         @fg;
    placeholder:        "Search for apps, settings, and documents...";
    placeholder-color:  @overlay;
    vertical-align:     0.5;
}

/* --- Section Title "Pinned" & "All apps >" --- */
box-header {
    orientation:        horizontal;
    padding:            4px 8px 0px 8px;
    children:           [ "textbox-pinned", "dummy-header", "textbox-allapps" ];
}

textbox-pinned {
    str:                "Pinned";
    font:               "JetBrainsMono Nerd Font Bold 11";
    text-color:         @fg;
    vertical-align:     0.5;
}

dummy-header {
    expand:             true;
}

textbox-allapps {
    str:                "All apps  >";
    font:               "JetBrainsMono Nerd Font 10";
    text-color:         @mauve;
    vertical-align:     0.5;
}

/* --- 6 Columns x 3 Rows App Grid --- */
listview {
    columns:            6;
    lines:              3;
    spacing:            8px;
    cycle:              true;
    dynamic:            true;
    layout:             vertical;
    flow:               horizontal;
    fixed-height:       true;
    fixed-columns:      true;
}

element {
    orientation:        vertical;
    spacing:            6px;
    padding:            10px 4px;
    border-radius:      10px;
    background-color:   transparent;
    text-color:         @fg;
    cursor:             pointer;
}

element selected.normal {
    background-color:   @surface0;
    text-color:         @mauve;
    border:             1.5px solid;
    border-color:       @mauve;
}

element-icon {
    size:               38px;
    horizontal-align:   0.5;
    background-color:   transparent;
    cursor:             inherit;
}

element-text {
    font:               "JetBrainsMono Nerd Font 9.5";
    horizontal-align:   0.5;
    text-color:         inherit;
    cursor:             inherit;
}

/* --- Bottom User Profile & Power Button Footer --- */
box-footer {
    orientation:        horizontal;
    border:             1px 0px 0px 0px solid;
    border-color:       @surface0;
    padding:            14px 10px 4px 10px;
    children:           [ "textbox-user", "dummy-footer", "textbox-power" ];
}

textbox-user {
    str:                "  w4nn";
    font:               "JetBrainsMono Nerd Font Bold 10.5";
    text-color:         @fg;
    vertical-align:     0.5;
}

dummy-footer {
    expand:             true;
}

textbox-power {
    str:                "⏻";
    font:               "JetBrainsMono Nerd Font Bold 13";
    text-color:         @red;
    vertical-align:     0.5;
}
