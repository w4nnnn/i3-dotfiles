/**
 * Rofi Configuration - Catppuccin Mocha Theme
 **/

configuration {
    modi:                       "drun,run,window";
    font:                       "JetBrainsMono Nerd Font 10";
    show-icons:                 true;
    icon-theme:                 "Papirus-Dark";
    display-drun:               "   Apps ";
    display-run:                "   Run ";
    display-window:             "   Windows ";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

* {
    bg-col:  #1e1e2e;
    bg-col-light: #313244;
    border-col: #cba6f7;
    selected-col: #313244;
    blue: #89b4fa;
    fg-col: #cdd6f4;
    fg-col2: #f38ba8;
    grey: #6c7086;
    mauve: #cba6f7;

    width: 600;
    font: "JetBrainsMono Nerd Font 10";
}

element-text, element-icon , mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height: 400px;
    border: 2px;
    border-color: @border-col;
    border-radius: 12px;
    background-color: @bg-col;
    padding: 10px;
}

mainbox {
    background-color: @bg-col;
    children: [ inputbar, listview, mode-switcher ];
    spacing: 10px;
    padding: 10px;
}

inputbar {
    children: [entry];
    background-color: @bg-col-light;
    border-radius: 8px;
    padding: 4px;
}

prompt {
    background-color: @blue;
    padding: 8px 12px;
    text-color: @bg-col;
    border-radius: 6px;
    margin: 0px 5px 0px 0px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    padding: 8px 12px;
    text-color: @fg-col;
    background-color: @bg-col-light;
    placeholder: "Search apps...";
    placeholder-color: @grey;
}

listview {
    border: 0px 0px 0px;
    padding: 6px 0px 0px;
    margin: 10px 0px 0px 20px;
    columns: 1;
    lines: 6;
    background-color: @bg-col;
}

element {
    padding: 8px 12px;
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 8px;
}

element-icon {
    size: 24px;
    margin: 0px 10px 0px 0px;
}

element selected {
    background-color:  @selected-col ;
    text-color: @mauve  ;
}

mode-switcher {
    spacing: 10px;
}

button {
    padding: 8px 12px;
    background-color: @bg-col-light;
    text-color: @grey;
    vertical-align: 0.5; 
    horizontal-align: 0.5;
    border-radius: 8px;
}

button selected {
    background-color: @mauve;
    text-color: @bg-col;
}

message {
    background-color: @bg-col-light;
    margin: 2px;
    padding: 2px;
    border-radius: 5px;
}

textbox {
    padding: 6px;
    margin: 20px 0px 0px 20px;
    text-color: @blue;
    background-color: @bg-col-light;
}
