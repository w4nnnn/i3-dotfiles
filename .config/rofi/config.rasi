/**
 * Rofi Configuration - Spotlight / Raycast Style (Catppuccin Mocha)
 * Minimalist, elegant, and modern floating launcher
 **/

configuration {
    modi:                       "drun,run,window";
    font:                       "JetBrainsMono Nerd Font 11";
    show-icons:                 true;
    icon-theme:                 "Papirus-Dark";
    display-drun:               "";
    display-run:                "";
    display-window:             "";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

* {
    bg:          #1e1e2ee6;
    surface0:    #313244;
    surface1:    #45475a;
    fg:          #cdd6f4;
    subtext:     #a6adc8;
    overlay:     #6c7086;
    mauve:       #cba6f7;
    blue:        #89b4fa;
    crust:       #11111b;

    background-color:   transparent;
    text-color:         @fg;
    margin:             0;
    padding:            0;
    spacing:            0;
}

window {
    transparency:       "real";
    location:           center;
    anchor:             center;
    fullscreen:         false;
    width:              640px;
    border:             2px solid;
    border-color:       @mauve;
    border-radius:      16px;
    background-color:   @bg;
}

mainbox {
    spacing:            0px;
    children:           [ "inputbar", "message", "listview" ];
}

/* --- Clean Search Bar (Spotlight Style) --- */
inputbar {
    padding:            16px 20px;
    spacing:            14px;
    border:             0px 0px 1px 0px solid;
    border-color:       @surface0;
    background-color:   transparent;
    children:           [ "prompt", "entry" ];
}

prompt {
    text-color:         @mauve;
    font:               "JetBrainsMono Nerd Font Bold 13";
    vertical-align:     0.5;
}

entry {
    font:               "JetBrainsMono Nerd Font 11.5";
    text-color:         @fg;
    placeholder:        "Search apps, commands, windows...";
    placeholder-color:  @overlay;
    vertical-align:     0.5;
}

message {
    padding:            8px 20px;
    background-color:   @surface0;
    border:             0px 0px 1px 0px solid;
    border-color:       @surface1;
}

textbox {
    text-color:         @blue;
    font:               "JetBrainsMono Nerd Font 10";
}

/* --- Spacious App List --- */
listview {
    padding:            10px 12px;
    lines:              8;
    columns:            1;
    spacing:            4px;
    cycle:              true;
    dynamic:            true;
    fixed-height:       false;
}

element {
    padding:            10px 14px;
    spacing:            14px;
    border-radius:      10px;
    background-color:   transparent;
    text-color:         @fg;
    cursor:             pointer;
}

element normal.urgent {
    text-color:         #f38ba8;
}

element normal.active {
    text-color:         @mauve;
}

element selected.normal, element selected.active {
    background-color:   @surface0;
    text-color:         @mauve;
}

element selected.urgent {
    background-color:   #f38ba8;
    text-color:         @crust;
}

element-icon {
    size:               28px;
    vertical-align:     0.5;
    cursor:             inherit;
    background-color:   transparent;
}

element-text {
    font:               "JetBrainsMono Nerd Font 11";
    text-color:         inherit;
    vertical-align:     0.5;
    cursor:             inherit;
}
