/**
 * ROFI Theme - Windows 11 Grid (Catppuccin Mocha)
 * Adapted from: https://github.com/newmanls/rofi-themes-collection (windows11-grid-dark.rasi)
 **/

configuration {
  modi:                       "drun,run,window";
  show-icons:                 true;
  icon-theme:                 "Papirus-Dark";
  font:                       "JetBrainsMono Nerd Font 10";
  drun-display-format:        "{name}";
  window-format:              "{w} · {c} · {t}";
}

* {
  font: "JetBrainsMono Nerd Font 10";

  bg0    : #181825cc;
  bg1    : #1e1e2ee6;
  bg2    : #313244;
  bg3    : #45475a;
  fg0    : #cdd6f4;
  fg1    : #a6adc8;
  accent : #cba6f7;
  urgent : #f38ba8;

  background-color : transparent;
  text-color       : @fg0;

  margin  : 0;
  padding : 0;
  spacing : 0;
}

element-icon, element-text, scrollbar {
  cursor: pointer;
}

window {
  location : center;
  width    : 660px;
  height   : 580px;

  background-color : @bg1;
  border           : 2px solid;
  border-color     : @accent;
  border-radius    : 16px;
}

mainbox {
  padding : 24px;
  spacing : 20px;
  children: [ inputbar, listview ];
}

inputbar {
  padding          : 10px 14px;
  spacing          : 10px;
  children         : [ icon-search, entry ];
  border           : 0 0 2px 0 solid;
  border-color     : @accent;
  border-radius    : 8px;
  background-color : @bg0;
}

icon-search, entry, element-icon, element-text {
  vertical-align: 0.5;
}

icon-search {
  expand   : false;
  filename : "search-symbolic";
  size     : 20px;
}

entry {
  font              : "JetBrainsMono Nerd Font 11";
  placeholder       : "Type here to search";
  placeholder-color : @fg1;
}

textbox {
  padding          : 6px 10px;
  background-color : @bg2;
  border-radius    : 6px;
}

listview {
  columns       : 6;
  lines         : 4;
  spacing       : 10px;
  fixed-height  : true;
  fixed-columns : true;
}

element {
  orientation   : vertical;
  spacing       : 6px;
  padding       : 12px 6px;
  border-radius : 8px;
}

element normal urgent {
  text-color: @urgent;
}

element normal active {
  text-color: @accent;
}

element alternate active {
  text-color: @accent;
}

element selected active {
  text-color: @accent;
}

element selected {
  background-color: @bg3;
  text-color: @accent;
}

element selected urgent {
  background-color: @urgent;
}

element-icon {
  size: 40px;
  horizontal-align: 0.5;
}

element-text {
  text-color       : inherit;
  horizontal-align : 0.5;
}
