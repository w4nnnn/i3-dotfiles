/**
 * Rofi Configuration - Windows 11 Grid Style (Catppuccin Mocha)
 **/

configuration {
    modi:                       "drun,run,window";
    font:                       "JetBrainsMono Nerd Font 10";
    show-icons:                 true;
    icon-theme:                 "Papirus-Dark";
    display-drun:               "";
    display-run:                "";
    display-window:             "";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

* {
    bg-col:         #1e1e2e;
    surface0:       #313244;
    surface1:       #45475a;
    border-col:     #cba6f7;
    fg-col:         #cdd6f4;
    grey:           #6c7086;
    mauve:          #cba6f7;
    blue:           #89b4fa;
    crust:          #11111b;
}

window {
    transparency:       "real";
    location:           center;
    anchor:             center;
    fullscreen:         false;
    width:              680px;
    height:             540px;
    border:             2px solid;
    border-color:       @border-col;
    border-radius:      20px;
    background-color:   @bg-col;
    padding:            22px;
}

mainbox {
    background-color:   transparent;
    spacing:            16px;
    children:           [ "inputbar", "listview" ];
}

/* --- Search Bar Pill --- */
inputbar {
    background-color:   @surface0;
    border-radius:      12px;
    padding:            10px 16px;
    spacing:            10px;
    children:           [ "prompt", "entry" ];
}

prompt {
    background-color:   transparent;
    text-color:         @mauve;
    font:               "JetBrainsMono Nerd Font Bold 12";
    vertical-align:     0.5;
}

entry {
    background-color:   transparent;
    text-color:         @fg-col;
    font:               "JetBrainsMono Nerd Font 10.5";
    placeholder:        "Search for apps, settings, and documents...";
    placeholder-color:  @grey;
    vertical-align:     0.5;
}

/* --- Windows 11 App Grid (5 columns x 4 rows) --- */
listview {
    background-color:   transparent;
    columns:            5;
    lines:              4;
    spacing:            10px;
    cycle:              true;
    dynamic:            true;
    layout:             vertical;
    flow:               horizontal;
}

element {
    background-color:   transparent;
    text-color:         @fg-col;
    border-radius:      12px;
    padding:            14px 6px;
    orientation:        vertical;
    cursor:             pointer;
}

element-icon {
    size:               44px;
    horizontal-align:   0.5;
    background-color:   transparent;
    cursor:             inherit;
}

element-text {
    font:               "JetBrainsMono Nerd Font 10";
    background-color:   transparent;
    text-color:         inherit;
    horizontal-align:   0.5;
    cursor:             inherit;
    margin:             8px 0px 0px 0px;
}

element selected.normal {
    background-color:   @surface0;
    text-color:         @mauve;
    border:             1.5px solid;
    border-color:       @mauve;
}
