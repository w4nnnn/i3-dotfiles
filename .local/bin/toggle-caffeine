#!/usr/bin/env python3
"""
Catppuccin / Multi-Theme Caffeine Toggle Helper
Toggles Caffeine mode (disabling X11 screensaver, DPMS sleep, and auto-lock)
"""
import sys
import os
import signal
import subprocess

CAFFEINE_STATE_FILE = "/tmp/caffeine_mode.state"
CAFFEINE_PID_FILE = "/tmp/caffeine_inhibitor.pid"

def get_caffeine_status():
    if os.path.exists(CAFFEINE_STATE_FILE):
        try:
            with open(CAFFEINE_STATE_FILE, "r") as f:
                return f.read().strip() == "on"
        except Exception:
            pass
    return False

def turn_off_caffeine(notify=True):
    # Restore normal X11 screensaver & DPMS
    subprocess.run(["xset", "s", "on", "+dpms"], stderr=subprocess.DEVNULL)

    # Terminate inhibitor process if active
    if os.path.exists(CAFFEINE_PID_FILE):
        try:
            with open(CAFFEINE_PID_FILE, "r") as f:
                pid = int(f.read().strip())
            os.kill(pid, signal.SIGTERM)
        except Exception:
            pass
        try:
            os.remove(CAFFEINE_PID_FILE)
        except Exception:
            pass

    try:
        with open(CAFFEINE_STATE_FILE, "w") as f:
            f.write("off")
    except Exception:
        pass

    if notify:
        subprocess.Popen([
            "dunstify", "-a", "Caffeine",
            "-h", "string:x-dunst-stack-tag:caffeine",
            "-i", "caffeine",
            "-t", "2000", "-u", "low",
            "☕ Caffeine Disabled", "Normal screen sleep & auto-lock restored."
        ], stderr=subprocess.DEVNULL)
    return False

def toggle_caffeine():
    is_on = get_caffeine_status()
    if is_on:
        return turn_off_caffeine(notify=True)
    else:
        # Turn ON
        subprocess.run(["xset", "s", "off", "-dpms"], stderr=subprocess.DEVNULL)
        try:
            # Inhibit idle and sleep only (never block shutdown/reboot)
            p = subprocess.Popen([
                "systemd-inhibit",
                "--what=idle:sleep",
                "--who=Caffeine",
                "--why=Caffeine Mode Active",
                "sleep", "infinity"
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            with open(CAFFEINE_PID_FILE, "w") as f:
                f.write(str(p.pid))
        except Exception:
            pass

        try:
            with open(CAFFEINE_STATE_FILE, "w") as f:
                f.write("on")
        except Exception:
            pass

        subprocess.Popen([
            "dunstify", "-a", "Caffeine",
            "-h", "string:x-dunst-stack-tag:caffeine",
            "-i", "caffeine",
            "-t", "2000", "-u", "low",
            "☕ Caffeine Active", "Screen sleep & auto-lock disabled."
        ], stderr=subprocess.DEVNULL)
        return True

def main():
    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        if arg == "status":
            print("on" if get_caffeine_status() else "off")
            return
        elif arg in ("off", "stop", "disable"):
            turn_off_caffeine(notify=False)
            return
        elif arg in ("on", "start", "enable"):
            if not get_caffeine_status():
                toggle_caffeine()
            return
    toggle_caffeine()

if __name__ == "__main__":
    main()
