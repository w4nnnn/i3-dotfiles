        }}
        button.footer-action-btn:hover,
        .footer-action-btn:hover {{
            background-color: {t["surface1"]};
            color: {t["accent"]};
        }}
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css.encode("utf-8"))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def _build_ui(self):
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        main_box.set_name("main-card")
        main_box.set_size_request(560, 420)
        self.add(main_box)

        # 1. Header Box
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        header.set_name("header-box")

        hdr_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title_lbl = Gtk.Label(label="󰓃 Audio Output Selector", xalign=0)
        title_lbl.set_name("hdr-title")
        hdr_vbox.pack_start(title_lbl, False, False, 0)

        self.status_lbl = Gtk.Label(label="Select audio sink device", xalign=0)
        self.status_lbl.set_name("hdr-status")
        hdr_vbox.pack_start(self.status_lbl, False, False, 0)

        header.pack_start(hdr_vbox, True, True, 0)

        badge_lbl = Gtk.Label(label="PIPEWIRE / PULSE")
        badge_lbl.get_style_context().add_class("status-badge-active")
        badge_lbl.set_valign(Gtk.Align.CENTER)
        header.pack_start(badge_lbl, False, False, 0)

        main_box.pack_start(header, False, False, 0)

        # 2. Options List Box
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.listbox = Gtk.ListBox()
        self.listbox.set_name("listbox")
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.listbox.connect("row-activated", self.on_row_activated)
        scrolled.add(self.listbox)
        main_box.pack_start(scrolled, True, True, 0)

        self.populate_options()

        # 3. Footer Actions Toolbar
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        footer.set_name("footer-bar")

        rescan_btn = Gtk.Button(label="󰑐 Rescan")
        rescan_btn.get_style_context().add_class("footer-action-btn")
        rescan_btn.set_tooltip_text("Rescan audio sinks (Hotkey: R)")
        rescan_btn.connect("clicked", lambda b: self.rescan_audio())
        footer.pack_start(rescan_btn, False, False, 0)

        mixer_btn = Gtk.Button(label="󰓃 Mixer (Pavucontrol)")
        mixer_btn.get_style_context().add_class("footer-action-btn")
        mixer_btn.set_tooltip_text("Open Volume Mixer (Hotkey: P)")
        mixer_btn.connect("clicked", lambda b: self.launch_mixer())
        footer.pack_start(mixer_btn, False, False, 0)

        test_btn = Gtk.Button(label="󰝚 Test Chime")
        test_btn.get_style_context().add_class("footer-action-btn")
        test_btn.set_tooltip_text("Play test chime on active output (Hotkey: T)")
        test_btn.connect("clicked", lambda b: self.trigger_test_sound())
        footer.pack_start(test_btn, False, False, 0)

        spacer = Gtk.Box()
        footer.pack_start(spacer, True, True, 0)

        close_btn = Gtk.Button(label="Esc Close")
        close_btn.get_style_context().add_class("footer-action-btn")
        close_btn.connect("clicked", lambda b: self.close_and_exit())
        footer.pack_end(close_btn, False, False, 0)

        main_box.pack_start(footer, False, False, 0)

    def populate_options(self):
        for child in self.listbox.get_children():
            self.listbox.remove(child)

        self.items = []
        outputs = get_audio_outputs()
        active_title = "None"

        for idx, out in enumerate(outputs):
            key_num = str(idx + 1) if idx < 9 else ""
            out["key"] = key_num
            self.items.append(out)

            if out.get("is_active"):
                active_title = out.get("full_label", out.get("title"))

            row = Gtk.ListBoxRow()
            row.get_style_context().add_class("audio-row")
            row.out_data = out

            hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            hbox.set_valign(Gtk.Align.CENTER)

            icon_lbl = Gtk.Label(label=out["icon"])
            icon_lbl.get_style_context().add_class("icon-large")
            hbox.pack_start(icon_lbl, False, False, 0)

            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            title = Gtk.Label(label=out["title"], xalign=0)
            title.get_style_context().add_class("row-title")
            vbox.pack_start(title, False, False, 0)

            desc = Gtk.Label(label=out["subtitle"], xalign=0)
            desc.get_style_context().add_class("row-desc")
            desc.set_ellipsize(Pango.EllipsizeMode.END)
            vbox.pack_start(desc, False, False, 0)
            hbox.pack_start(vbox, True, True, 0)

            if out.get("is_active"):
                active_lbl = Gtk.Label(label="● ACTIVE")
                active_lbl.get_style_context().add_class("active-pill")
                active_lbl.set_valign(Gtk.Align.CENTER)
                hbox.pack_start(active_lbl, False, False, 0)

            if key_num:
                k_lbl = Gtk.Label(label=f"[{key_num}]")
                k_lbl.get_style_context().add_class("hotkey-badge")
                k_lbl.set_valign(Gtk.Align.CENTER)
                hbox.pack_start(k_lbl, False, False, 0)

            row.add(hbox)
            self.listbox.add(row)

        self.status_lbl.set_text(f"Active Output: {active_title}")
        self.listbox.show_all()

    def position_window(self):
        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor() or display.get_monitor_at_point(0, 0)
        geom = monitor.get_geometry()

        win_w, win_h = 560, 420
        x = geom.x + (geom.width - win_w) // 2
        y = geom.y + (geom.height - win_h) // 2
        self.move(x, y)

    def rescan_audio(self):
        self.populate_options()
        notify("Audio Rescanned", "Audio sink list refreshed.")

    def launch_mixer(self):
        self.close_and_exit()
        if shutil.which("pavucontrol"):
            subprocess.Popen(["pavucontrol"])
        else:
            subprocess.Popen(["kitty", "--class", "floating_terminal", "-e", "alsamixer"])

    def trigger_test_sound(self):
        play_test_chime()

    def on_row_activated(self, listbox, row):
        if not hasattr(row, "out_data"):
            return
        out = row.out_data
        set_audio_output(out)
        self.populate_options()
        play_test_chime()

    def on_key_press(self, widget, event):
        keyval = event.keyval
        keyname = Gdk.keyval_name(keyval)

        if keyname in ("Escape", "q", "Q"):
            self.close_and_exit()
            return True

        if keyname in ("r", "R"):
            self.rescan_audio()
            return True

        if keyname in ("p", "P"):
            self.launch_mixer()
            return True

        if keyname in ("t", "T"):
            self.trigger_test_sound()
            return True

        # Number hotkeys 1-9
        for item in self.items:
            if item.get("key") == keyname:
                set_audio_output(item)
                self.populate_options()
                play_test_chime()
                return True

        return False

def main():
    signal.signal(signal.SIGINT, lambda s, f: sys.exit(0))
    signal.signal(signal.SIGTERM, lambda s, f: sys.exit(0))

    win = AudioSelectorWindow()
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
