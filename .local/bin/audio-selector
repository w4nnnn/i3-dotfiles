            padding: 8px 12px;
            margin-bottom: 4px;
        }}
        .audio-row:hover,
        .audio-row:selected {{
            background-color: {t["surface0"]};
            border-color: {t["accent"]};
        }}
        .icon-large {{
            color: {t["accent"]};
            font-family: 'JetBrainsMono Nerd Font';
