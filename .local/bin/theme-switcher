#!/usr/bin/env python3
"""
Global Theme Manager for i3wm Catppuccin Dotfiles
Synchronizes theme across Control Center, Rofi, Polybar, i3wm, Kitty, and Dunst.
"""
import os
import sys
import subprocess

# Add local lib to path
lib_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), "../lib"))
if lib_dir not in sys.path:
    sys.path.insert(0, lib_dir)
user_lib = os.path.expanduser("~/.local/lib")
if user_lib not in sys.path:
    sys.path.insert(0, user_lib)

from dotfiles.themes import THEMES, THEME_PREF_FILE, get_current_theme_key
from dotfiles.theme_sync import apply_global_theme

def choose_theme_rofi():
    menu_lines = []
    keys = list(THEMES.keys())
    cur_theme = get_current_theme_key()

    for k in keys:
        name = THEMES[k]["name"]
        prefix = "● " if k == cur_theme else "○ "
        menu_lines.append(f"{prefix}{name}\0info\x1f{k}")

    raw_input = "\n".join(menu_lines)
    try:
        proc = subprocess.Popen(
            ["rofi", "-dmenu", "-p", "󰉼 Theme", "-mesg", "Select Global Desktop Theme", "-i"],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True
        )
        stdout, _ = proc.communicate(input=raw_input)
        chosen = stdout.strip()
        if chosen:
            for k in keys:
                if THEMES[k]["name"] in chosen or k in chosen:
                    apply_global_theme(k)
                    break
    except Exception:
        pass

def main():
    if len(sys.argv) > 1:
        theme = sys.argv[1].lower().strip()
        if theme in THEMES:
            apply_global_theme(theme)
            print(f"Applied theme: {THEMES[theme]['name']}")
        else:
            print(f"Unknown theme: {theme}. Available: {', '.join(THEMES.keys())}")
    else:
        choose_theme_rofi()

if __name__ == "__main__":
    main()
