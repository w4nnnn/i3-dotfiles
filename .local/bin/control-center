#!/usr/bin/env python3
import sys
import os

# Resolve path to control-center package (supports both ~/.config and repo directory)
user_cfg = os.path.expanduser("~/.config/control-center")
repo_cfg = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", ".config", "control-center"))

for path in (user_cfg, repo_cfg):
    if os.path.isdir(path) and path not in sys.path:
        sys.path.insert(0, path)

from window import main

if __name__ == "__main__":
    main()
