#!/usr/bin/env bash

DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"
FILE="$DIR/Screenshot_$(date +'%Y-%m-%d_%H-%M-%S').png"

MODE="$1"

case "$MODE" in
    "full")
        maim -u "$FILE" || exit 1
        xclip -selection clipboard -t image/png -i "$FILE" >/dev/null 2>&1 &
        notify-send -i "$FILE" "Screenshot Saved" "Full screen copied to clipboard & saved to ~/Pictures/Screenshots"
        ;;
    "window")
        ACTIVE_WIN=$(xdotool getactivewindow 2>/dev/null)
        if [ -n "$ACTIVE_WIN" ]; then
            maim -u -i "$ACTIVE_WIN" "$FILE" || exit 1
        else
            maim -u -s -b 2 -c 0.79,0.65,0.97,1.0 "$FILE" || exit 1
        fi
        xclip -selection clipboard -t image/png -i "$FILE" >/dev/null 2>&1 &
        notify-send -i "$FILE" "Screenshot Saved" "Window copied to clipboard & saved to ~/Pictures/Screenshots"
        ;;
    "delay")
        sleep 3
        maim -u "$FILE" || exit 1
        xclip -selection clipboard -t image/png -i "$FILE" >/dev/null 2>&1 &
        notify-send -i "$FILE" "Screenshot Saved" "Full screen (3s delay) copied to clipboard & saved to ~/Pictures/Screenshots"
        ;;
    "select"|*)
        # Interactive selection with slop (crisp 2px border, Catppuccin Mauve color)
        maim -u -s -b 2 -c 0.79,0.65,0.97,1.0 "$FILE" || exit 1
        xclip -selection clipboard -t image/png -i "$FILE" >/dev/null 2>&1 &
        notify-send -i "$FILE" "Screenshot Saved" "Selected area copied to clipboard & saved to ~/Pictures/Screenshots"
        ;;
esac
