#!/usr/bin/env python3
# ==============================================================================
# Catppuccin Mocha - Unified Dynamic Polybar Network Status
# ==============================================================================
import os
import sys
import time
import signal

# Add dotfiles library path
lib_path = os.path.expanduser("~/.local/lib")
if lib_path not in sys.path:
    sys.path.insert(0, lib_path)

try:
    from dotfiles.themes import get_current_theme
except ImportError:
    get_current_theme = lambda: {"green": "#a6e3a1", "red": "#f38ba8"}

def sig_handler(signum, frame):
    sys.exit(0)

signal.signal(signal.SIGTERM, sig_handler)
signal.signal(signal.SIGINT, sig_handler)

def get_default_device():
    try:
        with open("/proc/net/route", "r") as f:
            for line in f:
                fields = line.strip().split()
                if len(fields) >= 2 and fields[1] == "00000000":
                    dev = fields[0]
                    # Verify operstate is not down
                    state_path = f"/sys/class/net/{dev}/operstate"
                    if os.path.exists(state_path):
                        with open(state_path, "r") as sf:
                            if sf.read().strip() == "down":
                                continue
                    return dev
    except Exception:
        pass
    return None

def get_device_bytes(dev):
    try:
        rx_path = f"/sys/class/net/{dev}/statistics/rx_bytes"
        tx_path = f"/sys/class/net/{dev}/statistics/tx_bytes"
        with open(rx_path, "r") as rf:
            rx = int(rf.read().strip())
        with open(tx_path, "r") as tf:
            tx = int(tf.read().strip())
        return rx + tx
    except Exception:
        return 0

def format_speed(bps):
    if bps >= 1048576:
        return f"{bps / 1048576:.1f} MB/s"
    elif bps >= 1024:
        return f"{bps / 1024:.0f} KB/s"
    else:
        return "0 KB/s"

def main():
    prev_dev = None
    prev_bytes = 0
    prev_time = time.time()

    while True:
        t = get_current_theme()
        col_green = t.get("green", "#a6e3a1")
        col_red = t.get("red", "#f38ba8")

        dev = get_default_device()
        now = time.time()
        dt = max(now - prev_time, 0.1)

        if not dev:
            # Lucide wifi-off icon (0xe1af), theme red icon, native subtext "Offline"
            sys.stdout.write(f"%{{F{col_red}}}%{{F-}} Offline\n")
            sys.stdout.flush()
            prev_dev = None
            prev_bytes = 0
            prev_time = now
            time.sleep(2)
            continue

        curr_bytes = get_device_bytes(dev)
        if prev_dev == dev and curr_bytes >= prev_bytes:
            speed = (curr_bytes - prev_bytes) / dt
        else:
            speed = 0

        prev_dev = dev
        prev_bytes = curr_bytes
        prev_time = now

        # Icon selection: Lucide wifi (0xe1ae) for wireless, Lucide network (0xe125) for ethernet
        is_wireless = dev.startswith(("wl", "wlan"))
        icon = "" if is_wireless else ""
        speed_str = format_speed(speed)

        # Dynamic theme colored icon, native bar foreground for speed text (perfect contrast)
        sys.stdout.write(f"%{{F{col_green}}}{icon}%{{F-}} {speed_str}\n")
        sys.stdout.flush()
        time.sleep(2)

if __name__ == "__main__":
    main()
