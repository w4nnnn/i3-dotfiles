            d_lbl.get_style_context().add_class("row-desc")
            d_lbl.set_ellipsize(Pango.EllipsizeMode.END)
            vbox.pack_start(d_lbl, False, False, 0)

            box.pack_start(vbox, True, True, 0)

            key_lbl = Gtk.Label(label=f"[{opt['key']}]")
            key_lbl.get_style_context().add_class("hotkey-badge")
            box.pack_start(key_lbl, False, False, 0)

            row.add(box)
            self.listbox.add(row)

        self.listbox.show_all()
        first_row = self.listbox.get_row_at_index(0)
        if first_row:
            self.listbox.select_row(first_row)

    def position_window(self):
        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor() or display.get_monitor_at_point(0, 0)
        geom = monitor.get_geometry()

        win_w, win_h = 620, 520
        x = geom.x + (geom.width - win_w) // 2
        y = geom.y + (geom.height - win_h) // 2
        self.move(x, y)

    def rescan_displays(self):
        self.internal, self.connected_ext, self.all_outputs = get_displays_info()
        self.populate_options()
        notify("Display Rescanned", f"Detected: {', '.join(self.connected_ext) or 'Internal only'}")

    def launch_arandr(self):
        if shutil.which("arandr"):
            subprocess.Popen(["arandr"])
        else:
            notify("ARandR Not Found", "Install with: sudo pacman -S arandr")

    def on_row_activated(self, listbox, row):
        if not hasattr(row, "opt_data"):
            return
        opt = row.opt_data
        if not opt["enabled"]:
            return

        mode = opt["id"]
        self.apply_mode(mode)

    def apply_mode(self, mode):
        self.close_and_exit()

        internal = self.internal or "eDP-1"
        has_cable = bool(self.connected_ext)
        ext_target = self.connected_ext[0] if has_cable else "HDMI-1"

        def post_hooks():
            # Refresh Polybar multi-monitor
            polybar_launch = os.path.expanduser("~/.config/polybar/launch.sh")
            if os.path.exists(polybar_launch):
                subprocess.Popen([polybar_launch])
            # Restore Wallpaper
            wall_script = os.path.expanduser("~/.local/bin/wallpaper-selector")
            if os.path.exists(wall_script):
                subprocess.Popen([wall_script, "--restore"])
            elif os.path.exists(os.path.expanduser("~/.cache/current_wallpaper")):
                with open(os.path.expanduser("~/.cache/current_wallpaper")) as f:
                    wpath = f.read().strip()
                if os.path.exists(wpath):
                    subprocess.Popen(["feh", "--bg-fill", wpath])

        if mode == "internal":
            cmd = ["xrandr", "--output", internal, "--auto", "--primary"]
            for o in self.all_outputs:
                if o != internal:
                    cmd.extend(["--output", o, "--off"])
            subprocess.run(cmd)
            post_hooks()
            notify("PC Screen Only", "External monitors disconnected.", icon="video-display")

        elif mode == "mirror":
            cmd = ["xrandr", "--output", internal, "--auto", "--primary", "--output", ext_target, "--auto", "--same-as", internal]
            subprocess.run(cmd)
            post_hooks()
            notify("Duplicate / Mirror", f"Screen mirrored with {ext_target}.", icon="video-display")

        elif mode == "extend_right":
            cmd = ["xrandr", "--output", internal, "--auto", "--primary", "--output", ext_target, "--auto", "--right-of", internal]
            subprocess.run(cmd)
            post_hooks()
            notify("Extended Display", f"Desktop extended to right ({ext_target}).", icon="video-display")

        elif mode == "extend_left":
            cmd = ["xrandr", "--output", internal, "--auto", "--primary", "--output", ext_target, "--auto", "--left-of", internal]
            subprocess.run(cmd)
            post_hooks()
            notify("Extended Display", f"Desktop extended to left ({ext_target}).", icon="video-display")

        elif mode == "external":
            cmd = ["xrandr", "--output", ext_target, "--auto", "--primary", "--output", internal, "--off"]
            subprocess.run(cmd)
            post_hooks()
            notify("Second Screen Only", f"Displaying exclusively on {ext_target}.", icon="video-display")

        elif mode == "web_cast":
            web_bin = os.path.expanduser("~/.local/bin/web-screen-share")
            subprocess.Popen([web_bin, "toggle"])

        elif mode == "miracast":
            if shutil.which("gnome-network-displays"):
                subprocess.Popen(["gnome-network-displays"])
            else:
                notify("Miracast Tool", "Install GNOME Network Displays via AUR:\nyay -S gnome-network-displays", icon="dialog-information")

    def on_key_press(self, widget, event):
        keyval = event.keyval
        if keyval == Gdk.KEY_Escape:
            self.close_and_exit()
            return True

        # Number hotkeys 1-7
        num_map = {
            Gdk.KEY_1: "internal",
            Gdk.KEY_2: "mirror",
            Gdk.KEY_3: "extend_right",
            Gdk.KEY_4: "extend_left",
            Gdk.KEY_5: "external",
            Gdk.KEY_6: "web_cast",
            Gdk.KEY_7: "miracast",
        }
        if keyval in num_map:
            self.apply_mode(num_map[keyval])
            return True

        if keyval == Gdk.KEY_Down:
            cur = self.listbox.get_selected_row()
            if cur:
                idx = cur.get_index()
                next_row = self.listbox.get_row_at_index(idx + 1)
                if next_row:
                    self.listbox.select_row(next_row)
                    return True
        elif keyval == Gdk.KEY_Up:
            cur = self.listbox.get_selected_row()
            if cur:
                idx = cur.get_index()
                if idx > 0:
                    prev_row = self.listbox.get_row_at_index(idx - 1)
                    if prev_row:
                        self.listbox.select_row(prev_row)
                        return True

        return False

def main():
    win = ScreenProjectWindow()
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
