#!/usr/bin/env python3
"""
Catppuccin / Multi-Theme Screen Project & Cast Manager (Win+P Style)
Features cable projection modes (Mirror, Extend, PC only, External only),
wireless web presentation streaming, and dynamic multi-monitor synchronization.
"""
import sys
import os
import signal
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Pango", "1.0")
from gi.repository import Gtk, Gdk, GLib, Pango

# Add local lib to path
lib_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), "../lib"))
if lib_dir not in sys.path:
    sys.path.insert(0, lib_dir)
user_lib = os.path.expanduser("~/.local/lib")
if user_lib not in sys.path:
    sys.path.insert(0, user_lib)

from dotfiles.themes import get_current_theme
from dotfiles.gtk_utils import (
    manage_single_instance,
    cleanup_pid,
    grab_seat,
    ungrab_seat,
    is_click_outside,
    center_window,
    setup_transparent_window,
    notify,
)
from dotfiles.displays import (
    get_displays_info,
    is_web_cast_active,
    apply_display_mode,
    launch_arandr,
)
from dotfiles.styles.screen_project import get_screen_project_css

PID_FILE = "/tmp/screen_project_gtk.pid"

class ScreenProjectWindow(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("ScreenProjectMenu")
        self.set_role("project-menu-popup")
        setup_transparent_window(self)

        self.theme = get_current_theme()
        self.apply_css()

        self.internal, self.connected_ext, self.all_outputs = get_displays_info()
        self.items = []

        self._build_ui()
        center_window(self, 620, 520)

        self.connect("key-press-event", self.on_key_press)
        self.connect("button-press-event", self.on_button_press)
        self.connect("map-event", lambda w, e: GLib.idle_add(lambda: grab_seat(self)))
        self.connect("destroy", lambda w: cleanup_pid(PID_FILE))

    def on_button_press(self, widget, event):
        if is_click_outside(self, event):
            self.close_and_exit()
            return True
        return False

    def close_and_exit(self):
        ungrab_seat()
        cleanup_pid(PID_FILE)
        self.destroy()
        Gtk.main_quit()

    def apply_css(self):
        css = get_screen_project_css(self.theme)
        provider = Gtk.CssProvider()
        provider.load_from_data(css.encode())
        Gtk.StyleContext.add_provider_for_screen(
            self.get_screen(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def _build_ui(self):
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        main_box.set_name("main-card")
        main_box.set_size_request(620, 520)
        self.add(main_box)

        # 1. Header Box
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        header.set_name("header-box")

        hdr_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title_lbl = Gtk.Label(label="󰍹 Project & Cast Screen", xalign=0)
        title_lbl.set_name("hdr-title")
        hdr_vbox.pack_start(title_lbl, False, False, 0)

        if self.connected_ext:
            status_text = f"External Cable: {', '.join(self.connected_ext)}"
            badge_class = "status-badge-connected"
            badge_text = "CABLE CONNECTED"
        else:
            status_text = "No External Cable (Wireless Cast Ready)"
            badge_class = "status-badge-disconnected"
            badge_text = "INTERNAL ONLY"

        status_lbl = Gtk.Label(label=status_text, xalign=0)
        status_lbl.set_name("hdr-status")
        hdr_vbox.pack_start(status_lbl, False, False, 0)

        header.pack_start(hdr_vbox, True, True, 0)

        badge_lbl = Gtk.Label(label=badge_text)
        badge_lbl.get_style_context().add_class(badge_class)
        badge_lbl.set_valign(Gtk.Align.CENTER)
        header.pack_start(badge_lbl, False, False, 0)

        main_box.pack_start(header, False, False, 0)

        # 2. Options List Box
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.listbox = Gtk.ListBox()
        self.listbox.set_name("listbox")
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.listbox.connect("row-activated", self.on_row_activated)
        scrolled.add(self.listbox)
        main_box.pack_start(scrolled, True, True, 0)

        self.populate_options()

        # 3. Footer Actions Toolbar
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        footer.set_name("footer-bar")

        arandr_btn = Gtk.Button(label="󰢻 Display Layout (ARandR)")
        arandr_btn.get_style_context().add_class("footer-action-btn")
        arandr_btn.set_tooltip_text("Open GUI Display Layout Editor")
        arandr_btn.connect("clicked", lambda w: (self.close_and_exit(), launch_arandr()))
        footer.pack_start(arandr_btn, True, True, 0)

        refresh_btn = Gtk.Button(label="󰑐 Rescan Ports")
        refresh_btn.get_style_context().add_class("footer-action-btn")
        refresh_btn.set_tooltip_text("Rescan Connected Displays")
        refresh_btn.connect("clicked", lambda w: self.rescan_displays())
        footer.pack_start(refresh_btn, True, True, 0)

        main_box.pack_start(footer, False, False, 0)

    def populate_options(self):
        for child in self.listbox.get_children():
            self.listbox.remove(child)

        has_cable = bool(self.connected_ext)
        ext_target = self.connected_ext[0] if has_cable else "HDMI-1"
        is_casting = is_web_cast_active()

        options = [
            {
                "id": "internal",
                "icon": "󰌢",
                "title": "PC Screen Only",
                "desc": "Disconnect external displays and show desktop only on laptop screen",
                "key": "1",
                "enabled": True,
            },
            {
                "id": "mirror",
                "icon": "󰍺",
                "title": "Duplicate / Mirror",
                "desc": f"Clone internal screen to projector ({ext_target}) with synchronized resolution",
                "key": "2",
                "enabled": has_cable,
            },
            {
                "id": "extend_right",
                "icon": "󰍹",
                "title": "Extend Screen (Right)",
                "desc": f"Expand desktop workspace to the right side ({ext_target})",
                "key": "3",
                "enabled": has_cable,
            },
            {
                "id": "extend_left",
                "icon": "󰍹",
                "title": "Extend Screen (Left)",
                "desc": f"Expand desktop workspace to the left side ({ext_target})",
                "key": "4",
                "enabled": has_cable,
            },
            {
                "id": "external",
                "icon": "󰍹",
                "title": "Second Screen Only",
                "desc": f"Turn off laptop screen and display only on external projector ({ext_target})",
                "key": "5",
                "enabled": has_cable,
            },
            {
                "id": "web_cast",
                "icon": "󰖟",
                "title": "Stop Wireless Share" if is_casting else "Wireless Web Cast (Local Wi-Fi)",
                "desc": "Stop active presentation stream" if is_casting else "Stream live presentation over Wi-Fi (Smart TV / iPad / Browser URL)",
                "key": "6",
                "enabled": True,
                "highlight": is_casting,
            },
            {
                "id": "miracast",
                "icon": "󰤨",
                "title": "Wi-Fi Display (Miracast / Screencast)",
                "desc": "Connect wirelessly to Smart TV / Miracast receiver (GNOME Displays)",
                "key": "7",
                "enabled": True,
            }
        ]

        for opt in options:
            row = Gtk.ListBoxRow()
            row.opt_data = opt
            row.set_sensitive(opt["enabled"])

            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            box.get_style_context().add_class("project-row")

            icon_lbl = Gtk.Label(label=opt["icon"])
            icon_lbl.get_style_context().add_class("icon-large")
            box.pack_start(icon_lbl, False, False, 0)

            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            t_lbl = Gtk.Label(label=opt["title"], xalign=0)
            t_lbl.get_style_context().add_class("row-title")
            vbox.pack_start(t_lbl, False, False, 0)

            d_lbl = Gtk.Label(label=opt["desc"], xalign=0)
            d_lbl.get_style_context().add_class("row-desc")
            d_lbl.set_ellipsize(Pango.EllipsizeMode.END)
            vbox.pack_start(d_lbl, False, False, 0)

            box.pack_start(vbox, True, True, 0)

            key_lbl = Gtk.Label(label=f"[{opt['key']}]")
            key_lbl.get_style_context().add_class("hotkey-badge")
            box.pack_start(key_lbl, False, False, 0)

            row.add(box)
            self.listbox.add(row)

        self.listbox.show_all()
        first_row = self.listbox.get_row_at_index(0)
        if first_row:
            self.listbox.select_row(first_row)

    def rescan_displays(self):
        self.internal, self.connected_ext, self.all_outputs = get_displays_info()
        self.populate_options()
        notify("Display", "Display Rescanned", f"Detected: {', '.join(self.connected_ext) or 'Internal only'}", tag="display")

    def on_row_activated(self, listbox, row):
        if not hasattr(row, "opt_data"):
            return
        opt = row.opt_data
        if not opt["enabled"]:
            return

        mode = opt["id"]
        self.close_and_exit()
        apply_display_mode(mode, self.internal, self.connected_ext, self.all_outputs)

    def on_key_press(self, widget, event):
        keyval = event.keyval
        if keyval == Gdk.KEY_Escape:
            self.close_and_exit()
            return True

        # Number hotkeys 1-7
        num_map = {
            Gdk.KEY_1: "internal",
            Gdk.KEY_2: "mirror",
            Gdk.KEY_3: "extend_right",
            Gdk.KEY_4: "extend_left",
            Gdk.KEY_5: "external",
            Gdk.KEY_6: "web_cast",
            Gdk.KEY_7: "miracast",
        }
        if keyval in num_map:
            self.close_and_exit()
            apply_display_mode(num_map[keyval], self.internal, self.connected_ext, self.all_outputs)
            return True

        if keyval == Gdk.KEY_Down:
            cur = self.listbox.get_selected_row()
            if cur:
                idx = cur.get_index()
                next_row = self.listbox.get_row_at_index(idx + 1)
                if next_row:
                    self.listbox.select_row(next_row)
                    return True
        elif keyval == Gdk.KEY_Up:
            cur = self.listbox.get_selected_row()
            if cur:
                idx = cur.get_index()
                if idx > 0:
                    prev_row = self.listbox.get_row_at_index(idx - 1)
                    if prev_row:
                        self.listbox.select_row(prev_row)
                        return True

        return False

def main():
    manage_single_instance(PID_FILE)
    signal.signal(signal.SIGINT, lambda s, f: sys.exit(0))
    signal.signal(signal.SIGTERM, lambda s, f: sys.exit(0))

    win = ScreenProjectWindow()
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
