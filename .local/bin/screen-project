                "desc": f"Expand desktop workspace to the right side ({ext_target})",
                "key": "3",
                "enabled": has_cable,
            },
            {
                "id": "extend_left",
                "icon": "󰍹",
                "title": "Extend Screen (Left)",
                "desc": f"Expand desktop workspace to the left side ({ext_target})",
                "key": "4",
                "enabled": has_cable,
            },
            {
                "id": "external",
                "icon": "󰍹",
                "title": "Second Screen Only",
                "desc": f"Turn off laptop screen and display only on external projector ({ext_target})",
                "key": "5",
                "enabled": has_cable,
            },
            {
                "id": "web_cast",
                "icon": "󰖟",
                "title": "Stop Wireless Share" if is_casting else "Wireless Web Cast (Local Wi-Fi)",
                "desc": "Stop active presentation stream" if is_casting else "Stream live presentation over Wi-Fi (Smart TV / iPad / Browser URL)",
                "key": "6",
                "enabled": True,
                "highlight": is_casting,
            },
            {
                "id": "miracast",
                "icon": "󰤨",
                "title": "Wi-Fi Display (Miracast / Screencast)",
                "desc": "Connect wirelessly to Smart TV / Miracast receiver (GNOME Displays)",
                "key": "7",
                "enabled": True,
            }
        ]

        for opt in options:
            row = Gtk.ListBoxRow()
            row.opt_data = opt
            row.set_sensitive(opt["enabled"])

            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            box.get_style_context().add_class("project-row")

            icon_lbl = Gtk.Label(label=opt["icon"])
            icon_lbl.get_style_context().add_class("icon-large")
            box.pack_start(icon_lbl, False, False, 0)

            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            t_lbl = Gtk.Label(label=opt["title"], xalign=0)
