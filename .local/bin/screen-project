#!/usr/bin/env python3
"""
Catppuccin / Multi-Theme Screen Project & Cast Manager (Win+P Style)
Features cable projection modes (Mirror, Extend, PC only, External only),
wireless web presentation streaming, and dynamic multi-monitor synchronization.
"""
import sys
import os
import signal
import subprocess
import shutil
import re
import html
import threading
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Pango", "1.0")
from gi.repository import Gtk, Gdk, GLib, Pango

PID_FILE = "/tmp/screen_project_gtk.pid"
if os.path.exists(PID_FILE):
    try:
        with open(PID_FILE, "r") as f:
            old_pid = int(f.read().strip())
        os.remove(PID_FILE)
        os.kill(old_pid, signal.SIGTERM)
        sys.exit(0)
    except Exception:
        pass

with open(PID_FILE, "w") as f:
    f.write(str(os.getpid()))

# Load Global Theme Preference
