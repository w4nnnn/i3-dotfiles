#!/usr/bin/env bash
# ==========================================================
# Catppuccin Mocha - Wallpaper Selector & Sync
# Sets wallpaper for both Desktop and Lockscreen
# ==========================================================

WALLPAPER_DIR="$HOME/Pictures/Wallpapers"
CACHE_WALL="$HOME/.cache/current_wallpaper"
RASI="$HOME/.config/rofi/wallpaper.rasi"

# 0. Handle --restore silently without launching Rofi
if [ "$1" = "--restore" ] || [ "$1" = "restore" ]; then
    RESTORE_PATH=""
    if [ -e "$CACHE_WALL" ]; then
        RESTORE_PATH="$(readlink -f "$CACHE_WALL" 2>/dev/null || cat "$CACHE_WALL" 2>/dev/null)"
    fi
    if [ -z "$RESTORE_PATH" ] || [ ! -f "$RESTORE_PATH" ]; then
        if [ -f "$WALLPAPER_DIR/catppuccin-aesthetic.jpg" ]; then
            RESTORE_PATH="$WALLPAPER_DIR/catppuccin-aesthetic.jpg"
        elif [ -f "$WALLPAPER_DIR/catppuccin-astronaut.png" ]; then
            RESTORE_PATH="$WALLPAPER_DIR/catppuccin-astronaut.png"
        fi
    fi
    if [ -n "$RESTORE_PATH" ] && [ -f "$RESTORE_PATH" ]; then
        feh --bg-fill "$RESTORE_PATH" 2>/dev/null || true
    fi
    exit 0
fi

# Toggle: close if already open
if pgrep -x rofi >/dev/null 2>&1; then
    killall -q rofi
    exit 0
fi

# Build list of wallpapers with image thumbnails
MENU_ITEMS=""
declare -A FILE_MAP

while IFS= read -r file; do
    [ -z "$file" ] && continue
    basename=$(basename "$file")
    # Clean display name
    name=$(echo "$basename" | sed -E 's/\.[^.]+$//' | tr '_-' ' ' | sed -E 's/(^| )([a-z])/\1\U\2/g')
    FILE_MAP["$name"]="$file"
    MENU_ITEMS+="${name}\0icon\x1f${file}\n"
done < <(find "$WALLPAPER_DIR" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) | sort)

# Show Rofi Selector
CHOSEN=$(printf "$MENU_ITEMS" | rofi -no-config -dmenu -theme "$RASI" -p "󰸉 Wallpaper" -i)

if [ -n "$CHOSEN" ] && [ -n "${FILE_MAP[$CHOSEN]}" ]; then
    SELECTED_PATH="${FILE_MAP[$CHOSEN]}"
    
    # 1. Apply to desktop immediately
    feh --bg-fill "$SELECTED_PATH"
    
    # 2. Update symlink for lockscreen & persistent state
    mkdir -p "$HOME/.cache"
    ln -sf "$SELECTED_PATH" "$CACHE_WALL"
    
    # 3. Notification feedback
    notify-send -i "$SELECTED_PATH" "Wallpaper Updated" "Applied to Desktop & Lockscreen: $CHOSEN"
    
    # 4. Pre-render 50% blurred background for lockscreen asynchronously
    SCREEN_W=$(xrandr --current 2>/dev/null | grep -oP '\d+(?=x\d+\s+.*\*)' | head -n 1)
    SCREEN_H=$(xrandr --current 2>/dev/null | grep -oP '\d+x\K\d+(?=\s+.*\*)' | head -n 1)
    SCREEN_W=${SCREEN_W:-1920}
    SCREEN_H=${SCREEN_H:-1080}
    magick "$SELECTED_PATH" -resize "${SCREEN_W}x${SCREEN_H}^" -gravity center -extent "${SCREEN_W}x${SCREEN_H}" -blur 0x12 "$HOME/.cache/lockscreen_blur.png" &

    # 5. Pre-generate card lockscreen canvas
    if [ -x "$HOME/.local/bin/generate-lock-bg" ]; then
        "$HOME/.local/bin/generate-lock-bg" >/dev/null 2>&1 &
    fi

    # 6. Sync with SDDM background if installed & writable
    SDDM_WALL="/usr/share/sddm/themes/silent/backgrounds/wallpaper.jpg"
    if [ -w "$SDDM_WALL" ]; then
        magick "$SELECTED_PATH" -resize 1920x1080^ -gravity center -extent 1920x1080 "$SDDM_WALL" &
    fi
fi
