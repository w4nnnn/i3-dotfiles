#!/usr/bin/env python3
"""
Lightweight Web Screen Share Server for Presentations (Wireless Screen Cast)
Streams live desktop view over local Wi-Fi / LAN via MJPEG HTTP stream.
Any browser on Smart TV, Tablet, Phone, or Projector can view it in real-time full screen!
"""
import sys
import os
import signal
import subprocess
import socket
import re
from http.server import HTTPServer, BaseHTTPRequestHandler
from socketserver import ThreadingMixIn

PID_FILE = "/tmp/web_screen_share.pid"
PORT = 8080

def get_local_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"

HTML_PAGE = """<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wireless Screen Presentation</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background-color: #11111b;
            color: #cdd6f4;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            overflow: hidden;
        }
        #stream-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #000;
        }
        #screen-img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }
        #controls {
            position: absolute;
            bottom: 24px;
            right: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(30, 30, 46, 0.85);
            backdrop-filter: blur(12px);
            padding: 8px 18px;
            border-radius: 30px;
            border: 1px solid rgba(203, 166, 247, 0.3);
            opacity: 0.25;
            transition: opacity 0.3s ease;
        }
        #controls:hover {
            opacity: 1;
        }
        button {
            background: #cba6f7;
            color: #11111b;
            border: none;
            padding: 6px 14px;
            border-radius: 20px;
            font-weight: bold;
            cursor: pointer;
            font-size: 13px;
        }
        button:hover {
            background: #b4befe;
        }
        #live-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: #a6e3a1;
            font-weight: bold;
            letter-spacing: 0.5px;
        }
        .dot {
            width: 8px;
            height: 8px;
            background: #a6e3a1;
            border-radius: 50%;
            animation: pulse 1.5s infinite;
        }
        @keyframes pulse {
            0% { opacity: 0.3; transform: scale(0.9); }
            50% { opacity: 1; transform: scale(1.1); }
            100% { opacity: 0.3; transform: scale(0.9); }
        }
    </style>
</head>
<body>
    <div id="stream-container">
        <img id="screen-img" src="/stream.mjpg" alt="Screen Stream">
        <div id="controls">
            <div id="live-badge"><div class="dot"></div> LIVE PRESENTATION</div>
            <button onclick="toggleFullScreen()">⛶ Fullscreen</button>
        </div>
    </div>
    <script>
        function toggleFullScreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen();
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            }
        }
    </script>
</body>
</html>
"""

class ThreadedHTTPServer(ThreadingMixIn, HTTPServer):
    daemon_threads = True

class ScreenStreamHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/" or self.path == "/index.html":
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(HTML_PAGE.encode("utf-8"))
        elif self.path == "/stream.mjpg":
            self.send_response(200)
            self.send_header("Content-Type", "multipart/x-mixed-replace; boundary=--frame")
            self.send_header("Cache-Control", "no-cache, private")
            self.send_header("Pragma", "no-cache")
            self.end_headers()

            screen_size = "1366x768"
            try:
                x_out = subprocess.check_output(["xrandr", "--current"], text=True)
                m = re.search(r"current\s+(\d+)\s*x\s*(\d+)", x_out)
                if m:
                    screen_size = f"{m.group(1)}x{m.group(2)}"
            except Exception:
                pass

            ffmpeg_cmd = [
                "ffmpeg",
                "-f", "x11grab",
                "-framerate", "25",
                "-video_size", screen_size,
                "-i", ":0.0",
                "-f", "mjpeg",
                "-q:v", "4",
                "-loglevel", "quiet",
                "pipe:1"
            ]

            proc = subprocess.Popen(ffmpeg_cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)

            try:
                buffer = bytearray()
                while True:
                    data = proc.stdout.read(4096)
                    if not data:
                        break
                    buffer.extend(data)
                    a = buffer.find(b'\xff\xd8')
                    b = buffer.find(b'\xff\xd9')
                    if a != -1 and b != -1 and b > a:
                        jpg = buffer[a:b+2]
                        buffer = buffer[b+2:]
                        self.wfile.write(b"--frame\r\n")
                        self.send_header("Content-Type", "image/jpeg")
                        self.send_header("Content-Length", str(len(jpg)))
                        self.end_headers()
                        self.wfile.write(jpg)
                        self.wfile.write(b"\r\n")
            except Exception:
                pass
            finally:
                proc.kill()
        else:
            self.send_error(404)

    def log_message(self, format, *args):
        pass

def is_running():
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            os.kill(pid, 0)
            return pid
        except Exception:
            if os.path.exists(PID_FILE):
                os.remove(PID_FILE)
    return False

def stop_server():
    pid = is_running()
    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
        except Exception:
            pass
        if os.path.exists(PID_FILE):
            os.remove(PID_FILE)
        subprocess.Popen([
            "dunstify", "-a", "Cast",
            "-h", "string:x-dunst-stack-tag:cast",
            "-i", "network-wireless-disconnected",
            "-u", "normal",
            "Screen Share Stopped",
            "Wireless presentation stream ended."
        ])
        return True
    return False

def start_server():
    if is_running():
        return

    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

    ip = get_local_ip()
    url = f"http://{ip}:{PORT}"

    subprocess.Popen([
        "dunstify", "-a", "Cast",
        "-h", "string:x-dunst-stack-tag:cast",
        "-i", "video-display",
        "-u", "normal",
        "📡 Wireless Screen Share Active",
        f"Open on TV / Browser:\n<b>{url}</b>"
    ])

    try:
        server = ThreadedHTTPServer(("0.0.0.0", PORT), ScreenStreamHandler)
        server.serve_forever()
    except Exception:
        pass
    finally:
        if os.path.exists(PID_FILE):
            os.remove(PID_FILE)

def main():
    action = sys.argv[1] if len(sys.argv) > 1 else "toggle"

    if action == "status":
        if is_running():
            print("running")
            sys.exit(0)
        else:
            print("stopped")
            sys.exit(1)
    elif action == "stop":
        stop_server()
    elif action == "start":
        if not is_running():
            subprocess.Popen([sys.argv[0], "run_daemon"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif action == "run_daemon":
        start_server()
    elif action == "toggle":
        if is_running():
            stop_server()
        else:
            subprocess.Popen([sys.argv[0], "run_daemon"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if __name__ == "__main__":
    main()
