#!/usr/bin/env python3
"""
Windows 11 Start Menu (Catppuccin Mocha / Multi-Theme)
Direct All-Apps Grid View with Search and Footer
"""
import sys
import os
import signal
import subprocess
import math
import cairo
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Gio", "2.0")
gi.require_version("Pango", "1.0")
gi.require_version("PangoCairo", "1.0")
from gi.repository import Gtk, Gdk, Gio, GLib, Pango, PangoCairo

# Add local lib to path
lib_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), "../lib"))
if lib_dir not in sys.path:
    sys.path.insert(0, lib_dir)
user_lib = os.path.expanduser("~/.local/lib")
if user_lib not in sys.path:
    sys.path.insert(0, user_lib)

from dotfiles.themes import get_current_theme
from dotfiles.gtk_utils import (
    manage_single_instance,
    cleanup_pid,
    grab_seat,
    ungrab_seat,
    is_click_outside,
    center_window,
    setup_transparent_window,
)
from dotfiles.apps import get_username, get_desktop_apps, launch_desktop_app
from dotfiles.styles.win11_start import get_win11_start_css

PID_FILE = "/tmp/win11_start_menu.pid"

def hex_to_rgb(hex_str):
    hex_str = hex_str.lstrip("#")
    if len(hex_str) == 6:
        return tuple(int(hex_str[i:i+2], 16) / 255.0 for i in (0, 2, 4))
    return (0.8, 0.8, 0.8)

class Win11StartMenu(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("Windows11StartMenu")
        self.set_role("win11-start-menu")
        setup_transparent_window(self)

        self.theme = get_current_theme()
        self.accent_rgb = hex_to_rgb(self.theme["accent"])
        self.surface0_rgb = hex_to_rgb(self.theme["surface0"])
        self.apply_css()

        self.all_apps = get_desktop_apps()
        self.filtered_apps = list(self.all_apps)

        # Root Card Container
        root_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root_card.set_name("start-window")
        root_card.set_size_request(660, 580)
        self.add(root_card)

        # 1. Search Box Bar
        search_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        search_box.set_name("search-bar")

        search_icon = Gtk.Label(label="")
        search_icon.set_name("search-icon")
        search_icon.set_halign(Gtk.Align.CENTER)
        search_icon.set_valign(Gtk.Align.CENTER)
        search_box.pack_start(search_icon, False, False, 0)

        self.search_entry = Gtk.Entry()
        self.search_entry.set_name("search-entry")
        self.search_entry.set_placeholder_text("Type here to search...")
        self.search_entry.connect("changed", self.on_search_changed)
        self.search_entry.connect("activate", self.on_search_activate)
        search_box.pack_start(self.search_entry, True, True, 0)

        close_btn = Gtk.Button(label="")
        close_btn.get_style_context().add_class("close-search-btn")
        if close_btn.get_child():
            close_btn.get_child().set_halign(Gtk.Align.CENTER)
            close_btn.get_child().set_valign(Gtk.Align.CENTER)
        close_btn.set_tooltip_text("Close (Esc)")
        close_btn.connect("clicked", lambda w: self.close_and_exit())
        search_box.pack_start(close_btn, False, False, 0)

        search_wrapper = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        search_wrapper.set_name("search-wrapper")
        search_wrapper.pack_start(search_box, False, False, 0)
        root_card.pack_start(search_wrapper, False, False, 0)

        # 2. Main Apps Body (Grid View)
        self.body_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.body_box.set_name("body-container")
        root_card.pack_start(self.body_box, True, True, 0)

        self.build_apps_view(self.all_apps)

        # 3. Bottom Footer (User & Power)
        root_card.pack_start(self.create_footer(), False, False, 0)

        # Events
        self.connect("key-press-event", self.on_key_press)
        self.connect("map-event", lambda w, e: GLib.idle_add(lambda: grab_seat(self)))
        self.connect("button-press-event", self.on_button_press)
        self.connect("size-allocate", self.on_size_allocate)
        self.connect("destroy", lambda w: cleanup_pid(PID_FILE))

        self.show_all()
        center_window(self, 660, 580)
        self.apply_cursor()

        GLib.idle_add(self.search_entry.grab_focus)

    def on_size_allocate(self, widget, alloc):
        w, h = alloc.width, alloc.height
        r = 16
        surf = cairo.ImageSurface(cairo.FORMAT_A1, w, h)
        cr = cairo.Context(surf)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()

        cr.new_sub_path()
        cr.arc(w - r, r, r, -math.pi / 2, 0)
        cr.arc(w - r, h - r, r, 0, math.pi / 2)
        cr.arc(r, h - r, r, math.pi / 2, math.pi)
        cr.arc(r, r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()
        cr.set_source_rgba(1, 1, 1, 1)
        cr.fill()

        region = Gdk.cairo_region_create_from_surface(surf)
        widget.shape_combine_region(region)

    def apply_cursor(self):
        display = Gdk.Display.get_default()
        cursor = Gdk.Cursor.new_from_name(display, "default") or Gdk.Cursor.new_from_name(display, "left_ptr")
        if cursor and self.get_window():
            self.get_window().set_cursor(cursor)

    def apply_css(self):
        css = get_win11_start_css(self.theme)
        provider = Gtk.CssProvider()
        provider.load_from_data(css.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def build_apps_view(self, apps_list):
        for child in self.body_box.get_children():
            child.destroy()

        self.filtered_apps = apps_list

        if not apps_list:
            no_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            no_box.set_valign(Gtk.Align.CENTER)
            no_lbl = Gtk.Label(label="No applications found")
            no_lbl.get_style_context().add_class("no-results-lbl")
            no_box.pack_start(no_lbl, True, True, 0)
            self.body_box.pack_start(no_box, True, True, 0)
            self.body_box.show_all()
            return

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_min_content_height(400)

        grid = Gtk.Grid()
        grid.set_column_spacing(8)
        grid.set_row_spacing(8)
        grid.set_column_homogeneous(True)

        for idx, app in enumerate(apps_list):
            col = idx % 6
            row = idx // 6
            btn = self.create_app_tile(app)
            grid.attach(btn, col, row, 1, 1)

        scroll.add(grid)
        self.body_box.pack_start(scroll, True, True, 0)
        self.body_box.show_all()

    def create_app_tile(self, app):
        btn = Gtk.Button()
        btn.get_style_context().add_class("app-tile")

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.set_halign(Gtk.Align.CENTER)
        box.set_valign(Gtk.Align.CENTER)

        icon = app.get_icon()
        if icon:
            img = Gtk.Image.new_from_gicon(icon, Gtk.IconSize.DIALOG)
            img.set_pixel_size(38)
        else:
            img = Gtk.Image.new_from_icon_name("application-x-executable", Gtk.IconSize.DIALOG)
            img.set_pixel_size(38)
        box.pack_start(img, False, False, 0)

        lbl = Gtk.Label(label=app.get_name())
        lbl.get_style_context().add_class("app-tile-label")
        lbl.set_ellipsize(Pango.EllipsizeMode.END)
        lbl.set_max_width_chars(10)
        box.pack_start(lbl, False, False, 0)

        btn.add(box)
        btn.connect("clicked", lambda w, a=app: (self.close_and_exit(), launch_desktop_app(a)))
        return btn

    def create_footer(self):
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        footer.set_name("footer-bar")

        self.avatar_area = Gtk.DrawingArea()
        self.avatar_area.set_size_request(32, 32)
        self.avatar_area.set_valign(Gtk.Align.CENTER)
        self.avatar_area.set_halign(Gtk.Align.CENTER)
        self.avatar_area.connect("draw", self.on_avatar_draw)
        footer.pack_start(self.avatar_area, False, False, 0)

        user_lbl = Gtk.Label(label=get_username(), xalign=0)
        user_lbl.get_style_context().add_class("user-name")
        footer.pack_start(user_lbl, False, False, 0)

        dummy = Gtk.Box()
        footer.pack_start(dummy, True, True, 0)

        pwr_btn = Gtk.Button(label="")
        pwr_btn.get_style_context().add_class("footer-power-btn")
        if pwr_btn.get_child():
            pwr_btn.get_child().set_halign(Gtk.Align.CENTER)
            pwr_btn.get_child().set_valign(Gtk.Align.CENTER)
        bin_dir = os.path.expanduser("~/.local/bin")
        pwr_btn.connect("clicked", lambda w: (self.close_and_exit(), subprocess.Popen([os.path.join(bin_dir, "powermenu")])))
        footer.pack_start(pwr_btn, False, False, 0)

        return footer

    def on_avatar_draw(self, widget, cr):
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()
        radius = min(w, h) / 2.0

        cr.arc(w / 2.0, h / 2.0, radius, 0, 2 * math.pi)
        cr.set_source_rgb(*self.surface0_rgb)
        cr.fill()

        layout = self.create_pango_layout("")
        desc = Pango.FontDescription("lucide 13")
        layout.set_font_description(desc)
        ink, log = layout.get_pixel_extents()

        x = round((w - ink.width) / 2.0 - ink.x)
        y = round((h - ink.height) / 2.0 - ink.y)

        cr.move_to(x, y)
        cr.set_source_rgb(*self.accent_rgb)
        PangoCairo.show_layout(cr, layout)

    def on_search_changed(self, entry):
        query = entry.get_text().strip().lower()
        if not query:
            self.build_apps_view(self.all_apps)
            return

        matches = [a for a in self.all_apps if query in a.get_name().lower() or query in a.get_display_name().lower() or (a.get_description() and query in a.get_description().lower())]
        self.build_apps_view(matches)

    def on_search_activate(self, entry):
        if self.filtered_apps:
            self.close_and_exit()
            launch_desktop_app(self.filtered_apps[0])

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.close_and_exit()
            return True
        return False

    def on_button_press(self, widget, event):
        if is_click_outside(self, event):
            self.close_and_exit()
            return True
        return False

    def close_and_exit(self):
        ungrab_seat()
        cleanup_pid(PID_FILE)
        self.destroy()
        Gtk.main_quit()

def main():
    manage_single_instance(PID_FILE)
    win = Win11StartMenu()
    Gtk.main()

if __name__ == "__main__":
    main()
