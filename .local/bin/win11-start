#!/usr/bin/env python3
"""
Windows 11 Start Menu (Catppuccin Mocha)
Direct All-Apps Grid View with Search and Footer
"""
import sys
import os
import signal
import subprocess
import math
import cairo
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Gio", "2.0")
from gi.repository import Gtk, Gdk, Gio, GLib, Pango

PID_FILE = "/tmp/win11_start_menu.pid"
if os.path.exists(PID_FILE):
    try:
        with open(PID_FILE, "r") as f:
            old_pid = int(f.read().strip())
        os.remove(PID_FILE)
        os.kill(old_pid, signal.SIGTERM)
        sys.exit(0)
    except Exception:
        pass

with open(PID_FILE, "w") as f:
    f.write(str(os.getpid()))

def get_username():
    return os.getenv("USER", "User")

def get_desktop_apps():
    all_apps = Gio.AppInfo.get_all()
    res = []
    seen = set()
    for app in all_apps:
        if app.should_show():
            name = app.get_name()
            if name not in seen:
                seen.add(name)
                res.append(app)
    # Sort alphabetically
    res.sort(key=lambda a: a.get_name().lower())
    return res

class Win11StartMenu(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("Windows11StartMenu")
        self.set_role("win11-start-menu")
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_resizable(False)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)

        self.apply_css()

        self.all_apps = get_desktop_apps()
        self.filtered_apps = list(self.all_apps)

        # Root Card Container
        root_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root_card.set_name("start-window")
        root_card.set_size_request(660, 580)
        self.add(root_card)

        # 1. Search Box Bar
        search_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        search_box.set_name("search-bar")

        search_icon = Gtk.Label(label="")
        search_icon.set_name("search-icon")
        search_box.pack_start(search_icon, False, False, 0)

        self.search_entry = Gtk.Entry()
        self.search_entry.set_name("search-entry")
        self.search_entry.set_placeholder_text("Type here to search...")
        self.search_entry.connect("changed", self.on_search_changed)
        self.search_entry.connect("activate", self.on_search_activate)
        search_box.pack_start(self.search_entry, True, True, 0)

        close_btn = Gtk.Button(label="󰅖")
        close_btn.get_style_context().add_class("close-search-btn")
        close_btn.set_tooltip_text("Close (Esc)")
        close_btn.connect("clicked", lambda w: self.close_and_exit())
        search_box.pack_start(close_btn, False, False, 0)

        search_wrapper = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        search_wrapper.set_name("search-wrapper")
        search_wrapper.pack_start(search_box, False, False, 0)
        root_card.pack_start(search_wrapper, False, False, 0)

        # 2. Main Apps Body (Grid View)
        self.body_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.body_box.set_name("body-container")
        root_card.pack_start(self.body_box, True, True, 0)

        # Build initial all-apps view
        self.build_apps_view(self.all_apps)

        # 3. Bottom Footer (User & Power)
        root_card.pack_start(self.create_footer(), False, False, 0)

        # Events
        self.connect("key-press-event", self.on_key_press)
        self.connect("map-event", self.on_map_event)
        self.connect("button-press-event", self.on_button_press)
        self.connect("size-allocate", self.on_size_allocate)
        self.connect("destroy", self.cleanup)

        self.show_all()
        self.position_center()
        self.apply_cursor()

        GLib.idle_add(self.search_entry.grab_focus)

    def on_size_allocate(self, widget, alloc):
        w, h = alloc.width, alloc.height
        r = 18
        surf = cairo.ImageSurface(cairo.FORMAT_A1, w, h)
        cr = cairo.Context(surf)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()

        cr.new_sub_path()
        cr.arc(w - r, r, r, -math.pi / 2, 0)
        cr.arc(w - r, h - r, r, 0, math.pi / 2)
        cr.arc(r, h - r, r, math.pi / 2, math.pi)
        cr.arc(r, r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()
        cr.set_source_rgba(1, 1, 1, 1)
        cr.fill()

        region = Gdk.cairo_region_create_from_surface(surf)
        widget.shape_combine_region(region)

    def position_center(self):
        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor() or display.get_monitor_at_point(0, 0)
        geom = monitor.get_geometry()
        w, h = 660, 580
        pos_x = geom.x + (geom.width - w) // 2
        pos_y = geom.y + (geom.height - h) // 2
        self.move(pos_x, pos_y)

    def apply_cursor(self):
        display = Gdk.Display.get_default()
        cursor = Gdk.Cursor.new_from_name(display, "default") or Gdk.Cursor.new_from_name(display, "left_ptr")
        if cursor and self.get_window():
            self.get_window().set_cursor(cursor)

    def apply_css(self):
        css = b"""
        window {
            background-color: transparent;
        }
        #start-window {
            background-color: rgba(30, 30, 46, 0.82);
            border: 1.5px solid #cba6f7;
            border-radius: 18px;
            padding: 0px;
        }
        #search-wrapper {
            padding: 22px 26px 14px 26px;
        }
        #search-bar {
            background-color: rgba(24, 24, 37, 0.85);
            border: 1px solid #313244;
            border-bottom: 2px solid #cba6f7;
            border-radius: 8px;
            padding: 4px 14px;
        }
        #search-icon {
            color: #cba6f7;
            font-family: 'JetBrainsMono Nerd Font';
            font-size: 11.5pt;
        }
        #search-entry {
            background-color: transparent;
            border: none;
            color: #cdd6f4;
            font-family: 'JetBrainsMono Nerd Font';
            font-size: 10.5pt;
        }
        .close-search-btn {
            background-color: transparent;
            border: none;
            color: #6c7086;
            font-family: 'JetBrainsMono Nerd Font';
            font-size: 11pt;
            padding: 2px 6px;
            border-radius: 6px;
        }
        .close-search-btn:hover {
            color: #f38ba8;
            background-color: #313244;
        }
        #body-container {
            padding: 0px 24px 8px 24px;
        }
        .app-tile {
            background-color: transparent;
            border: 1px solid transparent;
            border-radius: 10px;
            padding: 10px 4px;
        }
        .app-tile:hover {
            background-color: #313244;
            border-color: #45475a;
        }
        .app-tile-label {
            color: #cdd6f4;
            font-family: 'JetBrainsMono Nerd Font';
            font-size: 8.5pt;
            margin-top: 5px;
        }
        .no-results-lbl {
            color: #a6adc8;
            font-family: 'JetBrainsMono Nerd Font';
            font-size: 10pt;
        }
        #footer-bar {
            background-color: rgba(24, 24, 37, 0.88);
            border-top: 1px solid #313244;
            border-radius: 0px 0px 18px 18px;
            padding: 12px 28px;
        }
        .avatar-circle {
            background-color: #313244;
            border-radius: 50%;
            min-width: 32px;
            min-height: 32px;
            font-family: 'lucide', 'JetBrainsMono Nerd Font';
            font-size: 13pt;
            color: #cba6f7;
        }
        .user-name {
            color: #cdd6f4;
            font-family: 'JetBrainsMono Nerd Font';
            font-size: 9.5pt;
            font-weight: bold;
            margin-left: 8px;
        }
        .footer-power-btn {
            background-color: transparent;
            border: none;
            border-radius: 8px;
            min-width: 34px;
            min-height: 34px;
            font-family: 'lucide', 'JetBrainsMono Nerd Font';
            font-size: 14pt;
            color: #f38ba8;
            padding: 0;
        }
        .footer-power-btn:hover {
            background-color: #313244;
        }
        scrollbar trough {
            background-color: transparent;
        }
        scrollbar slider {
            background-color: #313244;
            border-radius: 6px;
            min-width: 4px;
        }
        scrollbar slider:hover {
            background-color: #cba6f7;
        }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def build_apps_view(self, apps_list):
        for child in self.body_box.get_children():
            child.destroy()

        self.filtered_apps = apps_list

        if not apps_list:
            no_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            no_box.set_valign(Gtk.Align.CENTER)
            no_lbl = Gtk.Label(label="No applications found")
            no_lbl.get_style_context().add_class("no-results-lbl")
            no_box.pack_start(no_lbl, True, True, 0)
            self.body_box.pack_start(no_box, True, True, 0)
            self.body_box.show_all()
            return

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_min_content_height(400)

        grid = Gtk.Grid()
        grid.set_column_spacing(8)
        grid.set_row_spacing(8)
        grid.set_column_homogeneous(True)

        for idx, app in enumerate(apps_list):
            col = idx % 6
            row = idx // 6
            btn = self.create_app_tile(app)
            grid.attach(btn, col, row, 1, 1)

        scroll.add(grid)
        self.body_box.pack_start(scroll, True, True, 0)
        self.body_box.show_all()

    def create_app_tile(self, app):
        btn = Gtk.Button()
        btn.get_style_context().add_class("app-tile")

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.set_halign(Gtk.Align.CENTER)
        box.set_valign(Gtk.Align.CENTER)

        # Icon
        icon = app.get_icon()
        if icon:
            img = Gtk.Image.new_from_gicon(icon, Gtk.IconSize.DIALOG)
            img.set_pixel_size(38)
        else:
            img = Gtk.Image.new_from_icon_name("application-x-executable", Gtk.IconSize.DIALOG)
            img.set_pixel_size(38)
        box.pack_start(img, False, False, 0)

        # Name label
        lbl = Gtk.Label(label=app.get_name())
        lbl.get_style_context().add_class("app-tile-label")
        lbl.set_ellipsize(Pango.EllipsizeMode.END)
        lbl.set_max_width_chars(10)
        box.pack_start(lbl, False, False, 0)

        btn.add(box)
        btn.connect("clicked", lambda w, a=app: self.launch_app(a))
        return btn

    def create_footer(self):
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        footer.set_name("footer-bar")

        # User Avatar
        avatar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        avatar.get_style_context().add_class("avatar-circle")
        av_lbl = Gtk.Label(label="")
        avatar.pack_start(av_lbl, True, True, 0)
        footer.pack_start(avatar, False, False, 0)

        # Username
        user_lbl = Gtk.Label(label=get_username(), xalign=0)
        user_lbl.get_style_context().add_class("user-name")
        footer.pack_start(user_lbl, False, False, 0)

        dummy = Gtk.Box()
        footer.pack_start(dummy, True, True, 0)

        # Power button (Lucide power)
        pwr_btn = Gtk.Button(label="")
        pwr_btn.get_style_context().add_class("footer-power-btn")
        bin_dir = os.path.expanduser("~/.local/bin")
        pwr_btn.connect("clicked", lambda w: (self.close_and_exit(), subprocess.Popen([os.path.join(bin_dir, "powermenu")])))
        footer.pack_start(pwr_btn, False, False, 0)

        return footer

    def on_search_changed(self, entry):
        query = entry.get_text().strip().lower()
        if not query:
            self.build_apps_view(self.all_apps)
            return

        matches = [a for a in self.all_apps if query in a.get_name().lower() or query in a.get_display_name().lower() or (a.get_description() and query in a.get_description().lower())]
        self.build_apps_view(matches)

    def on_search_activate(self, entry):
        if self.filtered_apps:
            self.launch_app(self.filtered_apps[0])

    def launch_app(self, app):
        self.close_and_exit()
        try:
            app.launch([], None)
        except Exception:
            cmd = app.get_commandline()
            if cmd:
                clean_cmd = [part for part in cmd.split() if not part.startswith("%")]
                subprocess.Popen(clean_cmd)

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.close_and_exit()
            return True
        return False

    def on_map_event(self, widget, event):
        GLib.idle_add(self.grab_seat)

    def grab_seat(self):
        try:
            seat = Gdk.Display.get_default().get_default_seat()
            if seat and self.get_window():
                cursor = self.get_window().get_cursor()
                seat.grab(self.get_window(), Gdk.SeatCapabilities.ALL, True, cursor, None, None)
        except Exception:
            pass
        return False

    def on_button_press(self, widget, event):
        if not self.get_window():
            return False
        success, ox, oy = self.get_window().get_origin()
        w = self.get_window().get_width()
        h = self.get_window().get_height()
        inside = (ox <= event.x_root <= ox + w) and (oy <= event.y_root <= oy + h)
        if not inside:
            self.close_and_exit()
            return True
        return False

    def close_and_exit(self):
        try:
            seat = Gdk.Display.get_default().get_default_seat()
            if seat:
                seat.ungrab()
        except Exception:
            pass
        self.destroy()
        Gtk.main_quit()

    def cleanup(self, *args):
        if os.path.exists(PID_FILE):
            try:
                os.remove(PID_FILE)
            except Exception:
                pass

if __name__ == "__main__":
    win = Win11StartMenu()
    Gtk.main()
