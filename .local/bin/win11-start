#!/usr/bin/env python3
"""
Windows 11 Start Menu Clone (Catppuccin Mocha)
Inspired by: https://github.com/Laaouatni/w11CSS
Native GTK3 + Python application with search, pinned apps, recommended files, and footer.
"""
import sys
import os
import signal
import subprocess
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Gio", "2.0")
from gi.repository import Gtk, Gdk, Gio, GLib, Pango

PID_FILE = "/tmp/win11_start_menu.pid"
if os.path.exists(PID_FILE):
    try:
        with open(PID_FILE, "r") as f:
            old_pid = int(f.read().strip())
        os.remove(PID_FILE)
        os.kill(old_pid, signal.SIGTERM)
        sys.exit(0)
    except Exception:
        pass

with open(PID_FILE, "w") as f:
    f.write(str(os.getpid()))

def get_username():
    return os.getenv("USER", "User")

def get_desktop_apps():
    all_apps = Gio.AppInfo.get_all()
    res = []
    seen = set()
    for app in all_apps:
        if app.should_show():
            name = app.get_name()
            if name not in seen:
                seen.add(name)
                res.append(app)
    # Sort alphabetically
    res.sort(key=lambda a: a.get_name().lower())
    return res

class Win11StartMenu(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("Windows11StartMenu")
        self.set_role("win11-start-menu")
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_resizable(False)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)

        self.apply_css()

        self.all_apps = get_desktop_apps()
        self.filtered_apps = list(self.all_apps)

        # Root Card Container
        root_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root_card.set_name("start-window")
        root_card.set_size_request(640, 680)
        self.add(root_card)

        # 1. Search Box Bar
        search_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        search_box.set_name("search-bar")

        search_icon = Gtk.Label(label="")
        search_icon.set_name("search-icon")
        search_box.pack_start(search_icon, False, False, 0)

        self.search_entry = Gtk.Entry()
        self.search_entry.set_name("search-entry")
        self.search_entry.set_placeholder_text("Type here to search...")
        self.search_entry.connect("changed", self.on_search_changed)
        self.search_entry.connect("activate", self.on_search_activate)
        search_box.pack_start(self.search_entry, True, True, 0)

        search_wrapper = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        search_wrapper.set_name("search-wrapper")
        search_wrapper.pack_start(search_box, False, False, 0)
        root_card.pack_start(search_wrapper, False, False, 0)

        # Scrollable Body (Pinned & Recommended)
        self.body_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.body_box.set_name("body-container")
        root_card.pack_start(self.body_box, True, True, 0)

        # Build initial view
        self.build_default_view()

        # 3. Bottom Footer (User & Power)
        root_card.pack_start(self.create_footer(), False, False, 0)

        # Events
        self.connect("key-press-event", self.on_key_press)
        self.connect("focus-out-event", self.on_focus_out)
        self.connect("destroy", self.cleanup)

        self.show_all()
        self.position_center()
        self.apply_cursor()

        GLib.idle_add(self.search_entry.grab_focus)

    def position_center(self):
        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor() or display.get_monitor_at_point(0, 0)
        geom = monitor.get_geometry()
        w, h = 640, 680
        pos_x = geom.x + (geom.width - w) // 2
        pos_y = geom.y + (geom.height - h) // 2
        self.move(pos_x, pos_y)

    def apply_cursor(self):
        display = Gdk.Display.get_default()
        cursor = Gdk.Cursor.new_from_name(display, "default") or Gdk.Cursor.new_from_name(display, "left_ptr")
        if cursor and self.get_window():
            self.get_window().set_cursor(cursor)

    def apply_css(self):
        css = b"""
        window {
            background-color: transparent;
        }
        #start-window {
            background-color: rgba(30, 30, 46, 0.96);
            border: 1.5px solid #cba6f7;
            border-radius: 18px;
            padding: 0px;
        }
        #search-wrapper {
            padding: 24px 28px 12px 28px;
        }
        #search-bar {
            background-color: #181825;
            border: 1px solid #313244;
            border-bottom: 2px solid #cba6f7;
            border-radius: 8px;
            padding: 4px 14px;
        }
        #search-icon {
            color: #cba6f7;
            font-family: 'JetBrainsMono Nerd Font';
            font-size: 11.5pt;
        }
        #search-entry {
            background-color: transparent;
            border: none;
            color: #cdd6f4;
            font-family: 'JetBrainsMono Nerd Font';
            font-size: 10.5pt;
        }
        #body-container {
            padding: 0px 28px 10px 28px;
        }
        .section-header {
            padding: 4px 4px;
        }
        .section-title {
            color: #cdd6f4;
            font-family: 'JetBrainsMono Nerd Font';
            font-size: 10pt;
            font-weight: bold;
        }
        .all-apps-btn {
            background-color: #313244;
            border: 1px solid #45475a;
            border-radius: 6px;
            padding: 2px 8px;
        }
        .all-apps-btn:hover {
            background-color: #45475a;
        }
        .all-apps-btn label {
            color: #cdd6f4;
            font-family: 'JetBrainsMono Nerd Font';
            font-size: 8.5pt;
        }
        .app-tile {
            background-color: transparent;
            border: 1px solid transparent;
            border-radius: 8px;
            padding: 8px 4px;
        }
        .app-tile:hover {
            background-color: #313244;
            border-color: #45475a;
        }
        .app-tile-label {
            color: #cdd6f4;
            font-family: 'JetBrainsMono Nerd Font';
            font-size: 8pt;
            margin-top: 4px;
        }
        .rec-item {
            background-color: transparent;
            border-radius: 8px;
            padding: 6px 8px;
        }
        .rec-item:hover {
            background-color: #313244;
        }
        .rec-title {
            color: #cdd6f4;
            font-family: 'JetBrainsMono Nerd Font';
            font-size: 9pt;
            font-weight: bold;
        }
        .rec-sub {
            color: #a6adc8;
            font-family: 'JetBrainsMono Nerd Font';
            font-size: 7.5pt;
        }
        #footer-bar {
            background-color: #181825;
            border-top: 1px solid #313244;
            border-radius: 0px 0px 18px 18px;
            padding: 12px 28px;
        }
        .avatar-circle {
            background-color: #313244;
            border-radius: 50%;
            min-width: 32px;
            min-height: 32px;
            font-family: 'lucide', 'JetBrainsMono Nerd Font';
            font-size: 13pt;
            color: #cba6f7;
        }
        .user-name {
            color: #cdd6f4;
            font-family: 'JetBrainsMono Nerd Font';
            font-size: 9.5pt;
            font-weight: bold;
            margin-left: 8px;
        }
        .footer-power-btn {
            background-color: transparent;
            border: none;
            border-radius: 8px;
            min-width: 34px;
            min-height: 34px;
            font-family: 'lucide', 'JetBrainsMono Nerd Font';
            font-size: 14pt;
            color: #f38ba8;
            padding: 0;
        }
        .footer-power-btn:hover {
            background-color: #313244;
        }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def build_default_view(self):
        # Clear body
        for child in self.body_box.get_children():
            child.destroy()

        # --- Section 1: Pinned Apps ---
        header_pinned = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        header_pinned.get_style_context().add_class("section-header")

        title_pinned = Gtk.Label(label="Pinned")
        title_pinned.get_style_context().add_class("section-title")
        header_pinned.pack_start(title_pinned, False, False, 0)

        all_apps_btn = Gtk.Button(label="All apps  >")
        all_apps_btn.get_style_context().add_class("all-apps-btn")
        all_apps_btn.connect("clicked", self.on_all_apps_clicked)
        header_pinned.pack_end(all_apps_btn, False, False, 0)

        self.body_box.pack_start(header_pinned, False, False, 0)

        # 6 Columns Grid of Pinned Apps (Top 18 apps)
        grid = Gtk.Grid()
        grid.set_column_spacing(6)
        grid.set_row_spacing(6)
        grid.set_column_homogeneous(True)
        grid.set_row_homogeneous(True)

        pinned_apps = self.all_apps[:18]
        for idx, app in enumerate(pinned_apps):
            col = idx % 6
            row = idx // 6
            btn = self.create_app_tile(app)
            grid.attach(btn, col, row, 1, 1)

        self.body_box.pack_start(grid, False, False, 0)

        # --- Section 2: Recommended Section ---
        header_rec = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        header_rec.get_style_context().add_class("section-header")

        title_rec = Gtk.Label(label="Recommended")
        title_rec.get_style_context().add_class("section-title")
        header_rec.pack_start(title_rec, False, False, 0)

        more_btn = Gtk.Button(label="More  >")
        more_btn.get_style_context().add_class("all-apps-btn")
        more_btn.connect("clicked", lambda w: (self.close_and_exit(), subprocess.Popen(["nemo"])))
        header_rec.pack_end(more_btn, False, False, 0)

        self.body_box.pack_start(header_rec, False, False, 0)

        # 2 Columns of Recommended Quick Actions
        rec_grid = Gtk.Grid()
        rec_grid.set_column_spacing(12)
        rec_grid.set_row_spacing(6)
        rec_grid.set_column_homogeneous(True)

        rec_items = [
            ("dev.recordly.app", "Recordly", "Screen recording", lambda: subprocess.Popen(["recordly"])),
            ("system-file-manager", "File Manager", "Browse files", lambda: subprocess.Popen(["nemo"])),
            ("utilities-terminal", "Terminal Kitty", "Open terminal", lambda: subprocess.Popen(["kitty"])),
            ("web-browser", "Brave Browser", "Browse the web", lambda: subprocess.Popen(["brave"])),
            ("preferences-desktop-wallpaper", "Wallpaper", "Change wallpaper", lambda: subprocess.Popen(["wallpaper-selector"])),
            ("utilities-system-monitor", "Process Monitor", "htop task manager", lambda: subprocess.Popen(["toggle-htop"])),
        ]

        for idx, (icon_name, name, desc, action) in enumerate(rec_items):
            col = idx % 2
            row = idx // 2
            item_box = self.create_rec_item(icon_name, name, desc, action)
            rec_grid.attach(item_box, col, row, 1, 1)

        self.body_box.pack_start(rec_grid, False, False, 0)
        self.body_box.show_all()

    def create_app_tile(self, app):
        btn = Gtk.Button()
        btn.get_style_context().add_class("app-tile")

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        box.set_halign(Gtk.Align.CENTER)
        box.set_valign(Gtk.Align.CENTER)

        # Icon
        icon = app.get_icon()
        if icon:
            img = Gtk.Image.new_from_gicon(icon, Gtk.IconSize.DIALOG)
            img.set_pixel_size(36)
        else:
            img = Gtk.Image.new_from_icon_name("application-x-executable", Gtk.IconSize.DIALOG)
            img.set_pixel_size(36)
        box.pack_start(img, False, False, 0)

        # Name label
        lbl = Gtk.Label(label=app.get_name())
        lbl.get_style_context().add_class("app-tile-label")
        lbl.set_ellipsize(Pango.EllipsizeMode.END)
        lbl.set_max_width_chars(9)
        box.pack_start(lbl, False, False, 0)

        btn.add(box)
        btn.connect("clicked", lambda w, a=app: self.launch_app(a))
        return btn

    def create_rec_item(self, icon_name, name, desc, action):
        btn = Gtk.Button()
        btn.get_style_context().add_class("rec-item")

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)

        img = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.LARGE_TOOLBAR)
        img.set_pixel_size(32)
        box.pack_start(img, False, False, 0)

        txt_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        txt_box.set_valign(Gtk.Align.CENTER)

        lbl_name = Gtk.Label(label=name, xalign=0)
        lbl_name.get_style_context().add_class("rec-title")
        txt_box.pack_start(lbl_name, False, False, 0)

        lbl_desc = Gtk.Label(label=desc, xalign=0)
        lbl_desc.get_style_context().add_class("rec-sub")
        txt_box.pack_start(lbl_desc, False, False, 0)

        box.pack_start(txt_box, True, True, 0)
        btn.add(box)
        btn.connect("clicked", lambda w: (self.close_and_exit(), action()))
        return btn

    def create_footer(self):
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        footer.set_name("footer-bar")

        # User Avatar
        avatar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        avatar.get_style_context().add_class("avatar-circle")
        av_lbl = Gtk.Label(label="")
        avatar.pack_start(av_lbl, True, True, 0)
        footer.pack_start(avatar, False, False, 0)

        # Username
        user_lbl = Gtk.Label(label=get_username(), xalign=0)
        user_lbl.get_style_context().add_class("user-name")
        footer.pack_start(user_lbl, False, False, 0)

        dummy = Gtk.Box()
        footer.pack_start(dummy, True, True, 0)

        # Power button (Lucide power)
        pwr_btn = Gtk.Button(label="")
        pwr_btn.get_style_context().add_class("footer-power-btn")
        bin_dir = os.path.expanduser("~/.local/bin")
        pwr_btn.connect("clicked", lambda w: (self.close_and_exit(), subprocess.Popen([os.path.join(bin_dir, "powermenu")])))
        footer.pack_start(pwr_btn, False, False, 0)

        return footer

    def on_search_changed(self, entry):
        query = entry.get_text().strip().lower()
        if not query:
            self.build_default_view()
            return

        # Show filtered search results grid
        for child in self.body_box.get_children():
            child.destroy()

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        header.get_style_context().add_class("section-header")
        title = Gtk.Label(label=f"Search Results")
        title.get_style_context().add_class("section-title")
        header.pack_start(title, False, False, 0)
        self.body_box.pack_start(header, False, False, 0)

        matches = [a for a in self.all_apps if query in a.get_name().lower() or query in a.get_display_name().lower() or (a.get_description() and query in a.get_description().lower())]
        self.filtered_apps = matches

        if matches:
            scroll = Gtk.ScrolledWindow()
            scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroll.set_min_content_height(420)

            grid = Gtk.Grid()
            grid.set_column_spacing(6)
            grid.set_row_spacing(6)
            grid.set_column_homogeneous(True)

            for idx, app in enumerate(matches):
                col = idx % 6
                row = idx // 6
                btn = self.create_app_tile(app)
                grid.attach(btn, col, row, 1, 1)

            scroll.add(grid)
            self.body_box.pack_start(scroll, True, True, 0)
        else:
            no_lbl = Gtk.Label(label=f"No results found for \"{query}\"")
            no_lbl.get_style_context().add_class("rec-sub")
            self.body_box.pack_start(no_lbl, True, True, 0)

        self.body_box.show_all()

    def on_search_activate(self, entry):
        if self.filtered_apps:
            self.launch_app(self.filtered_apps[0])

    def on_all_apps_clicked(self, widget):
        for child in self.body_box.get_children():
            child.destroy()

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        header.get_style_context().add_class("section-header")
        title = Gtk.Label(label="All Applications")
        title.get_style_context().add_class("section-title")
        header.pack_start(title, False, False, 0)

        back_btn = Gtk.Button(label="<  Back")
        back_btn.get_style_context().add_class("all-apps-btn")
        back_btn.connect("clicked", lambda w: self.build_default_view())
        header.pack_end(back_btn, False, False, 0)
        self.body_box.pack_start(header, False, False, 0)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_min_content_height(420)

        grid = Gtk.Grid()
        grid.set_column_spacing(6)
        grid.set_row_spacing(6)
        grid.set_column_homogeneous(True)

        for idx, app in enumerate(self.all_apps):
            col = idx % 6
            row = idx // 6
            btn = self.create_app_tile(app)
            grid.attach(btn, col, row, 1, 1)

        scroll.add(grid)
        self.body_box.pack_start(scroll, True, True, 0)
        self.body_box.show_all()

    def launch_app(self, app):
        self.close_and_exit()
        try:
            app.launch([], None)
        except Exception:
            cmd = app.get_commandline()
            if cmd:
                # Remove %u, %f, etc.
                clean_cmd = [part for part in cmd.split() if not part.startswith("%")]
                subprocess.Popen(clean_cmd)

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.close_and_exit()
            return True
        return False

    def on_focus_out(self, widget, event):
        self.close_and_exit()
        return False

    def close_and_exit(self):
        self.destroy()
        Gtk.main_quit()

    def cleanup(self, *args):
        if os.path.exists(PID_FILE):
            try:
                os.remove(PID_FILE)
            except Exception:
                pass

if __name__ == "__main__":
    win = Win11StartMenu()
    Gtk.main()
