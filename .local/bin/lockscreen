#!/usr/bin/env bash
# ==========================================================
# Catppuccin Mocha Circle Lockscreen (True 50% Blurred Wallpaper)
# ==========================================================

# Prevent duplicate lock processes
if pgrep -x "i3lock" >/dev/null 2>&1 || pgrep -x "i3lock-color" >/dev/null 2>&1; then
    exit 0
fi

# Prefer active wallpaper
if [ -e "$HOME/.cache/current_wallpaper" ]; then
    WALLPAPER="$(readlink -f "$HOME/.cache/current_wallpaper")"
elif [ -f "$HOME/Pictures/Wallpapers/catppuccin-aesthetic.jpg" ]; then
    WALLPAPER="$HOME/Pictures/Wallpapers/catppuccin-aesthetic.jpg"
else
    WALLPAPER="$HOME/Pictures/Wallpapers/catppuccin-astronaut.png"
fi

BLUR_CACHE="$HOME/.cache/lockscreen_blur.png"

# Detect primary/active screen resolution dynamically (fallback to 1920x1080)
SCREEN_W=$(xrandr --current 2>/dev/null | grep -oP '\d+(?=x\d+\s+.*\*)' | head -n 1)
SCREEN_H=$(xrandr --current 2>/dev/null | grep -oP '\d+x\K\d+(?=\s+.*\*)' | head -n 1)
SCREEN_W=${SCREEN_W:-1920}
SCREEN_H=${SCREEN_H:-1080}

# Generate 50% Gaussian blurred background if missing or wallpaper was updated
if [ ! -f "$BLUR_CACHE" ] || [ "$WALLPAPER" -nt "$BLUR_CACHE" ]; then
    magick "$WALLPAPER" -resize "${SCREEN_W}x${SCREEN_H}^" -gravity center -extent "${SCREEN_W}x${SCREEN_H}" -blur 0x12 "$BLUR_CACHE"
fi

# Load dynamic theme colors for lockscreen (auto-generated by theme_sync)
INSIDE_COLOR="1e1e2ebb"
RING_COLOR="cba6f7ff"
VER_COLOR="89b4faff"
WRONG_COLOR="f38ba8ff"
KEYHL_COLOR="a6e3a1ff"
BSHL_COLOR="fab387ff"
TIME_COLOR="cdd6f4ff"
DATE_COLOR="a6adc8ff"
VERIF_TEXT_COLOR="11111bff"
WRONG_TEXT_COLOR="11111bff"

if [ -f "$HOME/.config/i3/lock-colors" ]; then
    # shellcheck disable=SC1090
    . "$HOME/.config/i3/lock-colors"
fi

exec /usr/bin/i3lock \
  -i "$BLUR_CACHE" \
  --clock \
  --indicator \
  --radius=140 \
  --ring-width=8 \
  --inside-color="$INSIDE_COLOR" \
  --ring-color="$RING_COLOR" \
  --separator-color=00000000 \
  --insidever-color="$INSIDE_COLOR" \
  --ringver-color="$VER_COLOR" \
  --insidewrong-color="$INSIDE_COLOR" \
  --ringwrong-color="$WRONG_COLOR" \
  --keyhl-color="$KEYHL_COLOR" \
  --bshl-color="$BSHL_COLOR" \
  --time-color="$TIME_COLOR" \
  --time-font="JetBrainsMono Nerd Font" \
  --time-size=38 \
  --time-str="%H:%M:%S" \
  --date-color="$DATE_COLOR" \
  --date-font="JetBrainsMono Nerd Font" \
  --date-size=12 \
  --date-str="%A, %d %B %Y" \
  --verif-color="$VERIF_TEXT_COLOR" \
  --verif-font="JetBrainsMono Nerd Font" \
  --verif-size=18 \
  --verif-text="Verifying..." \
  --wrong-color="$WRONG_TEXT_COLOR" \
  --wrong-font="JetBrainsMono Nerd Font" \
  --wrong-size=18 \
  --wrong-text="Incorrect Password" \
  --noinput-text="No Input" \
  --pass-media-keys \
  --pass-volume-keys \
  --pass-power-keys \
  "$@"
