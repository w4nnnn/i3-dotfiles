#!/usr/bin/env bash
# ==========================================================
# Catppuccin Mocha Circle Lockscreen (Slightly Blurred Wallpaper)
# ==========================================================

# Prevent duplicate lock processes
if pgrep -x "i3lock" >/dev/null 2>&1 || pgrep -x "i3lock-color" >/dev/null 2>&1; then
    exit 0
fi

# Prefer the actively selected wallpaper from ~/.cache/current_wallpaper
if [ -e "$HOME/.cache/current_wallpaper" ]; then
    WALLPAPER="$HOME/.cache/current_wallpaper"
elif [ -f "$HOME/Pictures/Wallpapers/catppuccin-aesthetic.jpg" ]; then
    WALLPAPER="$HOME/Pictures/Wallpapers/catppuccin-aesthetic.jpg"
else
    WALLPAPER="$HOME/Pictures/Wallpapers/catppuccin-astronaut.png"
fi

exec /usr/bin/i3lock \
  -i "$WALLPAPER" \
  --fill \
  --blur 5 \
  --clock \
  --indicator \
  --radius=140 \
  --ring-width=8 \
  --inside-color=1e1e2ebb \
  --ring-color=cba6f7ff \
  --separator-color=00000000 \
  --insidever-color=89b4fabb \
  --ringver-color=89b4faff \
  --insidewrong-color=f38ba8bb \
  --ringwrong-color=f38ba8ff \
  --keyhl-color=a6e3a1ff \
  --bshl-color=fab387ff \
  --time-color=cdd6f4ff \
  --time-font="JetBrainsMono Nerd Font" \
  --time-size=38 \
  --time-str="%H:%M:%S" \
  --date-color=a6adc8ff \
  --date-font="JetBrainsMono Nerd Font" \
  --date-size=12 \
  --date-str="%A, %d %B %Y" \
  --verif-color=11111bff \
  --verif-font="JetBrainsMono Nerd Font" \
  --verif-size=18 \
  --verif-text="Verifying..." \
  --wrong-color=11111bff \
  --wrong-font="JetBrainsMono Nerd Font" \
  --wrong-size=18 \
  --wrong-text="Incorrect Password" \
  --noinput-text="No Input" \
  --pass-media-keys \
  --pass-volume-keys \
  --pass-power-keys \
  "$@"
