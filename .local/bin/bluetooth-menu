#!/usr/bin/env python3
"""
Catppuccin / Multi-Theme Bluetooth Manager Menu
A modern GTK3 Bluetooth Manager floating modal window,
featuring live device scanning, signal strength (RSSI), battery reporting,
device pairing/connecting, and quick terminal access.
"""
import sys
import os
import signal
import subprocess
import html
import threading
import time
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Pango", "1.0")
gi.require_version("Gio", "2.0")
from gi.repository import Gtk, Gdk, GLib, Pango, Gio

# Add local lib to path
lib_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), "../lib"))
if lib_dir not in sys.path:
    sys.path.insert(0, lib_dir)
user_lib = os.path.expanduser("~/.local/lib")
if user_lib not in sys.path:
    sys.path.insert(0, user_lib)

from dotfiles.themes import get_current_theme
from dotfiles.gtk_utils import (
    manage_single_instance,
    cleanup_pid,
    grab_seat,
    ungrab_seat,
    is_click_outside,
    center_window,
    setup_transparent_window,
    notify,
)
from dotfiles.bluetooth import (
    get_device_icon,
    fetch_bluetooth_state,
    connect_device,
    pair_device,
    disconnect_device,
    set_adapter_discovery,
    set_adapter_power,
)
from dotfiles.styles.bluetooth import get_bluetooth_css

PID_FILE = "/tmp/bluetooth_menu_gtk.pid"

class BluetoothManagerWindow(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("CatppuccinBluetoothMenu")
        self.set_role("bluetooth-menu-popup")
        setup_transparent_window(self)

        self.theme = get_current_theme()
        self.apply_css()

        self.all_devices = []
        self.bt_enabled = False
        self.adapter_path = None
        self.is_scanning = False
        self.scan_timer_id = None
        self._poll_timer_id = None
        self._refresh_timer_id = None
        self._is_refreshing = False
        self._pending_refresh = False
        self._dbus_subs = []
        self.bus = None

        self._init_dbus()
        self._build_ui()
        center_window(self, 660, 480)

        self.connect("key-press-event", self.on_key_press)
        self.connect("button-press-event", self.on_button_press)
        self.connect("map-event", lambda w, e: GLib.idle_add(lambda: grab_seat(self)))
        self.connect("destroy", lambda w: cleanup_pid(PID_FILE))

        self.refresh_state(rescan=True)

    def _init_dbus(self):
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            if self.bus:
                for sig in ("InterfacesAdded", "InterfacesRemoved"):
                    self._dbus_subs.append(self.bus.signal_subscribe(
                        "org.bluez", "org.freedesktop.DBus.ObjectManager", sig, "/", None,
                        Gio.DBusSignalFlags.NONE, self._on_dbus_signal, None
                    ))
                self._dbus_subs.append(self.bus.signal_subscribe(
                    "org.bluez", "org.freedesktop.DBus.Properties", "PropertiesChanged", None, None,
                    Gio.DBusSignalFlags.NONE, self._on_dbus_signal, None
                ))
        except Exception:
            self.bus = None
            self._dbus_subs = []

    def _on_dbus_signal(self, *args):
        GLib.idle_add(self._schedule_refresh)

    def _schedule_refresh(self, delay_ms=300):
        if self._refresh_timer_id:
            GLib.source_remove(self._refresh_timer_id)
        self._refresh_timer_id = GLib.timeout_add(delay_ms, self._do_scheduled_refresh)

    def _do_scheduled_refresh(self):
        self._refresh_timer_id = None
        self.refresh_state(rescan=False)
        return False

    def on_button_press(self, widget, event):
        if is_click_outside(self, event):
            self.close_and_exit()
            return True
        return False

    def close_and_exit(self):
        if self.scan_timer_id:
            GLib.source_remove(self.scan_timer_id)
            self.scan_timer_id = None
        if self._poll_timer_id:
            GLib.source_remove(self._poll_timer_id)
            self._poll_timer_id = None
        if self._refresh_timer_id:
            GLib.source_remove(self._refresh_timer_id)
            self._refresh_timer_id = None

        if self.bus and self._dbus_subs:
            for sub in self._dbus_subs:
                try:
                    self.bus.signal_unsubscribe(sub)
                except Exception:
                    pass
            self._dbus_subs = []

        if self.is_scanning:
            self.stop_scan()
        ungrab_seat()
        cleanup_pid(PID_FILE)
        self.destroy()
        Gtk.main_quit()

    def apply_css(self):
        css = get_bluetooth_css(self.theme)
        provider = Gtk.CssProvider()
        provider.load_from_data(css.encode())
        Gtk.StyleContext.add_provider_for_screen(
            self.get_screen(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def _build_ui(self):
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        main_box.set_name("main-card")
        main_box.set_size_request(660, 480)
        self.add(main_box)

        # 1. Input Bar (Pill search box with prompt icon)
        inputbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        inputbar.set_name("inputbar")

        prompt_icon = Gtk.Label(label="")
        prompt_icon.set_name("prompt-icon")
        inputbar.pack_start(prompt_icon, False, False, 0)

        self.search_entry = Gtk.Entry()
        self.search_entry.set_name("search-entry")
        self.search_entry.set_placeholder_text("Filter Bluetooth devices...")
        self.search_entry.connect("changed", lambda e: self.render_device_list(self.all_devices))
        inputbar.pack_start(self.search_entry, True, True, 0)

        main_box.pack_start(inputbar, False, False, 0)

        # 2. Listview of Devices
        self.scrolled = Gtk.ScrolledWindow()
        self.scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.listbox = Gtk.ListBox()
        self.listbox.set_name("listbox")
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.listbox.connect("row-activated", self.on_row_activated)
        self.scrolled.add(self.listbox)
        main_box.pack_start(self.scrolled, True, True, 0)

        # 3. Action Footer Toolbar
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        footer.set_name("footer-bar")

        def add_btn(lbl, cls, tip, cb):
            btn = Gtk.Button(label=lbl)
            btn.get_style_context().add_class("footer-action-btn")
            btn.get_style_context().add_class(cls)
            btn.set_tooltip_text(tip)
            btn.connect("clicked", lambda w: cb())
            footer.pack_start(btn, True, True, 0)
            return btn

        self.disconn_btn = add_btn("󰅖 Disconnect", "danger", "Disconnect Active Device", self.action_disconnect_selected)
        self.rescan_btn = add_btn("󰑐 Rescan", "rescan", "Scan for Nearby Devices (15s)", self.action_toggle_scan)
        self.term_btn = add_btn("󰢻 Terminal", "terminal", "Open bluetoothctl in Floating Terminal",
                                lambda: (self.close_and_exit(), subprocess.Popen(["kitty", "--class", "floating_terminal", "-e", "bluetoothctl"])))
        self.radio_btn = add_btn("󰂲 BT Off", "radio", "Turn Bluetooth Off", self.action_toggle_radio)
        main_box.pack_start(footer, False, False, 0)

    def refresh_state(self, rescan=False):
        if self._is_refreshing:
            self._pending_refresh = True
            return
        self._is_refreshing = True

        def worker():
            powered, adapter_path, devices = fetch_bluetooth_state(self.bus)
            GLib.idle_add(self._on_refresh_done, powered, adapter_path, devices, rescan)

        threading.Thread(target=worker, daemon=True).start()

    def _on_refresh_done(self, powered, adapter_path, devices, rescan):
        self._is_refreshing = False
        self.update_ui_state(powered, adapter_path, devices, rescan)
        if self._pending_refresh:
            self._pending_refresh = False
            self.refresh_state(rescan=False)

    def update_ui_state(self, powered, adapter_path, devices, rescan):
        self.bt_enabled = powered
        self.adapter_path = adapter_path
        self.all_devices = devices

        if self.bt_enabled:
            self.radio_btn.set_label("󰂲 BT Off")
            self.radio_btn.set_tooltip_text("Turn Bluetooth Off")
            self.rescan_btn.set_sensitive(True)
            if self.is_scanning:
                self.rescan_btn.set_label("󰑐 Scanning...")
            else:
                self.rescan_btn.set_label("󰑐 Rescan")
            if rescan and not self.is_scanning:
                self.start_scan()
        else:
            self.radio_btn.set_label("󰂯 BT On")
            self.radio_btn.set_tooltip_text("Turn Bluetooth On")
            self.rescan_btn.set_sensitive(False)
            if self.is_scanning:
                self.stop_scan()

        has_connected = any(d["connected"] for d in self.all_devices)
        self.disconn_btn.set_sensitive(has_connected)

        self.render_device_list(self.all_devices)

    def render_device_list(self, devices):
        cur_row = self.listbox.get_selected_row()
        selected_addr = cur_row.dev_data["address"] if (cur_row and hasattr(cur_row, "dev_data")) else None

        for child in self.listbox.get_children():
            self.listbox.remove(child)

        query = self.search_entry.get_text().strip().lower()
        filtered = [d for d in devices if query in d["name"].lower() or query in d["address"].lower()] if query else devices

        if not filtered:
            row = Gtk.ListBoxRow()
            if not self.bt_enabled:
                msg = "Bluetooth is Disabled · Turn Bluetooth On below"
            elif self.is_scanning:
                msg = "󰑐 Scanning for Bluetooth devices in range..."
            else:
                msg = "No devices found · Click Rescan to discover nearby devices"
            lbl = Gtk.Label(label=msg)
            lbl.get_style_context().add_class("element-text")
            lbl.set_margin_top(18)
            lbl.set_margin_bottom(18)
            row.add(lbl)
            self.listbox.add(row)
            self.listbox.show_all()
            return

        matched_row = None
        for dev in filtered:
            row = Gtk.ListBoxRow()
            row.dev_data = dev
            if selected_addr and dev["address"] == selected_addr:
                matched_row = row

            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            box.get_style_context().add_class("element-row")
            if dev["connected"]:
                box.get_style_context().add_class("connected")

            # Device Type Icon
            icon_char = get_device_icon(dev["icon"], dev["name"])
            icon_lbl = Gtk.Label(label=icon_char)
            icon_lbl.get_style_context().add_class("element-icon")
            box.pack_start(icon_lbl, False, False, 0)

            # Name & MAC
            info_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            name_lbl = Gtk.Label(label=f"<b>{html.escape(dev['name'])}</b>", xalign=0)
            name_lbl.set_use_markup(True)
            name_lbl.get_style_context().add_class("element-text")
            name_lbl.set_ellipsize(Pango.EllipsizeMode.END)
            name_lbl.set_max_width_chars(30)
            info_box.pack_start(name_lbl, False, False, 0)

            addr_lbl = Gtk.Label(label=dev["address"], xalign=0)
            addr_lbl.get_style_context().add_class("element-sub")
            info_box.pack_start(addr_lbl, False, False, 0)
            box.pack_start(info_box, True, True, 0)

            # Badges
            if dev["connected"]:
                badge = Gtk.Label(label="CONNECTED")
                badge.get_style_context().add_class("badge-connected")
                box.pack_start(badge, False, False, 0)
            elif dev["paired"]:
                badge = Gtk.Label(label="PAIRED")
                badge.get_style_context().add_class("badge-paired")
                box.pack_start(badge, False, False, 0)

            if dev["battery"] is not None:
                bat_lbl = Gtk.Label(label=f"󰁹 {dev['battery']}%")
                bat_lbl.get_style_context().add_class("badge-battery")
                box.pack_start(bat_lbl, False, False, 0)
            elif dev["rssi"] != 0:
                rssi_lbl = Gtk.Label(label=f"{dev['rssi']} dBm")
                rssi_lbl.get_style_context().add_class("badge-rssi")
                box.pack_start(rssi_lbl, False, False, 0)

            row.add(box)
            self.listbox.add(row)

        self.listbox.show_all()
        target = matched_row or self.listbox.get_row_at_index(0)
        if target:
            self.listbox.select_row(target)

    def on_row_activated(self, listbox, row):
        if not hasattr(row, "dev_data"):
            return
        dev = row.dev_data

        if dev["connected"]:
            self.action_disconnect_device(dev)
        elif dev["paired"]:
            self.action_connect_device(dev)
        else:
            self.action_pair_device(dev)

    def action_connect_device(self, dev):
        notify("Bluetooth", "Connecting...", f"Connecting to {dev['name']} ({dev['address']})...", icon="bluetooth-active")
        def worker():
            success = connect_device(self.bus, dev)
            title, msg, ic = ("Connected", f"Connected to {dev['name']}.", "bluetooth") if success else ("Failed", f"Could not connect to {dev['name']}.", "dialog-error")
            notify("Bluetooth", title, msg, icon=ic)
            time.sleep(0.5)
            self.refresh_state()
        threading.Thread(target=worker, daemon=True).start()

    def action_pair_device(self, dev):
        notify("Bluetooth", "Pairing...", f"Pairing with {dev['name']}...", icon="bluetooth-active")
        def worker():
            success = pair_device(dev)
            title, msg, ic = ("Paired & Connected", f"Successfully connected to {dev['name']}.", "bluetooth") if success else ("Pairing Failed", f"Could not pair with {dev['name']}.", "dialog-error")
            notify("Bluetooth", title, msg, icon=ic)
            time.sleep(0.5)
            self.refresh_state()
        threading.Thread(target=worker, daemon=True).start()

    def action_disconnect_device(self, dev):
        notify("Bluetooth", "Disconnecting...", f"Disconnecting {dev['name']}...", icon="bluetooth")
        def worker():
            disconnect_device(self.bus, dev)
            notify("Bluetooth", "Disconnected", f"Disconnected from {dev['name']}.", icon="bluetooth")
            time.sleep(0.3)
            self.refresh_state()
        threading.Thread(target=worker, daemon=True).start()

    def action_disconnect_selected(self):
        cur = self.listbox.get_selected_row()
        if cur and hasattr(cur, "dev_data") and cur.dev_data["connected"]:
            self.action_disconnect_device(cur.dev_data)
        else:
            conn = [d for d in self.all_devices if d["connected"]]
            if conn:
                self.action_disconnect_device(conn[0])

    def action_toggle_scan(self):
        if self.is_scanning:
            self.stop_scan()
        else:
            self.start_scan()

    def start_scan(self):
        if not self.bt_enabled:
            return
        self.is_scanning = True
        self.rescan_btn.set_label("󰑐 Scanning...")
        threading.Thread(target=lambda: set_adapter_discovery(self.bus, self.adapter_path, True), daemon=True).start()

        if self.scan_timer_id:
            GLib.source_remove(self.scan_timer_id)
        self.scan_timer_id = GLib.timeout_add_seconds(15, self.stop_scan)

        if self._poll_timer_id:
            GLib.source_remove(self._poll_timer_id)
        self._poll_timer_id = GLib.timeout_add_seconds(2, self._scan_poll_tick)

    def _scan_poll_tick(self):
        if not self.is_scanning:
            self._poll_timer_id = None
            return False
        self.refresh_state(rescan=False)
        return True

    def stop_scan(self):
        self.is_scanning = False
        self.rescan_btn.set_label("󰑐 Rescan")
        if self.scan_timer_id:
            GLib.source_remove(self.scan_timer_id)
            self.scan_timer_id = None
        if self._poll_timer_id:
            GLib.source_remove(self._poll_timer_id)
            self._poll_timer_id = None

        threading.Thread(target=lambda: set_adapter_discovery(self.bus, self.adapter_path, False), daemon=True).start()
        self.refresh_state(rescan=False)
        return False

    def action_toggle_radio(self):
        target = not self.bt_enabled
        set_adapter_power(self.bus, self.adapter_path, target)
        notify("Bluetooth",
               "Bluetooth Enabled" if target else "Bluetooth Disabled",
               "Scanning for devices..." if target else "Bluetooth radio turned off.",
               icon="bluetooth" if target else "bluetooth-disabled")
        time.sleep(0.3)
        self.refresh_state(rescan=target)

    def on_key_press(self, widget, event):
        keyval = event.keyval
        state = event.state

        if keyval == Gdk.KEY_Escape:
            self.close_and_exit()
            return True

        if state & Gdk.ModifierType.MOD1_MASK:
            if keyval in (Gdk.KEY_r, Gdk.KEY_R):
                self.action_toggle_scan()
                return True
            elif keyval in (Gdk.KEY_d, Gdk.KEY_D):
                self.action_disconnect_selected()
                return True
            elif keyval in (Gdk.KEY_t, Gdk.KEY_T):
                self.action_toggle_radio()
                return True
            elif keyval in (Gdk.KEY_s, Gdk.KEY_S):
                self.close_and_exit()
                subprocess.Popen(["kitty", "--class", "floating_terminal", "-e", "bluetoothctl"])
                return True

        if keyval in (Gdk.KEY_Down, Gdk.KEY_Up):
            cur = self.listbox.get_selected_row()
            if cur:
                delta = 1 if keyval == Gdk.KEY_Down else -1
                target = self.listbox.get_row_at_index(max(0, cur.get_index() + delta))
                if target:
                    self.listbox.select_row(target)
                    target.grab_focus()
                    return True

        return False

def main():
    manage_single_instance(PID_FILE)
    win = BluetoothManagerWindow()
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
