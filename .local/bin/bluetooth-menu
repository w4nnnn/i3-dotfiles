    def _build_ui(self):
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        main_box.set_name("main-card")
        main_box.set_size_request(660, 480)
        self.add(main_box)

        # 1. Input Bar (Pill search box with prompt icon)
        inputbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        inputbar.set_name("inputbar")

        prompt_icon = Gtk.Label(label="")
        prompt_icon.set_name("prompt-icon")
        inputbar.pack_start(prompt_icon, False, False, 0)

        self.search_entry = Gtk.Entry()
        self.search_entry.set_name("search-entry")
        self.search_entry.set_placeholder_text("Filter Bluetooth devices...")
        self.search_entry.connect("changed", self.on_search_changed)
        inputbar.pack_start(self.search_entry, True, True, 0)

        main_box.pack_start(inputbar, False, False, 0)

        # 2. Listview of Devices
        self.scrolled = Gtk.ScrolledWindow()
        self.scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.listbox = Gtk.ListBox()
        self.listbox.set_name("listbox")
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.listbox.connect("row-activated", self.on_row_activated)
        self.scrolled.add(self.listbox)
        main_box.pack_start(self.scrolled, True, True, 0)

        # 3. Action Footer Toolbar
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        footer.set_name("footer-bar")

        # Disconnect / Unpair Button
        self.disconn_btn = Gtk.Button(label="󰅖 Disconnect")
        self.disconn_btn.get_style_context().add_class("footer-action-btn")
        self.disconn_btn.get_style_context().add_class("danger")
        self.disconn_btn.set_tooltip_text("Disconnect Active Device")
        self.disconn_btn.connect("clicked", lambda w: self.action_disconnect_selected())
        footer.pack_start(self.disconn_btn, True, True, 0)

        # Rescan Button
        self.rescan_btn = Gtk.Button(label="󰑐 Rescan")
        self.rescan_btn.get_style_context().add_class("footer-action-btn")
        self.rescan_btn.get_style_context().add_class("rescan")
        self.rescan_btn.set_tooltip_text("Scan for Nearby Devices (15s)")
        self.rescan_btn.connect("clicked", lambda w: self.action_toggle_scan())
        footer.pack_start(self.rescan_btn, True, True, 0)

        # Terminal / CLI Button
        self.term_btn = Gtk.Button(label="󰢻 Terminal")
        self.term_btn.get_style_context().add_class("footer-action-btn")
        self.term_btn.get_style_context().add_class("terminal")
        self.term_btn.set_tooltip_text("Open bluetoothctl in Floating Terminal")
        self.term_btn.connect("clicked", lambda w: (self.close_and_exit(), subprocess.Popen(["kitty", "--class", "floating_terminal", "-e", "bluetoothctl"])))
        footer.pack_start(self.term_btn, True, True, 0)

        # Radio Toggle Button
        self.radio_btn = Gtk.Button(label="󰂲 BT Off")
        self.radio_btn.get_style_context().add_class("footer-action-btn")
        self.radio_btn.get_style_context().add_class("radio")
        self.radio_btn.set_tooltip_text("Turn Bluetooth Off")
        self.radio_btn.connect("clicked", lambda w: self.action_toggle_radio())
        footer.pack_start(self.radio_btn, True, True, 0)

        main_box.pack_start(footer, False, False, 0)

    def position_window(self):
        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor() or display.get_monitor_at_point(0, 0)
        geom = monitor.get_geometry()

        win_w, win_h = 660, 480
        x = geom.x + (geom.width - win_w) // 2
        y = geom.y + (geom.height - win_h) // 2
        self.move(x, y)

    def get_device_icon(self, icon_str, name):
        name_lower = name.lower()
        if any(w in name_lower for w in ["headphone", "headset", "earphone", "buds", "airpod", "wh-", "wf-"]):
            return "󰋋"
        if any(w in name_lower for w in ["speaker", "soundbar", "audio", "jbl", "bose", "echo"]):
            return "󰓃"
        if any(w in name_lower for w in ["mouse", "trackpad"]):
            return "󰍽"
        if any(w in name_lower for w in ["keyboard", "keychron"]):
            return "󰌌"
        if any(w in name_lower for w in ["gamepad", "controller", "xbox", "ps4", "ps5", "dualshock"]):
            return "󰊴"
        if any(w in name_lower for w in ["phone", "galaxy", "iphone", "pixel", "redmi", "xiaomi"]):
            return "󰏲"
        if any(w in name_lower for w in ["watch", "band", "fit"]):
            return "󰂵"
        if any(w in name_lower for w in ["tv", "smart tv", "bravia", "roku", "basemen"]):
            return "󰍹"
        if any(w in name_lower for w in ["pc", "laptop", "desktop", "macbook"]):
            return "󰌢"

        if "audio" in icon_str or "headset" in icon_str:
            return "󰋋"
        if "input-mouse" in icon_str:
            return "󰍽"
        if "input-keyboard" in icon_str:
            return "󰌌"
        if "input-gaming" in icon_str:
            return "󰊴"
        if "phone" in icon_str:
            return "󰏲"
        if "computer" in icon_str:
            return "󰌢"

        return "󰂯"

    def refresh_state(self, rescan=False):
        def worker():
            powered = False
            adapter_path = None
            devices = []

            if self.bus:
                try:
                    om = Gio.DBusProxy.new_sync(
                        self.bus, Gio.DBusProxyFlags.NONE, None,
                        "org.bluez", "/", "org.freedesktop.DBus.ObjectManager", None
                    )
                    managed = om.GetManagedObjects()

                    for path, ifaces in managed.items():
                        if "org.bluez.Adapter1" in ifaces:
                            adapter_path = path
                            powered = bool(ifaces["org.bluez.Adapter1"].get("Powered", False))
                            break

                    for path, ifaces in managed.items():
                        if "org.bluez.Device1" in ifaces:
                            d = ifaces["org.bluez.Device1"]
                            bat = ifaces.get("org.bluez.Battery1", {}).get("Percentage", None)
                            name = d.get("Alias", d.get("Name", d.get("Address", "Unknown")))
                            addr = d.get("Address", "")
                            paired = bool(d.get("Paired", False))
                            connected = bool(d.get("Connected", False))
                            trusted = bool(d.get("Trusted", False))
                            icon_name = d.get("Icon", "bluetooth")
                            rssi = d.get("RSSI", 0)

                            devices.append({
                                "path": path,
                                "name": name,
                                "address": addr,
                                "paired": paired,
                                "connected": connected,
                                "trusted": trusted,
                                "icon": icon_name,
                                "rssi": rssi,
                                "battery": bat,
                            })
                except Exception:
                    pass

            if not adapter_path:
                try:
                    out = subprocess.check_output(["bluetoothctl", "show"], stderr=subprocess.DEVNULL, text=True)
                    powered = "Powered: yes" in out
                except Exception:
                    powered = False

            # Sort devices: 1. Connected, 2. Paired, 3. Discovered by RSSI
            devices.sort(key=lambda x: (not x["connected"], not x["paired"], -x["rssi"]))

            GLib.idle_add(self.update_ui_state, powered, adapter_path, devices, rescan)

        threading.Thread(target=worker, daemon=True).start()

    def update_ui_state(self, powered, adapter_path, devices, rescan):
        self.bt_enabled = powered
        self.adapter_path = adapter_path
        self.all_devices = devices

        if self.bt_enabled:
            self.radio_btn.set_label("󰂲 BT Off")
            self.radio_btn.set_tooltip_text("Turn Bluetooth Off")
            if rescan and not self.is_scanning:
                self.start_scan()
        else:
            self.radio_btn.set_label("󰂯 BT On")
            self.radio_btn.set_tooltip_text("Turn Bluetooth On")
            if self.is_scanning:
                self.stop_scan()

        has_connected = any(d["connected"] for d in self.all_devices)
        self.disconn_btn.set_sensitive(has_connected)

        self.render_device_list(self.all_devices)

    def render_device_list(self, devices):
        for child in self.listbox.get_children():
            self.listbox.remove(child)

        query = self.search_entry.get_text().strip().lower()
        if query:
            filtered = [d for d in devices if query in d["name"].lower() or query in d["address"].lower()]
        else:
            filtered = devices

        if not filtered:
            row = Gtk.ListBoxRow()
            if not self.bt_enabled:
                msg = "Bluetooth is Disabled · Turn Bluetooth On below"
            elif self.is_scanning:
                msg = "󰑐 Scanning for Bluetooth devices in range..."
            else:
                msg = "No devices found · Click Rescan to discover nearby devices"
            lbl = Gtk.Label(label=msg)
            lbl.get_style_context().add_class("element-text")
            lbl.set_padding(18, 18)
            row.add(lbl)
            self.listbox.add(row)
            self.listbox.show_all()
            return

        for idx, dev in enumerate(filtered):
            row = Gtk.ListBoxRow()
            row.dev_data = dev

            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            box.get_style_context().add_class("element-row")
            if dev["connected"]:
                box.get_style_context().add_class("connected")

            # Device Type Icon
            icon_char = self.get_device_icon(dev["icon"], dev["name"])
            icon_lbl = Gtk.Label(label=icon_char)
            icon_lbl.get_style_context().add_class("element-icon")
            box.pack_start(icon_lbl, False, False, 0)

            # Name & MAC
            info_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            name_lbl = Gtk.Label(label=f"<b>{html.escape(dev['name'])}</b>", xalign=0)
            name_lbl.set_use_markup(True)
            name_lbl.get_style_context().add_class("element-text")
            name_lbl.set_ellipsize(Pango.EllipsizeMode.END)
            name_lbl.set_max_width_chars(30)
            info_box.pack_start(name_lbl, False, False, 0)

            addr_lbl = Gtk.Label(label=dev["address"], xalign=0)
            addr_lbl.get_style_context().add_class("element-sub")
            info_box.pack_start(addr_lbl, False, False, 0)
            box.pack_start(info_box, True, True, 0)

            # Badges
            if dev["connected"]:
                badge = Gtk.Label(label="CONNECTED")
                badge.get_style_context().add_class("badge-connected")
                box.pack_start(badge, False, False, 0)
            elif dev["paired"]:
                badge = Gtk.Label(label="PAIRED")
                badge.get_style_context().add_class("badge-paired")
                box.pack_start(badge, False, False, 0)

            if dev["battery"] is not None:
                bat_lbl = Gtk.Label(label=f"󰁹 {dev['battery']}%")
                bat_lbl.get_style_context().add_class("badge-battery")
                box.pack_start(bat_lbl, False, False, 0)
            elif dev["rssi"] != 0:
                rssi_lbl = Gtk.Label(label=f"{dev['rssi']} dBm")
                rssi_lbl.get_style_context().add_class("badge-rssi")
                box.pack_start(rssi_lbl, False, False, 0)

            row.add(box)
            self.listbox.add(row)

        self.listbox.show_all()
        first_row = self.listbox.get_row_at_index(0)
        if first_row:
            self.listbox.select_row(first_row)

    def on_search_changed(self, entry):
        self.render_device_list(self.all_devices)

    def on_row_activated(self, listbox, row):
        if not hasattr(row, "dev_data"):
            return
        dev = row.dev_data
        target_name = dev["name"]
        target_addr = dev["address"]
        target_path = dev["path"]

        if dev["connected"]:
            # Prompt or Disconnect
            self.action_disconnect_device(dev)
        elif dev["paired"]:
            # Connect
            self.action_connect_device(dev)
        else:
            # Pair & Connect
            self.action_pair_device(dev)

    def action_connect_device(self, dev):
        notify("Connecting...", f"Connecting to {dev['name']} ({dev['address']})...", icon="bluetooth-active")

        def worker():
            success = False
            if self.bus and dev.get("path"):
                try:
                    d_proxy = Gio.DBusProxy.new_sync(
                        self.bus, Gio.DBusProxyFlags.NONE, None,
                        "org.bluez", dev["path"], "org.bluez.Device1", None
                    )
                    d_proxy.Connect()
                    success = True
                except Exception:
                    pass

            if not success:
                res = subprocess.run(["bluetoothctl", "connect", dev["address"]], capture_output=True, text=True)
                success = "Connection successful" in res.stdout or res.returncode == 0

            if success:
                notify("Connected", f"Connected to {dev['name']}.", icon="bluetooth")
            else:
                notify("Failed", f"Could not connect to {dev['name']}.", icon="dialog-error")

            time.sleep(0.5)
            self.refresh_state()

        threading.Thread(target=worker, daemon=True).start()

    def action_pair_device(self, dev):
        notify("Pairing...", f"Pairing with {dev['name']}...", icon="bluetooth-active")

        def worker():
            success = False
            # Trust and pair via bluetoothctl for robust PIN/passkey handling
            res_trust = subprocess.run(["bluetoothctl", "trust", dev["address"]], capture_output=True)
            res_pair = subprocess.run(["bluetoothctl", "pair", dev["address"]], capture_output=True, text=True)
            res_conn = subprocess.run(["bluetoothctl", "connect", dev["address"]], capture_output=True, text=True)

            if "successful" in res_conn.stdout or "Connection successful" in res_pair.stdout or res_conn.returncode == 0:
                success = True

            if success:
                notify("Paired & Connected", f"Successfully connected to {dev['name']}.", icon="bluetooth")
            else:
                notify("Pairing Failed", f"Could not pair with {dev['name']}.", icon="dialog-error")

            time.sleep(0.5)
            self.refresh_state()

        threading.Thread(target=worker, daemon=True).start()

    def action_disconnect_device(self, dev):
        notify("Disconnecting...", f"Disconnecting {dev['name']}...", icon="bluetooth")

        def worker():
            success = False
            if self.bus and dev.get("path"):
                try:
                    d_proxy = Gio.DBusProxy.new_sync(
                        self.bus, Gio.DBusProxyFlags.NONE, None,
                        "org.bluez", dev["path"], "org.bluez.Device1", None
                    )
                    d_proxy.Disconnect()
                    success = True
                except Exception:
                    pass

            if not success:
                subprocess.run(["bluetoothctl", "disconnect", dev["address"]], stderr=subprocess.DEVNULL)

            notify("Disconnected", f"Disconnected from {dev['name']}.", icon="bluetooth")
            time.sleep(0.3)
            self.refresh_state()

        threading.Thread(target=worker, daemon=True).start()

    def action_disconnect_selected(self):
        cur = self.listbox.get_selected_row()
        if cur and hasattr(cur, "dev_data") and cur.dev_data["connected"]:
            self.action_disconnect_device(cur.dev_data)
        else:
            # Disconnect any connected device
            conn = [d for d in self.all_devices if d["connected"]]
            if conn:
                self.action_disconnect_device(conn[0])

    def action_toggle_scan(self):
        if self.is_scanning:
            self.stop_scan()
        else:
            self.start_scan()

    def start_scan(self):
        if not self.bt_enabled:
            return
        self.is_scanning = True
        self.rescan_btn.set_label("󰑐 Scanning...")

        def worker():
            if self.bus and self.adapter_path:
                try:
                    adapter = Gio.DBusProxy.new_sync(
                        self.bus, Gio.DBusProxyFlags.NONE, None,
                        "org.bluez", self.adapter_path, "org.bluez.Adapter1", None
                    )
                    adapter.StartDiscovery()
                except Exception:
                    pass
            else:
                subprocess.Popen(["bluetoothctl", "--timeout", "15", "scan", "on"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        threading.Thread(target=worker, daemon=True).start()

        # Stop scan after 15 seconds
        if self.scan_timer_id:
            GLib.source_remove(self.scan_timer_id)
        self.scan_timer_id = GLib.timeout_add_seconds(15, self.stop_scan)

    def stop_scan(self):
        self.is_scanning = False
        self.rescan_btn.set_label("󰑐 Rescan")
        if self.scan_timer_id:
            GLib.source_remove(self.scan_timer_id)
            self.scan_timer_id = None

        def worker():
            if self.bus and self.adapter_path:
                try:
                    adapter = Gio.DBusProxy.new_sync(
                        self.bus, Gio.DBusProxyFlags.NONE, None,
                        "org.bluez", self.adapter_path, "org.bluez.Adapter1", None
                    )
                    adapter.StopDiscovery()
                except Exception:
                    pass

        threading.Thread(target=worker, daemon=True).start()
        return False

    def action_toggle_radio(self):
        target = not self.bt_enabled
        if target:
            subprocess.run(["rfkill", "unblock", "bluetooth"], stderr=subprocess.DEVNULL)
            time.sleep(0.1)

        if self.bus and self.adapter_path:
            try:
                adapter_prop = Gio.DBusProxy.new_sync(
                    self.bus, Gio.DBusProxyFlags.NONE, None,
                    "org.bluez", self.adapter_path, "org.freedesktop.DBus.Properties", None
                )
                adapter_prop.Set("(ssv)", "org.bluez.Adapter1", "Powered", GLib.Variant.new_boolean(target))
            except Exception:
                pass
        else:
            cmd = "on" if target else "off"
            subprocess.run(["bluetoothctl", "power", cmd], stderr=subprocess.DEVNULL)

        notify("Bluetooth Enabled" if target else "Bluetooth Disabled",
               "Scanning for devices..." if target else "Bluetooth radio turned off.")
        time.sleep(0.3)
        self.refresh_state(rescan=target)

    def on_key_press(self, widget, event):
        keyval = event.keyval
        state = event.state

        if keyval == Gdk.KEY_Escape:
            self.close_and_exit()
            return True

        if state & Gdk.ModifierType.MOD1_MASK:
            if keyval in (Gdk.KEY_r, Gdk.KEY_R):
                self.action_toggle_scan()
                return True
            elif keyval in (Gdk.KEY_d, Gdk.KEY_D):
                self.action_disconnect_selected()
                return True
            elif keyval in (Gdk.KEY_t, Gdk.KEY_T):
                self.action_toggle_radio()
                return True
            elif keyval in (Gdk.KEY_s, Gdk.KEY_S):
                self.close_and_exit()
                subprocess.Popen(["kitty", "--class", "floating_terminal", "-e", "bluetoothctl"])
                return True

        if keyval == Gdk.KEY_Down:
            cur = self.listbox.get_selected_row()
            if cur:
                idx = cur.get_index()
                next_row = self.listbox.get_row_at_index(idx + 1)
                if next_row:
                    self.listbox.select_row(next_row)
                    next_row.grab_focus()
                    return True
        elif keyval == Gdk.KEY_Up:
            cur = self.listbox.get_selected_row()
            if cur:
                idx = cur.get_index()
                if idx > 0:
                    prev_row = self.listbox.get_row_at_index(idx - 1)
                    if prev_row:
                        self.listbox.select_row(prev_row)
                        prev_row.grab_focus()
                        return True

        return False

def main():
    win = BluetoothManagerWindow()
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
