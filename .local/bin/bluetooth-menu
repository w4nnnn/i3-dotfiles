#!/usr/bin/env python3
"""
Catppuccin / Multi-Theme Bluetooth Manager Menu
A modern GTK3 Bluetooth Manager floating modal window,
featuring live device scanning, signal strength (RSSI), battery reporting,
device pairing/connecting, and quick terminal access.
"""
import sys
import os
import signal
import subprocess
import shutil
import html
import threading
import time
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Pango", "1.0")
gi.require_version("Gio", "2.0")
from gi.repository import Gtk, Gdk, GLib, Pango, Gio

PID_FILE = "/tmp/bluetooth_menu_gtk.pid"
if os.path.exists(PID_FILE):
    try:
        with open(PID_FILE, "r") as f:
            old_pid = int(f.read().strip())
        os.remove(PID_FILE)
        os.kill(old_pid, signal.SIGTERM)
        sys.exit(0)
    except Exception:
        pass

with open(PID_FILE, "w") as f:
    f.write(str(os.getpid()))

# Load Global Theme Preference
THEME_PREF_FILE = os.path.expanduser("~/.config/control-center-theme")
current_theme_key = "catppuccin"
if os.path.exists(THEME_PREF_FILE):
    try:
        with open(THEME_PREF_FILE) as f:
            t_key = f.read().strip()
            if t_key:
                current_theme_key = t_key
    except Exception:
        pass

