#!/usr/bin/env python3
# ==============================================================================
# Catppuccin Mocha - Network Manager Menu (HyprWiFi RofiView Style)
# Clean Wi-Fi selector with dedicated Action Menu and quick hotkey controls
# ==============================================================================
import os
import sys
import subprocess
import shutil
import re
import html

RASI_THEME = os.path.expanduser("~/.config/rofi/network.rasi")

def run_cmd(cmd, check=False, text=True):
    try:
        return subprocess.check_output(cmd, stderr=subprocess.DEVNULL, text=text).strip()
    except Exception:
        if check:
            raise
        return ""

def notify(title, message, icon="network-wireless", urgency="normal"):
    subprocess.Popen([
        "notify-send",
        "-a", "Network",
        "-i", icon,
        "-u", urgency,
        title,
        message
    ])

def get_network_state():
    """Detect default route, active device, connection name, IP, and Wi-Fi status"""
    default_route = run_cmd(["ip", "route"])
    active_dev = ""
    for line in default_route.splitlines():
        if line.startswith("default"):
            parts = line.split()
            if "dev" in parts:
                active_dev = parts[parts.index("dev") + 1]
                break

    active_ip = ""
    active_type = ""
    active_name = ""
    if active_dev:
        ip_out = run_cmd(["ip", "-4", "addr", "show", active_dev])
        m = re.search(r"inet\s+(\d+\.\d+\.\d+\.\d+)", ip_out)
        if m:
            active_ip = m.group(1)

        dev_info = run_cmd(["nmcli", "-t", "-f", "DEVICE,TYPE,CONNECTION", "dev"])
        for line in dev_info.splitlines():
            parts = line.split(":")
            if len(parts) >= 3 and parts[0] == active_dev:
                active_type = parts[1]
                active_name = parts[2]
                break

    wifi_dev = ""
    dev_types = run_cmd(["nmcli", "-t", "-f", "DEVICE,TYPE", "dev"])
    for line in dev_types.splitlines():
        parts = line.split(":")
        if len(parts) >= 2 and parts[1] == "wifi":
            wifi_dev = parts[0]
            break

    wifi_radio = run_cmd(["nmcli", "radio", "wifi"]) if wifi_dev else ""
    wifi_enabled = (wifi_radio == "enabled")
    conn_state = run_cmd(["nmcli", "-t", "-f", "CONNECTIVITY", "general", "status"])

    return {
        "active_dev": active_dev,
        "active_ip": active_ip,
        "active_type": active_type,
        "active_name": active_name,
        "wifi_dev": wifi_dev,
        "wifi_enabled": wifi_enabled,
        "conn_state": conn_state,
    }

def disconnect_active(state):
    active_name = state["active_name"]
    active_dev = state["active_dev"]
    if not active_name and not active_dev:
        notify("Network", "No active connection to disconnect.", icon="network-offline")
        return
    down_res = subprocess.run(["nmcli", "con", "down", "id", active_name], capture_output=True)
    if down_res.returncode != 0 and active_dev:
        subprocess.run(["nmcli", "dev", "disconnect", active_dev])
    notify("Disconnected", f"Disconnected from {active_name or active_dev}.", icon="network-offline")

def open_captive_portal():
    portal_bin = shutil.which("portal-login") or os.path.expanduser("~/.local/bin/portal-login")
    subprocess.Popen([portal_bin])

def toggle_wifi(state):
    if state["wifi_enabled"]:
        subprocess.run(["nmcli", "radio", "wifi", "off"])
        notify("Wi-Fi Disabled", "Wi-Fi radio turned off.", icon="network-wireless-disconnected")
    else:
        subprocess.run(["nmcli", "radio", "wifi", "on"])
        notify("Wi-Fi Enabled", "Scanning for available networks...", icon="network-wireless")

def rescan_wifi():
    subprocess.run(["nmcli", "dev", "wifi", "rescan"])
    notify("Wi-Fi Rescanned", "Network scan completed.", icon="network-wireless")

def show_actions_menu(state=None):
    """Dedicated Quick Actions menu (opened via right-click or on connected network)"""
    if state is None:
        state = get_network_state()

    active_name = state["active_name"]
    active_ip = state["active_ip"]
    wifi_enabled = state["wifi_enabled"]
    conn_state = state["conn_state"]

    actions = []

    # 1. Disconnect option
    if active_name:
        actions.append({
            "action": "disconnect",
            "display": f'<span foreground="#f38ba8">󰅖</span>  <b>Disconnect          </b>  <span foreground="#6c7086">({html.escape(active_name)})</span>'
        })
        # 2. Captive portal
        actions.append({
            "action": "portal",
            "display": '<span foreground="#89b4fa">󰖟</span>  <b>Captive Portal      </b>  <span weight="bold" foreground="#89b4fa" background="#1e2b44"> BROWSER </span>'
        })

    # 3. Wi-Fi Toggle
    if state["wifi_dev"]:
        if wifi_enabled:
            actions.append({
                "action": "wifi_toggle",
                "display": '<span foreground="#cba6f7">󰤮</span>  <b>Disable Wi-Fi       </b>  <span foreground="#6c7086">[Turn Off Radio]</span>'
            })
            actions.append({
                "action": "rescan",
                "display": '<span foreground="#b4befe">󰑐</span>  <b>Rescan Networks     </b>  <span foreground="#6c7086">[Refresh Scan]</span>'
            })
        else:
            actions.append({
                "action": "wifi_toggle",
                "display": '<span foreground="#a6e3a1">󰤨</span>  <b>Enable Wi-Fi        </b>  <span foreground="#6c7086">[Turn On Radio]</span>'
            })

    # 4. View SSIDs / Return to Wi-Fi list
    actions.append({
        "action": "wifi_list",
        "display": '<span foreground="#fab387"></span>  <b>Available Wi-Fi...  </b>  <span foreground="#6c7086">[View All Networks]</span>'
    })

    # 5. Network settings (nmtui)
    actions.append({
        "action": "nmtui",
        "display": '<span foreground="#89b4fa">󰢻</span>  <b>Network Settings    </b>  <span foreground="#6c7086">[nmtui]</span>'
    })

    # 6. Detailed info popup
    actions.append({
        "action": "info",
        "display": '<span foreground="#a6e3a1">󰌌</span>  <b>Connection Details  </b>  <span foreground="#6c7086">[IP &amp; Stats]</span>'
    })

    if active_name:
        status_info = f'<span foreground="#a6adc8">Active: <b>{html.escape(active_name)}</b> ({active_ip or "No IP"})</span>'
    else:
        status_info = '<span foreground="#f38ba8"><b>Status: Disconnected</b></span>'

    wifi_status_tag = '<span foreground="#a6e3a1"><b>󰐥 Wi-Fi ON</b></span>' if wifi_enabled else '<span foreground="#f38ba8"><b>󰐥 Wi-Fi OFF</b></span>'
    mesg = f"{status_info}   ·   {wifi_status_tag}"

    input_payload = "\n".join([a["display"] for a in actions]) + "\n"

    theme_override = 'entry { placeholder: "Search network action..."; } listview { lines: 6; }'

    rofi_proc = subprocess.Popen([
        "rofi",
        "-no-config",
        "-dmenu",
        "-format", "i",
        "-theme", RASI_THEME,
        "-theme-str", theme_override,
        "-p", "",
        "-mesg", mesg,
        "-markup-rows",
        "-i"
    ], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)

    stdout, _ = rofi_proc.communicate(input=input_payload)
    if rofi_proc.returncode != 0 or not stdout.strip().isdigit():
        sys.exit(0)

    chosen_idx = int(stdout.strip())
    if 0 <= chosen_idx < len(actions):
        act = actions[chosen_idx]["action"]
        if act == "disconnect":
            disconnect_active(state)
        elif act == "portal":
            open_captive_portal()
        elif act == "wifi_toggle":
            toggle_wifi(state)
        elif act == "rescan":
            rescan_wifi()
        elif act == "wifi_list":
            subprocess.Popen([sys.argv[0]])
        elif act == "nmtui":
            subprocess.Popen(["kitty", "--class", "floating_terminal", "-e", "nmtui"])
        elif act == "info":
            info_bin = shutil.which("network-info") or os.path.expanduser("~/.local/bin/network-info")
            subprocess.Popen([info_bin])
    sys.exit(0)

def main():
    # 1. Single instance toggle
    pgrep_out = run_cmd(["pgrep", "-x", "rofi"])
    if pgrep_out:
        subprocess.run(["killall", "-q", "rofi"])
        sys.exit(0)

    # 2. Check NetworkManager
    nm_active = subprocess.run(["systemctl", "is-active", "--quiet", "NetworkManager"]).returncode == 0
    if not nm_active:
        notify("NetworkManager Inactive", "NetworkManager service is not running.", icon="network-error")
        sys.exit(1)

    state = get_network_state()

    # If called with --actions (right-click on Polybar indicator)
    if len(sys.argv) > 1 and sys.argv[1] in ("--actions", "-a"):
        show_actions_menu(state)
        return

    wifi_dev = state["wifi_dev"]
    wifi_enabled = state["wifi_enabled"]
    active_name = state["active_name"]
    conn_state = state["conn_state"]

    # If Wi-Fi is disabled, show quick toggle screen
    if wifi_dev and not wifi_enabled:
        mesg = '<span foreground="#f38ba8"><b>󰐥 Wi-Fi is Disabled</b></span>   ·   <span foreground="#6c7086">Press Enter to Enable</span>'
        items = [
            '<span foreground="#a6e3a1">󰤨</span>  <b>Enable Wi-Fi        </b>  <span foreground="#6c7086">[Turn On Radio]</span>',
            '<span foreground="#89b4fa">󰢻</span>  <b>Network Settings    </b>  <span foreground="#6c7086">[nmtui]</span>'
        ]
        rofi_proc = subprocess.Popen([
            "rofi",
            "-no-config",
            "-dmenu",
            "-format", "i",
            "-theme", RASI_THEME,
            "-theme-str", 'listview { lines: 2; }',
            "-p", "",
            "-mesg", mesg,
            "-markup-rows",
            "-i"
        ], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        stdout, _ = rofi_proc.communicate(input="\n".join(items) + "\n")
        if rofi_proc.returncode == 0 and stdout.strip() == "0":
            toggle_wifi(state)
            os.execv(sys.argv[0], sys.argv)
        sys.exit(0)

    # 3. Format Subheader / mesg right below search input
    # Shows quick controls bar with hotkey hints
    if active_name:
        mesg = (
            f'<span foreground="#f38ba8">󰅖 Alt+D</span> Disconnect   '
            f'<span foreground="#89b4fa">󰖟 Alt+P</span> Portal   '
            f'<span foreground="#a6e3a1">󰐥 Alt+T</span> Wi-Fi ON   '
            f'<span foreground="#b4befe">󰑐 Alt+R</span> Rescan'
        )
    else:
        mesg = (
            f'<span foreground="#6c7086">↑/↓ Navigate · Enter Connect</span>   '
            f'<span foreground="#a6e3a1">󰐥 Alt+T</span> Wi-Fi ON   '
            f'<span foreground="#b4befe">󰑐 Alt+R</span> Rescan   '
            f'<span foreground="#89b4fa">󰢻 Alt+S</span> Settings'
        )

    # 4. Scan & Parse Wi-Fi Networks (100% PURE Wi-Fi list)
    network_items = []

    if wifi_dev and wifi_enabled:
        wifi_output = run_cmd(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY,CHAN", "dev", "wifi", "list", "--rescan", "no"])
        if not wifi_output.strip():
            wifi_output = run_cmd(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY,CHAN", "dev", "wifi", "list"])

        raw_networks = {}
        for line in wifi_output.splitlines():
            if not line:
                continue
            parts = line.split(":")
            if len(parts) < 5:
                continue
            in_use = parts[0].strip() == "*"
            ssid = parts[1].strip()
            if not ssid:
                continue
            sig_int = int(parts[2]) if parts[2].isdigit() else 0
            sec = parts[3].strip()
            chan_int = int(parts[4]) if parts[4].isdigit() else 1

            if ssid not in raw_networks:
                raw_networks[ssid] = {
                    "in_use": in_use,
                    "ssid": ssid,
                    "signal": sig_int,
                    "security": sec,
                    "chan": chan_int,
                }
            else:
                if in_use:
                    raw_networks[ssid]["in_use"] = True
                    raw_networks[ssid]["signal"] = sig_int
                    raw_networks[ssid]["chan"] = chan_int
                elif not raw_networks[ssid]["in_use"] and sig_int > raw_networks[ssid]["signal"]:
                    raw_networks[ssid]["signal"] = sig_int
                    raw_networks[ssid]["chan"] = chan_int

        # Sort: connected first, then signal strength descending
        sorted_nets = sorted(raw_networks.values(), key=lambda x: (not x["in_use"], -x["signal"]))

        for net in sorted_nets:
            is_conn = net["in_use"]
            sig = net["signal"]

            # Icon & Color
            if is_conn:
                icon = '<span foreground="#a6e3a1">󰖩</span>'
            elif sig >= 70:
                icon = '<span foreground="#cba6f7">󰤨</span>'
            elif sig >= 50:
                icon = '<span foreground="#89b4fa">󰤥</span>'
            elif sig >= 25:
                icon = '<span foreground="#a6adc8">󰤢</span>'
            else:
                icon = '<span foreground="#6c7086">󰤟</span>'

            # SSID (max 20 chars, padded)
            ssid_clean = net["ssid"]
            if len(ssid_clean) > 20:
                disp_ssid = ssid_clean[:18] + ".."
            else:
                disp_ssid = ssid_clean
            disp_ssid_padded = f"{disp_ssid:<20}"

            # Connected Badge (11 chars)
            if is_conn:
                badge_markup = '<span weight="bold" foreground="#a6e3a1" background="#233d32"> CONNECTED </span>'
            else:
                badge_markup = "           "

            # Band (4 chars)
            band_str = "5GHz" if net["chan"] > 14 else "2.4G"
            band_markup = f'<span foreground="#7f849c">{band_str}</span>'

            # Security (4 chars)
            is_open = (not net["security"] or net["security"] == "--" or net["security"].lower() == "open")
            if is_open:
                sec_markup = '<span foreground="#a6adc8">OPEN</span>'
            else:
                sec_markup = '<span foreground="#f9e2af">SEC </span>'

            # Signal (4 chars)
            sig_markup = f'<span weight="bold" foreground="#ffffff">{sig:>3}%</span>'

            row_text = f"{icon}  <b>{html.escape(disp_ssid_padded)}</b>  {badge_markup}  {band_markup}  {sec_markup}  {sig_markup}"

            network_items.append({
                "type": "wifi",
                "ssid": net["ssid"],
                "is_conn": is_conn,
                "is_open": is_open,
                "display": row_text
            })

    if not network_items:
        notify("Wi-Fi", "No Wi-Fi networks found in range.", icon="network-wireless-disconnected")
        sys.exit(0)

    input_payload = "\n".join([item["display"] for item in network_items]) + "\n"

    # 5. Launch Rofi with hotkey bindings
    rofi_proc = subprocess.Popen([
        "rofi",
        "-no-config",
        "-dmenu",
        "-format", "i",
        "-theme", RASI_THEME,
        "-p", "",
        "-mesg", mesg,
        "-markup-rows",
        "-i",
        "-kb-custom-1", "Alt+d",
        "-kb-custom-2", "Alt+p",
        "-kb-custom-3", "Alt+t",
        "-kb-custom-4", "Alt+r",
        "-kb-custom-5", "Alt+s"
    ], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)

    stdout, _ = rofi_proc.communicate(input=input_payload)
    ret = rofi_proc.returncode

    # Handle Hotkeys directly
    if ret == 10:  # Alt+d
        disconnect_active(state)
        sys.exit(0)
    elif ret == 11:  # Alt+p
        open_captive_portal()
        sys.exit(0)
    elif ret == 12:  # Alt+t
        toggle_wifi(state)
        sys.exit(0)
    elif ret == 13:  # Alt+r
        rescan_wifi()
        os.execv(sys.argv[0], sys.argv)
    elif ret == 14:  # Alt+s
        subprocess.Popen(["kitty", "--class", "floating_terminal", "-e", "nmtui"])
        sys.exit(0)

    if ret != 0 or not stdout.strip().isdigit():
        sys.exit(0)

    chosen_idx = int(stdout.strip())
    if chosen_idx < 0 or chosen_idx >= len(network_items):
        sys.exit(0)

    chosen = network_items[chosen_idx]
    target_ssid = chosen["ssid"]

    # 6. If selecting the already connected network, open Actions Menu for it
    if chosen["is_conn"]:
        show_actions_menu(state)
        return

    # 7. Connect to selected network
    saved_cons = run_cmd(["nmcli", "-t", "-f", "NAME", "c", "show"]).splitlines()
    if target_ssid in saved_cons:
        notify("Connecting...", f"Connecting to saved network: {target_ssid}", icon="network-wireless")
        res = subprocess.run(["nmcli", "con", "up", "id", target_ssid], capture_output=True)
        if res.returncode == 0:
            notify("Connected", f"Successfully connected to {target_ssid}.", icon="network-wireless")
            open_captive_portal()
        else:
            notify("Connection Failed", f"Failed to connect to {target_ssid}.", icon="network-error")
        sys.exit(0)

    if chosen["is_open"]:
        notify("Connecting...", f"Connecting to open network: {target_ssid}", icon="network-wireless")
        res = subprocess.run(["nmcli", "dev", "wifi", "connect", target_ssid], capture_output=True)
        if res.returncode == 0:
            notify("Connected", f"Successfully connected to {target_ssid}.", icon="network-wireless")
            open_captive_portal()
        else:
            notify("Connection Failed", f"Failed to connect to {target_ssid}.", icon="network-error")
        sys.exit(0)

    # Prompt password
    pass_proc = subprocess.Popen([
        "rofi",
        "-no-config",
        "-dmenu",
        "-password",
        "-theme", RASI_THEME,
        "-theme-str", 'listview { lines: 0; padding: 0; } window { width: 480px; } entry { placeholder: "Password..."; }',
        "-p", "󰌾",
        "-mesg", f"Enter Wi-Fi password for {html.escape(target_ssid)}"
    ], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)

    pwd, _ = pass_proc.communicate()
    pwd = pwd.strip()
    if not pwd:
        sys.exit(0)

    notify("Connecting...", f"Connecting to {target_ssid}...", icon="network-wireless")
    res = subprocess.run(["nmcli", "dev", "wifi", "connect", target_ssid, "password", pwd], capture_output=True)
    if res.returncode == 0:
        notify("Connected", f"Successfully connected to {target_ssid}.", icon="network-wireless")
        open_captive_portal()
    else:
        notify("Connection Failed", f"Could not connect to {target_ssid}. Check password.", icon="network-error")

if __name__ == "__main__":
    main()
