    def _build_ui(self):
        # Main Card Box (660px width matching Rofi network.rasi)
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        main_box.set_name("main-card")
        main_box.set_size_request(660, 480)
        self.add(main_box)

        # Stack to smoothly transition between Network List and Password Prompt
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(150)

        # ======================================================================
        # VIEW 1: Networks List View
        # ======================================================================
        self.networks_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)

        # 1. Input Bar (Pill search box with prompt icon)
        inputbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        inputbar.set_name("inputbar")

        prompt_icon = Gtk.Label(label="")
        prompt_icon.set_name("prompt-icon")
        inputbar.pack_start(prompt_icon, False, False, 0)

        self.search_entry = Gtk.Entry()
        self.search_entry.set_name("search-entry")
        self.search_entry.set_placeholder_text("Filter Wi-Fi networks...")
        self.search_entry.connect("changed", self.on_search_changed)
        inputbar.pack_start(self.search_entry, True, True, 0)

        self.networks_box.pack_start(inputbar, False, False, 0)

        # 2. Listview (Pure SSID list ONLY)
        self.scrolled = Gtk.ScrolledWindow()
        self.scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.listbox = Gtk.ListBox()
        self.listbox.set_name("listbox")
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.listbox.connect("row-activated", self.on_row_activated)
        self.scrolled.add(self.listbox)
        self.networks_box.pack_start(self.scrolled, True, True, 0)

        # 3. Action Footer Toolbar (REAL Interactive GTK Buttons)
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        footer.set_name("footer-bar")

        # Portal Button
        self.portal_btn = Gtk.Button(label="󰖟 Portal")
        self.portal_btn.get_style_context().add_class("footer-action-btn")
        self.portal_btn.get_style_context().add_class("portal")
        self.portal_btn.set_tooltip_text("Open Captive Portal Login")
        self.portal_btn.connect("clicked", lambda w: (self.close_and_exit(), self.action_portal()))
        footer.pack_start(self.portal_btn, True, True, 0)

        # Disconnect Button
        self.disconn_btn = Gtk.Button(label="󰅖 Disconnect")
        self.disconn_btn.get_style_context().add_class("footer-action-btn")
        self.disconn_btn.get_style_context().add_class("danger")
        self.disconn_btn.set_tooltip_text("Disconnect Active Network")
        self.disconn_btn.connect("clicked", lambda w: self.action_disconnect())
        footer.pack_start(self.disconn_btn, True, True, 0)

        # Rescan Button
        self.rescan_btn = Gtk.Button(label="󰑐 Rescan")
        self.rescan_btn.get_style_context().add_class("footer-action-btn")
        self.rescan_btn.get_style_context().add_class("rescan")
        self.rescan_btn.set_tooltip_text("Scan Available Networks")
        self.rescan_btn.connect("clicked", lambda w: self.refresh_state(rescan=True))
        footer.pack_start(self.rescan_btn, True, True, 0)

        # Settings Button
        self.settings_btn = Gtk.Button(label="󰢻 Settings")
        self.settings_btn.get_style_context().add_class("footer-action-btn")
        self.settings_btn.get_style_context().add_class("settings")
        self.settings_btn.set_tooltip_text("Open Network Settings")
        self.settings_btn.connect("clicked", lambda w: (self.close_and_exit(), subprocess.Popen(["kitty", "--class", "floating_terminal", "-e", "nmtui"])))
        footer.pack_start(self.settings_btn, True, True, 0)

        # Radio Toggle Button (Wifi Off / Wifi On)
        self.radio_btn = Gtk.Button(label="󰤮 Wifi Off")
        self.radio_btn.get_style_context().add_class("footer-action-btn")
        self.radio_btn.get_style_context().add_class("radio")
        self.radio_btn.set_tooltip_text("Turn Wi-Fi Off")
        self.radio_btn.connect("clicked", lambda w: self.action_toggle_radio())
        footer.pack_start(self.radio_btn, True, True, 0)

        self.networks_box.pack_start(footer, False, False, 0)
        self.stack.add_named(self.networks_box, "networks")

        # ======================================================================
        # VIEW 2: Elegant Password Prompt Modal View
        # ======================================================================
        self.pwd_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.pwd_box.set_valign(Gtk.Align.CENTER)
        self.pwd_box.set_halign(Gtk.Align.CENTER)
        self.pwd_box.set_size_request(440, -1)

        # Lock Icon
        pwd_icon = Gtk.Label(label="󰌾")
        pwd_icon.set_name("pwd-icon")
        self.pwd_box.pack_start(pwd_icon, False, False, 0)

        # Title & Subtitle
        self.pwd_title_lbl = Gtk.Label(label="Connect to Wi-Fi")
        self.pwd_title_lbl.set_name("pwd-title")
        self.pwd_title_lbl.set_use_markup(True)
        self.pwd_box.pack_start(self.pwd_title_lbl, False, False, 0)

        self.pwd_sub_lbl = Gtk.Label(label="Enter security key to join this network")
        self.pwd_sub_lbl.set_name("pwd-subtitle")
        self.pwd_box.pack_start(self.pwd_sub_lbl, False, False, 0)

        # Password Entry Pill Box
        pwd_entry_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        pwd_entry_box.set_name("pwd-entry-container")

        self.pwd_entry = Gtk.Entry()
        self.pwd_entry.set_name("pwd-entry")
        self.pwd_entry.set_visibility(False)
        self.pwd_entry.set_placeholder_text("Password...")
        self.pwd_entry.connect("activate", lambda e: self.do_connect_with_password())
        pwd_entry_box.pack_start(self.pwd_entry, True, True, 0)

        self.pwd_eye_btn = Gtk.Button(label="󰈈")
        self.pwd_eye_btn.get_style_context().add_class("pwd-eye-btn")
        self.pwd_eye_btn.set_tooltip_text("Show Password")
        self.pwd_eye_btn.connect("clicked", self.toggle_pwd_visibility)
        pwd_entry_box.pack_start(self.pwd_eye_btn, False, False, 0)

        self.pwd_box.pack_start(pwd_entry_box, False, False, 0)

        # Error / Status Feedback Label
        self.pwd_error_lbl = Gtk.Label(label="")
        self.pwd_error_lbl.set_name("pwd-error")
        self.pwd_box.pack_start(self.pwd_error_lbl, False, False, 0)

        # Actions: Cancel & Connect Buttons
        pwd_btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        pwd_btn_box.set_halign(Gtk.Align.CENTER)
        pwd_btn_box.set_margin_top(10)

        self.pwd_cancel_btn = Gtk.Button(label="Cancel")
        self.pwd_cancel_btn.get_style_context().add_class("pwd-btn")
        self.pwd_cancel_btn.get_style_context().add_class("cancel")
        self.pwd_cancel_btn.connect("clicked", lambda w: self.cancel_pwd_prompt())
        pwd_btn_box.pack_start(self.pwd_cancel_btn, False, False, 0)

        self.pwd_connect_btn = Gtk.Button(label="󰖩 Connect")
        self.pwd_connect_btn.get_style_context().add_class("pwd-btn")
        self.pwd_connect_btn.get_style_context().add_class("connect")
        self.pwd_connect_btn.connect("clicked", lambda w: self.do_connect_with_password())
        pwd_btn_box.pack_start(self.pwd_connect_btn, False, False, 0)

        self.pwd_box.pack_start(pwd_btn_box, False, False, 0)

        self.stack.add_named(self.pwd_box, "password")

        main_box.pack_start(self.stack, True, True, 0)

    def position_window(self):
        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor() or display.get_monitor_at_point(0, 0)
        geom = monitor.get_geometry()

        win_w, win_h = 660, 480
        # Position centered on screen matching Rofi
        x = geom.x + (geom.width - win_w) // 2
        y = geom.y + (geom.height - win_h) // 2
        self.move(x, y)

    def refresh_state(self, rescan=False):
        if self.is_scanning:
            return
        self.is_scanning = True
        self.rescan_btn.set_label("󰑐 Scanning...")

        def worker():
            devs = run_cmd(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "dev"]).splitlines()
            wifi_dev = ""
            active_ssid = ""
            active_ip = ""

            for line in devs:
                parts = line.split(":")
                if len(parts) >= 2 and parts[1] == "wifi":
                    wifi_dev = parts[0]
                    if len(parts) >= 4 and parts[2] == "connected":
                        active_ssid = parts[3]
                    break

            radio_state = run_cmd(["nmcli", "radio", "wifi"]) == "enabled"

            if active_ssid:
                ip_out = run_cmd(["ip", "-4", "addr", "show", wifi_dev])
                m = re.search(r"inet\s+(\d+\.\d+\.\d+\.\d+)", ip_out)
                if m:
                    active_ip = m.group(1)

            nets = []
            if radio_state and wifi_dev:
                if rescan:
                    run_cmd(["nmcli", "dev", "wifi", "rescan"])
                raw_out = run_cmd(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY,CHAN", "dev", "wifi", "list", "--rescan", "no"])
                if not raw_out.strip():
                    raw_out = run_cmd(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY,CHAN", "dev", "wifi", "list"])

                raw_nets = {}
                for line in raw_out.splitlines():
                    if not line:
                        continue
                    p = line.split(":")
                    if len(p) < 5:
                        continue
                    in_use = p[0].strip() == "*"
                    ssid = p[1].strip()
                    if not ssid:
                        continue
                    sig_int = int(p[2]) if p[2].isdigit() else 0
                    sec = p[3].strip()
                    chan_int = int(p[4]) if p[4].isdigit() else 1

                    if ssid not in raw_nets or in_use or sig_int > raw_nets[ssid]["signal"]:
                        raw_nets[ssid] = {
                            "in_use": in_use,
                            "ssid": ssid,
                            "signal": sig_int,
                            "security": sec,
                            "chan": chan_int,
                        }

                nets = sorted(raw_nets.values(), key=lambda x: (not x["in_use"], -x["signal"]))

            GLib.idle_add(self.update_ui_state, wifi_dev, radio_state, active_ssid, active_ip, nets)

        threading.Thread(target=worker, daemon=True).start()

    def update_ui_state(self, wifi_dev, radio_state, active_ssid, active_ip, nets):
        self.wifi_dev = wifi_dev
        self.wifi_enabled = radio_state
        self.active_ssid = active_ssid
        self.active_ip = active_ip
        self.all_networks = nets
        self.is_scanning = False
        self.rescan_btn.set_label("󰑐 Rescan")

        if self.wifi_enabled:
            self.radio_btn.set_label("󰤮 Wifi Off")
            self.radio_btn.set_tooltip_text("Turn Wi-Fi Off")
        else:
            self.radio_btn.set_label("󰤨 Wifi On")
            self.radio_btn.set_tooltip_text("Turn Wi-Fi On")

        if self.active_ssid:
            self.disconn_btn.set_sensitive(True)
            if self.active_ip:
                self.disconn_btn.set_tooltip_text(f"Disconnect from {self.active_ssid} ({self.active_ip})")
            else:
                self.disconn_btn.set_tooltip_text(f"Disconnect from {self.active_ssid}")
        else:
            self.disconn_btn.set_sensitive(False)
            self.disconn_btn.set_tooltip_text("No active Wi-Fi connection")

        self.render_network_list(self.all_networks)

    def render_network_list(self, nets):
        for child in self.listbox.get_children():
            self.listbox.remove(child)

        query = self.search_entry.get_text().strip().lower()
        if query:
            filtered = [n for n in nets if query in n["ssid"].lower()]
        else:
            filtered = nets

        if not filtered:
            row = Gtk.ListBoxRow()
            lbl = Gtk.Label(label="No Wi-Fi networks found in range" if self.wifi_enabled else "Wi-Fi is Disabled · Turn Wi-Fi On below")
            lbl.get_style_context().add_class("element-text")
            lbl.set_padding(18, 18)
            row.add(lbl)
            self.listbox.add(row)
            self.listbox.show_all()
            return

        for idx, net in enumerate(filtered):
            row = Gtk.ListBoxRow()
            row.net_data = net
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            box.get_style_context().add_class("element-row")
            if net["in_use"]:
                box.get_style_context().add_class("connected")

            # Signal Icon
            sig = net["signal"]
            if net["in_use"]:
                s_icon = "󰖩"
            elif sig >= 70:
                s_icon = "󰤨"
            elif sig >= 50:
                s_icon = "󰤥"
            elif sig >= 25:
                s_icon = "󰤢"
            else:
                s_icon = "󰤟"

            icon_lbl = Gtk.Label(label=s_icon)
            icon_lbl.get_style_context().add_class("element-text")
            box.pack_start(icon_lbl, False, False, 0)

            # SSID
            ssid_lbl = Gtk.Label(label=f"<b>{html.escape(net['ssid'])}</b>", xalign=0)
            ssid_lbl.set_use_markup(True)
            ssid_lbl.get_style_context().add_class("element-text")
            ssid_lbl.set_ellipsize(Pango.EllipsizeMode.END)
            ssid_lbl.set_max_width_chars(28)
            box.pack_start(ssid_lbl, True, True, 0)

            # Badges
            if net["in_use"]:
                badge = Gtk.Label(label="CONNECTED")
                badge.get_style_context().add_class("badge-connected")
                box.pack_start(badge, False, False, 0)

            band_txt = "5GHz" if net["chan"] > 14 else "2.4G"
            band_lbl = Gtk.Label(label=band_txt)
            band_lbl.get_style_context().add_class("badge-band")
            box.pack_start(band_lbl, False, False, 0)

            is_open = not net["security"] or net["security"] == "--"
            sec_txt = "OPEN" if is_open else "SEC"
            sec_lbl = Gtk.Label(label=sec_txt)
            sec_lbl.get_style_context().add_class("badge-sec")
            if is_open:
                sec_lbl.get_style_context().add_class("open")
            box.pack_start(sec_lbl, False, False, 0)

            sig_lbl = Gtk.Label(label=f"{sig:>3}%")
            sig_lbl.get_style_context().add_class("badge-sig")
            box.pack_start(sig_lbl, False, False, 0)

            row.add(box)
            self.listbox.add(row)

        self.listbox.show_all()
        # Select first row by default for keyboard arrow navigation
        first_row = self.listbox.get_row_at_index(0)
        if first_row:
            self.listbox.select_row(first_row)

    def on_search_changed(self, entry):
        self.render_network_list(self.all_networks)

    def on_row_activated(self, listbox, row):
        if not hasattr(row, "net_data"):
            return
        net = row.net_data
        target = net["ssid"]
        if net["in_use"]:
            notify("Wi-Fi", f"Already connected to {target}.")
            return

        saved = run_cmd(["nmcli", "-t", "-f", "NAME", "c", "show"]).splitlines()
        is_open = not net["security"] or net["security"] == "--"

        if target in saved:
            notify("Connecting...", f"Connecting to saved network: {target}...")
            res = subprocess.run(["nmcli", "con", "up", "id", target], capture_output=True)
            if res.returncode == 0:
                notify("Connected", f"Successfully connected to {target}.")
            else:
                notify("Failed", f"Could not connect to {target}.")
            self.refresh_state()
        elif is_open:
            notify("Connecting...", f"Connecting to open network: {target}...")
            res = subprocess.run(["nmcli", "dev", "wifi", "connect", target], capture_output=True)
            if res.returncode == 0:
                notify("Connected", f"Successfully connected to {target}.")
                subprocess.Popen([os.path.expanduser("~/.local/bin/portal-login"), "--auto"])
            else:
                notify("Failed", f"Could not connect to {target}.")
            self.refresh_state()
        else:
            self.prompt_password(target)

    def prompt_password(self, target_ssid):
        self.current_target_ssid = target_ssid
        self.pwd_title_lbl.set_markup(f"Connect to <b>{html.escape(target_ssid)}</b>")
        self.pwd_sub_lbl.set_text("Enter security key to join this network")
        self.pwd_entry.set_text("")
        self.pwd_entry.set_visibility(False)
        self.pwd_eye_btn.set_label("󰈈")
        self.pwd_error_lbl.set_text("")
        self.pwd_connect_btn.set_sensitive(True)
        self.pwd_cancel_btn.set_sensitive(True)
        self.pwd_connect_btn.set_label("󰖩 Connect")
        self.stack.set_visible_child_name("password")
        GLib.idle_add(self.pwd_entry.grab_focus)

    def cancel_pwd_prompt(self):
        self.current_target_ssid = ""
        self.pwd_error_lbl.set_text("")
        self.stack.set_visible_child_name("networks")
        GLib.idle_add(self.search_entry.grab_focus)

    def toggle_pwd_visibility(self, btn):
        is_vis = self.pwd_entry.get_visibility()
        self.pwd_entry.set_visibility(not is_vis)
        if not is_vis:
            self.pwd_eye_btn.set_label("󰈉")
            self.pwd_eye_btn.set_tooltip_text("Hide Password")
        else:
            self.pwd_eye_btn.set_label("󰈈")
            self.pwd_eye_btn.set_tooltip_text("Show Password")

    def do_connect_with_password(self):
        pwd = self.pwd_entry.get_text().strip()
        if not pwd:
            self.pwd_error_lbl.set_text("Please enter a password.")
            self.pwd_entry.grab_focus()
            return

        self.pwd_error_lbl.set_text("")
        self.pwd_connect_btn.set_sensitive(False)
        self.pwd_cancel_btn.set_sensitive(False)
        self.pwd_connect_btn.set_label("󰑐 Connecting...")

        target = self.current_target_ssid

        def worker():
            cmd = ["nmcli", "dev", "wifi", "connect", target, "password", pwd]
            res = subprocess.run(cmd, capture_output=True, text=True)
            GLib.idle_add(self.on_pwd_connect_finish, target, res.returncode == 0, res.stderr or res.stdout)

        threading.Thread(target=worker, daemon=True).start()

    def on_pwd_connect_finish(self, target, success, msg):
        self.pwd_connect_btn.set_sensitive(True)
        self.pwd_cancel_btn.set_sensitive(True)
        self.pwd_connect_btn.set_label("󰖩 Connect")

        if success:
            notify("Connected", f"Successfully connected to {target}.")
            self.stack.set_visible_child_name("networks")
            self.refresh_state()
        else:
            err_msg = "Connection failed. Please check password."
            if "Secrets were required" in msg or "bad-passphrase" in msg or "password" in msg.lower():
                err_msg = "Incorrect Wi-Fi password. Please try again."
            self.pwd_error_lbl.set_text(f"󰅖 {err_msg}")
            self.pwd_entry.grab_focus()
            self.pwd_entry.select_region(0, -1)

    def action_portal(self):
        portal_bin = shutil.which("portal-login") or os.path.expanduser("~/.local/bin/portal-login")
        subprocess.Popen([portal_bin])

    def action_disconnect(self):
        if self.active_ssid:
            subprocess.run(["nmcli", "con", "down", "id", self.active_ssid])
            notify("Disconnected", f"Disconnected from {self.active_ssid}.")
            self.refresh_state()

    def action_toggle_radio(self):
        if self.wifi_enabled:
            subprocess.run(["nmcli", "radio", "wifi", "off"])
            notify("Wi-Fi Disabled", "Wi-Fi radio turned off.")
        else:
            subprocess.run(["nmcli", "radio", "wifi", "on"])
            notify("Wi-Fi Enabled", "Scanning for networks...")
        self.refresh_state(rescan=True)

    def on_key_press(self, widget, event):
        keyval = event.keyval
        state = event.state

        # Handle Escape
        if keyval == Gdk.KEY_Escape:
            if self.stack.get_visible_child_name() == "password":
                self.cancel_pwd_prompt()
                return True
            self.close_and_exit()
            return True

        # Handle Password view keys
        if self.stack.get_visible_child_name() == "password":
            if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
                self.do_connect_with_password()
                return True
            return False

        # Alt + Hotkeys in Networks list
        if state & Gdk.ModifierType.MOD1_MASK:
            if keyval in (Gdk.KEY_p, Gdk.KEY_P):
                self.close_and_exit()
                self.action_portal()
                return True
            elif keyval in (Gdk.KEY_d, Gdk.KEY_D):
                self.action_disconnect()
                return True
            elif keyval in (Gdk.KEY_r, Gdk.KEY_R):
                self.refresh_state(rescan=True)
                return True
            elif keyval in (Gdk.KEY_s, Gdk.KEY_S):
                self.close_and_exit()
                subprocess.Popen(["kitty", "--class", "floating_terminal", "-e", "nmtui"])
                return True
            elif keyval in (Gdk.KEY_t, Gdk.KEY_T):
                self.action_toggle_radio()
                return True

        # Arrow Up / Down navigation when focused on search entry
        if keyval == Gdk.KEY_Down:
            cur = self.listbox.get_selected_row()
            if cur:
                idx = cur.get_index()
                next_row = self.listbox.get_row_at_index(idx + 1)
                if next_row:
                    self.listbox.select_row(next_row)
                    next_row.grab_focus()
                    return True
        elif keyval == Gdk.KEY_Up:
            cur = self.listbox.get_selected_row()
            if cur:
                idx = cur.get_index()
                if idx > 0:
                    prev_row = self.listbox.get_row_at_index(idx - 1)
                    if prev_row:
                        self.listbox.select_row(prev_row)
                        prev_row.grab_focus()
                        return True

        return False

def main():
    win = RofiStyleNetworkWindow()
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
