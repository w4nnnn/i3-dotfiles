t = THEMES.get(current_theme_key, THEMES["catppuccin"])

def run_cmd(cmd):
    try:
        return subprocess.check_output(cmd, stderr=subprocess.DEVNULL, text=True).strip()
    except Exception:
        return ""

def notify(title, message, icon="network-wireless"):
    subprocess.Popen([
        "dunstify", "-a", "Network",
        "-h", "string:x-dunst-stack-tag:network",
        "-i", icon,
        "-t", "2000",
        title, message
    ], stderr=subprocess.DEVNULL)

class NetworkMenuWindow(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("CatppuccinNetworkMenu")
        self.set_role("network-menu-popup")
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_resizable(False)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)

        self.apply_css()

        self.all_networks = []
        self.active_ssid = ""
        self.wifi_enabled = True
        self.wifi_dev = ""
        self.is_scanning = False

        self._build_ui()
        self.position_window()

        # Connect events
        self.connect("key-press-event", self.on_key_press)
        self.connect("focus-out-event", lambda w, e: self.close_and_exit())
        self.connect("destroy", lambda w: self.cleanup())

        # Initial data load
        self.refresh_state(rescan=True)

    def close_and_exit(self):
        self.cleanup()
        self.destroy()
        sys.exit(0)

    def cleanup(self):
        if os.path.exists(PID_FILE):
            try:
                os.remove(PID_FILE)
            except Exception:
                pass

