#!/usr/bin/env python3
# ==============================================================================
# Catppuccin Mocha - Network Manager Menu (HyprWiFi RofiView Style)
# Inspired by RofiView.tsx design
# ==============================================================================
import os
import sys
import subprocess
import shutil
import re

RASI_THEME = os.path.expanduser("~/.config/rofi/network.rasi")

def run_cmd(cmd, check=False, text=True):
    try:
        return subprocess.check_output(cmd, stderr=subprocess.DEVNULL, text=text).strip()
    except Exception:
        if check:
            raise
        return ""

def notify(title, message, icon="network-wireless", urgency="normal"):
    subprocess.Popen([
        "notify-send",
        "-a", "Network",
        "-i", icon,
        "-u", urgency,
        title,
        message
    ])

def main():
    # 1. Toggle behavior: close rofi if already open
    pgrep_out = run_cmd(["pgrep", "-x", "rofi"])
    if pgrep_out:
        subprocess.run(["killall", "-q", "rofi"])
        sys.exit(0)

    # 2. Check NetworkManager
    nm_active = subprocess.run(["systemctl", "is-active", "--quiet", "NetworkManager"]).returncode == 0
    if not nm_active:
        notify("NetworkManager Inactive", "NetworkManager service is not running.", icon="network-error")
        sys.exit(1)

    # 3. Detect active connection & IP
    default_route = run_cmd(["ip", "route"])
    active_dev = ""
    for line in default_route.splitlines():
        if line.startswith("default"):
            parts = line.split()
            if "dev" in parts:
                active_dev = parts[parts.index("dev") + 1]
                break

    active_ip = ""
    active_type = ""
    active_name = ""
    if active_dev:
        ip_out = run_cmd(["ip", "-4", "addr", "show", active_dev])
        m = re.search(r"inet\s+(\d+\.\d+\.\d+\.\d+)", ip_out)
        if m:
            active_ip = m.group(1)
        
        dev_info = run_cmd(["nmcli", "-t", "-f", "DEVICE,TYPE,CONNECTION", "dev"])
        for line in dev_info.splitlines():
            parts = line.split(":")
            if len(parts) >= 3 and parts[0] == active_dev:
                active_type = parts[1]
                active_name = parts[2]
                break

    # 4. Detect Wi-Fi device & radio status
    wifi_dev = ""
    dev_types = run_cmd(["nmcli", "-t", "-f", "DEVICE,TYPE", "dev"])
    for line in dev_types.splitlines():
        parts = line.split(":")
        if len(parts) >= 2 and parts[1] == "wifi":
            wifi_dev = parts[0]
            break

    wifi_radio = run_cmd(["nmcli", "radio", "wifi"]) if wifi_dev else ""
    wifi_enabled = (wifi_radio == "enabled")

    # 5. Connectivity & Captive Portal Check
    conn_state = run_cmd(["nmcli", "-t", "-f", "CONNECTIVITY", "general", "status"])

    # 6. Format Subheader / mesg (matches RofiView.tsx quick controls bar)
    # Left: navigation hints. Right: Wi-Fi status button
    nav_hints = '<span foreground="#6c7086">↑/↓ Navigate   Enter: Connect   Esc: Close</span>'
    if conn_state == "portal":
        status_btn = '<span foreground="#f9e2af"><b>󰖟 Captive Portal Required</b></span>'
    elif wifi_enabled:
        status_btn = '<span foreground="#a6e3a1"><b>󰐥 Wi-Fi ON</b></span>'
    else:
        status_btn = '<span foreground="#f38ba8"><b>󰐥 Wi-Fi OFF</b></span>'

    mesg = f"{nav_hints}{' ' * 14}{status_btn}"

    # 7. Scan & Parse Wi-Fi Networks
    network_items = []
    actions = []

    if wifi_dev and wifi_enabled:
        # Fast query without hardware rescan
        wifi_output = run_cmd(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY,CHAN", "dev", "wifi", "list", "--rescan", "no"])
        if not wifi_output.strip():
            wifi_output = run_cmd(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY,CHAN", "dev", "wifi", "list"])

        raw_networks = {}
        for line in wifi_output.splitlines():
            if not line:
                continue
            parts = line.split(":")
            if len(parts) < 5:
                continue
            in_use = parts[0].strip() == "*"
            ssid = parts[1].strip()
            if not ssid:
                continue
            sig_int = int(parts[2]) if parts[2].isdigit() else 0
            sec = parts[3].strip()
            chan_int = int(parts[4]) if parts[4].isdigit() else 1

            if ssid not in raw_networks:
                raw_networks[ssid] = {
                    "in_use": in_use,
                    "ssid": ssid,
                    "signal": sig_int,
                    "security": sec,
                    "chan": chan_int,
                }
            else:
                if in_use:
                    raw_networks[ssid]["in_use"] = True
                    raw_networks[ssid]["signal"] = sig_int
                    raw_networks[ssid]["chan"] = chan_int
                elif not raw_networks[ssid]["in_use"] and sig_int > raw_networks[ssid]["signal"]:
                    raw_networks[ssid]["signal"] = sig_int
                    raw_networks[ssid]["chan"] = chan_int

        # Sort: connected network first, then signal strength descending
        sorted_nets = sorted(raw_networks.values(), key=lambda x: (not x["in_use"], -x["signal"]))

        for net in sorted_nets:
            is_conn = net["in_use"]
            sig = net["signal"]

            # Icon & Color
            if is_conn:
                icon = '<span foreground="#a6e3a1">󰖩</span>'
            elif sig >= 70:
                icon = '<span foreground="#cba6f7">󰤨</span>'
            elif sig >= 50:
                icon = '<span foreground="#89b4fa">󰤥</span>'
            elif sig >= 25:
                icon = '<span foreground="#a6adc8">󰤢</span>'
            else:
                icon = '<span foreground="#6c7086">󰤟</span>'

            # SSID (max 20 chars, padded to 20)
            if len(net["ssid"]) > 20:
                disp_ssid = net["ssid"][:18] + ".."
            else:
                disp_ssid = net["ssid"]
            disp_ssid_padded = f"{disp_ssid:<20}"

            # Connected Badge (11 chars)
            if is_conn:
                badge_markup = '<span weight="bold" foreground="#a6e3a1" background="#233d32"> CONNECTED </span>'
            else:
                badge_markup = "           "

            # Band (4 chars)
            band_str = "5GHz" if net["chan"] > 14 else "2.4G"
            band_markup = f'<span foreground="#7f849c">{band_str}</span>'

            # Security (4 chars)
            is_open = (not net["security"] or net["security"] == "--" or net["security"].lower() == "open")
            if is_open:
                sec_markup = '<span foreground="#a6adc8">OPEN</span>'
            else:
                sec_markup = '<span foreground="#f9e2af">SEC </span>'

            # Signal (4 chars)
            sig_markup = f'<span weight="bold" foreground="#ffffff">{sig:>3}%</span>'

            row_text = f"{icon}  <b>{disp_ssid_padded}</b>  {badge_markup}  {band_markup}  {sec_markup}  {sig_markup}"

            network_items.append({
                "type": "wifi",
                "ssid": net["ssid"],
                "is_conn": is_conn,
                "is_open": is_open,
                "display": row_text
            })

    # 8. Build Action Rows
    if active_dev and active_name:
        actions.append({
            "type": "disconnect",
            "name": active_name,
            "dev": active_dev,
            "display": f'<span foreground="#f38ba8">󰅖</span>  <b>Disconnect          </b>  <span foreground="#6c7086">({active_name})</span>'
        })
        actions.append({
            "type": "portal",
            "display": '<span foreground="#89b4fa">󰖟</span>  <b>Captive Portal      </b>  <span weight="bold" foreground="#89b4fa" background="#1e2b44"> BROWSER </span>'
        })

    if wifi_dev:
        if wifi_enabled:
            actions.append({
                "type": "wifi_off",
                "display": '<span foreground="#cba6f7">󰤮</span>  <b>Disable Wi-Fi       </b>  <span foreground="#6c7086">[Turn Off Radio]</span>'
            })
            actions.append({
                "type": "rescan",
                "display": '<span foreground="#b4befe">󰑐</span>  <b>Rescan Networks     </b>  <span foreground="#6c7086">[Refresh List]</span>'
            })
        else:
            actions.append({
                "type": "wifi_on",
                "display": '<span foreground="#a6e3a1">󰤨</span>  <b>Enable Wi-Fi        </b>  <span foreground="#6c7086">[Turn On Radio]</span>'
            })

    actions.append({
        "type": "nmtui",
        "display": '<span foreground="#89b4fa">󰢻</span>  <b>Network Settings    </b>  <span foreground="#6c7086">[nmtui]</span>'
    })

    # Combine all items
    all_entries = network_items + actions
    if not all_entries:
        notify("Network", "No network interfaces or Wi-Fi devices found.", icon="network-offline")
        sys.exit(0)

    input_payload = "\n".join([item["display"] for item in all_entries]) + "\n"

    # 9. Launch Rofi
    rofi_proc = subprocess.Popen([
        "rofi",
        "-no-config",
        "-dmenu",
        "-format", "i",
        "-theme", RASI_THEME,
        "-p", "󰖩",
        "-mesg", mesg,
        "-markup-rows",
        "-i"
    ], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)

    stdout, _ = rofi_proc.communicate(input=input_payload)
    if rofi_proc.returncode != 0 or not stdout.strip().isdigit():
        sys.exit(0)

    chosen_idx = int(stdout.strip())
    if chosen_idx < 0 or chosen_idx >= len(all_entries):
        sys.exit(0)

    chosen = all_entries[chosen_idx]
    c_type = chosen["type"]

    # 10. Execute Chosen Action
    if c_type == "disconnect":
        target_name = chosen["name"]
        target_dev = chosen["dev"]
        down_res = subprocess.run(["nmcli", "con", "down", "id", target_name], capture_output=True)
        if down_res.returncode != 0:
            subprocess.run(["nmcli", "dev", "disconnect", target_dev])
        notify("Disconnected", f"Disconnected from {target_name}.", icon="network-offline")
        sys.exit(0)

    elif c_type == "portal":
        portal_bin = shutil.which("portal-login") or os.path.expanduser("~/.local/bin/portal-login")
        subprocess.Popen([portal_bin])
        sys.exit(0)

    elif c_type == "wifi_off":
        subprocess.run(["nmcli", "radio", "wifi", "off"])
        notify("Wi-Fi Disabled", "Wi-Fi radio turned off.", icon="network-wireless-disconnected")
        sys.exit(0)

    elif c_type == "wifi_on":
        subprocess.run(["nmcli", "radio", "wifi", "on"])
        notify("Wi-Fi Enabled", "Scanning for available networks...", icon="network-wireless")
        os.execv(sys.argv[0], sys.argv)

    elif c_type == "rescan":
        subprocess.run(["nmcli", "dev", "wifi", "rescan"])
        notify("Wi-Fi Rescanned", "Network scan completed.", icon="network-wireless")
        os.execv(sys.argv[0], sys.argv)

    elif c_type == "nmtui":
        subprocess.Popen(["kitty", "--class", "floating_terminal", "-e", "nmtui"])
        sys.exit(0)

    elif c_type == "wifi":
        target_ssid = chosen["ssid"]
        if chosen["is_conn"]:
            notify("Already Connected", f"You are already connected to {target_ssid}.", icon="network-wireless")
            sys.exit(0)

        # Check if already saved in NetworkManager connections
        saved_cons = run_cmd(["nmcli", "-t", "-f", "NAME", "c", "show"]).splitlines()
        if target_ssid in saved_cons:
            notify("Connecting...", f"Connecting to saved network: {target_ssid}", icon="network-wireless")
            res = subprocess.run(["nmcli", "con", "up", "id", target_ssid], capture_output=True)
            if res.returncode == 0:
                notify("Connected", f"Successfully connected to {target_ssid}.", icon="network-wireless")
                portal_bin = shutil.which("portal-login") or os.path.expanduser("~/.local/bin/portal-login")
                subprocess.Popen([portal_bin, "--auto"])
            else:
                notify("Connection Failed", f"Failed to connect to {target_ssid}.", icon="network-error")
            sys.exit(0)

        # If open network, connect directly
        if chosen["is_open"]:
            notify("Connecting...", f"Connecting to open network: {target_ssid}", icon="network-wireless")
            res = subprocess.run(["nmcli", "dev", "wifi", "connect", target_ssid], capture_output=True)
            if res.returncode == 0:
                notify("Connected", f"Successfully connected to {target_ssid}.", icon="network-wireless")
                portal_bin = shutil.which("portal-login") or os.path.expanduser("~/.local/bin/portal-login")
                subprocess.Popen([portal_bin, "--auto"])
            else:
                notify("Connection Failed", f"Failed to connect to {target_ssid}.", icon="network-error")
            sys.exit(0)

        # Prompt password using compact modal
        pass_proc = subprocess.Popen([
            "rofi",
            "-no-config",
            "-dmenu",
            "-password",
            "-theme", RASI_THEME,
            "-theme-str", 'listview { lines: 0; padding: 0; } window { width: 480px; } entry { placeholder: "Password..."; }',
            "-p", "󰌾",
            "-mesg", f"Enter Wi-Fi password for {target_ssid}"
        ], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)

        pass_out, _ = pass_proc.communicate()
        if pass_proc.returncode != 0 or not pass_out.strip():
            sys.exit(0)

        password = pass_out.strip()
        notify("Connecting...", f"Authenticating with {target_ssid}...", icon="network-wireless")
        res = subprocess.run(["nmcli", "dev", "wifi", "connect", target_ssid, "password", password], capture_output=True)
        if res.returncode == 0:
            notify("Connected", f"Successfully connected to {target_ssid}.", icon="network-wireless")
            portal_bin = shutil.which("portal-login") or os.path.expanduser("~/.local/bin/portal-login")
            subprocess.Popen([portal_bin, "--auto"])
        else:
            notify("Connection Failed", f"Incorrect password or failed to connect to {target_ssid}.", icon="network-error")
        sys.exit(0)

if __name__ == "__main__":
    main()
