    def _build_ui(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root.set_name("network-window")
        root.set_size_request(540, 520)
        self.add(root)

        # 1. Header Wrapper
        header = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        header.set_name("header-wrapper")

        top_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        
        # Title & Status Subtitle
        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.title_lbl = Gtk.Label(label="󰖩  Wi-Fi Networks", xalign=0)
        self.title_lbl.get_style_context().add_class("header-title")
        self.status_lbl = Gtk.Label(label="Checking connectivity...", xalign=0)
        self.status_lbl.get_style_context().add_class("header-subtitle")
        title_box.pack_start(self.title_lbl, False, False, 0)
        title_box.pack_start(self.status_lbl, False, False, 0)
        top_row.pack_start(title_box, True, True, 0)

        # Radio Switch Toggle Button
        self.switch_btn = Gtk.Button(label="󰐥 ON")
        self.switch_btn.get_style_context().add_class("wifi-switch-btn")
        self.switch_btn.get_style_context().add_class("active")
        self.switch_btn.connect("clicked", self.on_switch_clicked)
        top_row.pack_start(self.switch_btn, False, False, 0)
        header.pack_start(top_row, False, False, 0)

        # Search Box
        search_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        search_box.set_name("search-box")
        s_icon = Gtk.Label(label="")
        s_icon.get_style_context().add_class("search-icon")
        self.search_entry = Gtk.Entry()
        self.search_entry.set_name("search-entry")
        self.search_entry.set_placeholder_text("Filter Wi-Fi networks...")
        self.search_entry.connect("changed", self.on_search_changed)
        search_box.pack_start(s_icon, False, False, 0)
        search_box.pack_start(self.search_entry, True, True, 0)
        header.pack_start(search_box, False, False, 0)

        root.pack_start(header, False, False, 0)

        # 2. Main Scrollable List Area (PURE SSIDs ONLY)
        self.scrolled = Gtk.ScrolledWindow()
        self.scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        self.listbox.set_name("list-container")
        self.scrolled.add(self.listbox)
        root.pack_start(self.scrolled, True, True, 0)

        # 3. Dedicated Footer Action Toolbar (REAL BUTTONS)
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        footer.set_name("footer-bar")

        # Captive Portal Button (Alt+P)
        self.portal_btn = Gtk.Button(label="󰖟 Portal")
        self.portal_btn.get_style_context().add_class("footer-action-btn")
        self.portal_btn.get_style_context().add_class("portal")
        self.portal_btn.set_tooltip_text("Open Captive Portal Login (Alt+P)")
        self.portal_btn.connect("clicked", lambda w: (self.close_and_exit(), self.action_portal()))
        footer.pack_start(self.portal_btn, True, True, 0)

        # Disconnect Button (Alt+D)
        self.disconn_btn = Gtk.Button(label="󰅖 Disconnect")
        self.disconn_btn.get_style_context().add_class("footer-action-btn")
        self.disconn_btn.get_style_context().add_class("danger")
        self.disconn_btn.set_tooltip_text("Disconnect Active Network (Alt+D)")
        self.disconn_btn.connect("clicked", lambda w: self.action_disconnect())
        footer.pack_start(self.disconn_btn, True, True, 0)

        # Rescan Button (Alt+R)
        self.rescan_btn = Gtk.Button(label="󰑐 Rescan")
        self.rescan_btn.get_style_context().add_class("footer-action-btn")
        self.rescan_btn.set_tooltip_text("Scan Available Networks (Alt+R)")
        self.rescan_btn.connect("clicked", lambda w: self.refresh_state(rescan=True))
        footer.pack_start(self.rescan_btn, True, True, 0)

        # Network Settings Button (Alt+S)
        self.settings_btn = Gtk.Button(label="󰢻 Settings")
        self.settings_btn.get_style_context().add_class("footer-action-btn")
        self.settings_btn.set_tooltip_text("Open Network Manager Settings (Alt+S)")
        self.settings_btn.connect("clicked", lambda w: (self.close_and_exit(), subprocess.Popen(["kitty", "--class", "floating_terminal", "-e", "nmtui"])))
        footer.pack_start(self.settings_btn, True, True, 0)

        root.pack_start(footer, False, False, 0)

    def position_window(self):
        display = Gdk.Display.get_default()
        screen = display.get_default_screen()
        monitor = display.get_primary_monitor() or display.get_monitor_at_point(0, 0)
        geom = monitor.get_geometry()

        win_w, win_h = 540, 520
        # Position top-right near Polybar Wi-Fi indicator
        x = geom.x + geom.width - win_w - 18
        y = geom.y + 44
        self.move(x, y)

    def refresh_state(self, rescan=False):
        if self.is_scanning:
            return
        self.is_scanning = True
        self.rescan_btn.set_label("󰑐 Scanning...")

        def worker():
            devs = run_cmd(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "dev"]).splitlines()
            wifi_dev = ""
            active_ssid = ""
            active_ip = ""

            for line in devs:
                parts = line.split(":")
                if len(parts) >= 2 and parts[1] == "wifi":
                    wifi_dev = parts[0]
                    if len(parts) >= 4 and parts[2] == "connected":
                        active_ssid = parts[3]
                    break

            radio_state = run_cmd(["nmcli", "radio", "wifi"]) == "enabled"

            if active_ssid:
                ip_out = run_cmd(["ip", "-4", "addr", "show", wifi_dev])
                m = re.search(r"inet\s+(\d+\.\d+\.\d+\.\d+)", ip_out)
                if m:
                    active_ip = m.group(1)

            nets = []
            if radio_state and wifi_dev:
                if rescan:
                    run_cmd(["nmcli", "dev", "wifi", "rescan"])
                raw_out = run_cmd(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY,CHAN", "dev", "wifi", "list", "--rescan", "no"])
                if not raw_out.strip():
                    raw_out = run_cmd(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY,CHAN", "dev", "wifi", "list"])

                raw_nets = {}
                for line in raw_out.splitlines():
                    if not line:
                        continue
                    p = line.split(":")
                    if len(p) < 5:
                        continue
                    in_use = p[0].strip() == "*"
                    ssid = p[1].strip()
                    if not ssid:
                        continue
                    sig_int = int(p[2]) if p[2].isdigit() else 0
                    sec = p[3].strip()
                    chan_int = int(p[4]) if p[4].isdigit() else 1

                    if ssid not in raw_nets or in_use or sig_int > raw_nets[ssid]["signal"]:
                        raw_nets[ssid] = {
                            "in_use": in_use,
                            "ssid": ssid,
                            "signal": sig_int,
                            "security": sec,
                            "chan": chan_int,
                        }

                nets = sorted(raw_nets.values(), key=lambda x: (not x["in_use"], -x["signal"]))

            GLib.idle_add(self.update_ui_state, wifi_dev, radio_state, active_ssid, active_ip, nets)

        threading.Thread(target=worker, daemon=True).start()

    def update_ui_state(self, wifi_dev, radio_state, active_ssid, active_ip, nets):
        self.wifi_dev = wifi_dev
        self.wifi_enabled = radio_state
        self.active_ssid = active_ssid
        self.all_networks = nets
        self.is_scanning = False
        self.rescan_btn.set_label("󰑐 Rescan")

        # Update Switch button
        if self.wifi_enabled:
            self.switch_btn.set_label("󰐥 ON")
            self.switch_btn.get_style_context().add_class("active")
        else:
            self.switch_btn.set_label("󰐥 OFF")
            self.switch_btn.get_style_context().remove_class("active")

        # Update Subtitle Status
        if self.active_ssid:
            self.status_lbl.set_markup(f'Connected to <b>{self.active_ssid}</b> ({active_ip or "No IP"})')
            self.disconn_btn.set_sensitive(True)
        elif not self.wifi_enabled:
            self.status_lbl.set_text("Wi-Fi Radio is Turned Off")
            self.disconn_btn.set_sensitive(False)
        else:
            self.status_lbl.set_text("Disconnected · Select a network to connect")
            self.disconn_btn.set_sensitive(False)

        self.render_network_list(self.all_networks)

    def render_network_list(self, nets):
        for child in self.listbox.get_children():
            self.listbox.remove(child)

        query = self.search_entry.get_text().strip().lower()
        if query:
            filtered = [n for n in nets if query in n["ssid"].lower()]
        else:
            filtered = nets

        if not filtered:
            lbl = Gtk.Label(label="No Wi-Fi networks found in range" if self.wifi_enabled else "Turn on Wi-Fi to scan networks")
            lbl.get_style_context().add_class("ssid-meta")
            lbl.set_padding(20, 20)
            self.listbox.add(lbl)
            self.listbox.show_all()
            return

        for net in filtered:
            row = Gtk.ListBoxRow()
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            box.get_style_context().add_class("ssid-row")
            if net["in_use"]:
                box.get_style_context().add_class("connected")

            # Signal Icon
            sig = net["signal"]
            if net["in_use"]:
                s_icon = "󰖩"
            elif sig >= 70:
                s_icon = "󰤨"
            elif sig >= 50:
                s_icon = "󰤥"
            elif sig >= 25:
                s_icon = "󰤢"
            else:
                s_icon = "󰤟"

            icon_lbl = Gtk.Label(label=s_icon)
            icon_lbl.get_style_context().add_class("ssid-name")
            box.pack_start(icon_lbl, False, False, 0)

            # SSID & Security details
            info_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            ssid_lbl = Gtk.Label(label=net["ssid"], xalign=0)
            ssid_lbl.get_style_context().add_class("ssid-name")
            ssid_lbl.set_ellipsize(Pango.EllipsizeMode.END)
            ssid_lbl.set_max_width_chars(24)

            sec_str = "Open" if (not net["security"] or net["security"] == "--") else "Protected (WPA/WPA2)"
            meta_lbl = Gtk.Label(label=sec_str, xalign=0)
            meta_lbl.get_style_context().add_class("ssid-meta")
            info_box.pack_start(ssid_lbl, False, False, 0)
            info_box.pack_start(meta_lbl, False, False, 0)
            box.pack_start(info_box, True, True, 0)

            # Badges (Connected, Band, Signal)
            if net["in_use"]:
                badge = Gtk.Label(label="CONNECTED")
                badge.get_style_context().add_class("badge-connected")
                box.pack_start(badge, False, False, 0)

            band_txt = "5GHz" if net["chan"] > 14 else "2.4G"
            band_lbl = Gtk.Label(label=band_txt)
            band_lbl.get_style_context().add_class("badge-band")
            box.pack_start(band_lbl, False, False, 0)

            sig_lbl = Gtk.Label(label=f"{sig}%")
            sig_lbl.get_style_context().add_class("ssid-meta")
            box.pack_start(sig_lbl, False, False, 0)

            row.add(box)
            row.connect("activate", lambda r, n=net: self.on_ssid_selected(n))
            self.listbox.add(row)

        self.listbox.show_all()

    def on_search_changed(self, entry):
        self.render_network_list(self.all_networks)

    def on_switch_clicked(self, btn):
        if self.wifi_enabled:
            subprocess.run(["nmcli", "radio", "wifi", "off"])
            notify("Wi-Fi Disabled", "Wi-Fi radio turned off.")
        else:
            subprocess.run(["nmcli", "radio", "wifi", "on"])
            notify("Wi-Fi Enabled", "Scanning for networks...")
        self.refresh_state(rescan=True)

    def on_ssid_selected(self, net):
        target = net["ssid"]
        if net["in_use"]:
            notify("Wi-Fi", f"Already connected to {target}.")
            return

        saved = run_cmd(["nmcli", "-t", "-f", "NAME", "c", "show"]).splitlines()
        is_open = not net["security"] or net["security"] == "--"

        if target in saved:
            notify("Connecting...", f"Connecting to saved network {target}...")
            res = subprocess.run(["nmcli", "con", "up", "id", target], capture_output=True)
            if res.returncode == 0:
                notify("Connected", f"Successfully connected to {target}.")
            else:
                notify("Failed", f"Could not connect to {target}.")
            self.refresh_state()
        elif is_open:
            notify("Connecting...", f"Connecting to open network {target}...")
            res = subprocess.run(["nmcli", "dev", "wifi", "connect", target], capture_output=True)
            if res.returncode == 0:
                notify("Connected", f"Successfully connected to {target}.")
                subprocess.Popen([os.path.expanduser("~/.local/bin/portal-login"), "--auto"])
            else:
                notify("Failed", f"Could not connect to {target}.")
            self.refresh_state()
        else:
            # Prompt password via floating terminal
            self.close_and_exit()
            subprocess.Popen([
                "kitty", "--class", "floating_terminal", "-e",
                "bash", "-c", f"echo 'Connecting to {target}...'; nmcli dev wifi connect '{target}' --ask; read -n1 -r -p 'Press any key to finish...'"
            ])

    def action_portal(self):
        portal_bin = shutil.which("portal-login") or os.path.expanduser("~/.local/bin/portal-login")
        subprocess.Popen([portal_bin])

    def action_disconnect(self):
        if self.active_ssid:
            subprocess.run(["nmcli", "con", "down", "id", self.active_ssid])
            notify("Disconnected", f"Disconnected from {self.active_ssid}.")
            self.refresh_state()

    def on_key_press(self, widget, event):
        keyval = event.keyval
        state = event.state

        # Escape closes
        if keyval == Gdk.KEY_Escape:
            self.close_and_exit()
            return True

        # Alt + Shortcuts
        if state & Gdk.ModifierType.MOD1_MASK:
            if keyval in (Gdk.KEY_p, Gdk.KEY_P):
                self.close_and_exit()
                self.action_portal()
                return True
            elif keyval in (Gdk.KEY_d, Gdk.KEY_D):
                self.action_disconnect()
                return True
            elif keyval in (Gdk.KEY_r, Gdk.KEY_R):
                self.refresh_state(rescan=True)
                return True
            elif keyval in (Gdk.KEY_s, Gdk.KEY_S):
                self.close_and_exit()
                subprocess.Popen(["kitty", "--class", "floating_terminal", "-e", "nmtui"])
                return True

        return False

def main():
    win = NetworkMenuWindow()
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
