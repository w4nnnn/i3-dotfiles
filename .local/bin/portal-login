#!/usr/bin/env bash
# ==============================================================================
# Catppuccin Mocha - Captive Portal Helper & Auto-Login Assistant
# ==============================================================================

# Function to get default gateway IP
get_gateway() {
    ip route 2>/dev/null | awk '/^default/ {print $3}' | head -n 1
}

# Function to detect redirect / portal URL
detect_portal_url() {
    local gateway="$1"
    local redirect_url=""
    
    # 1. Probe Google 204 endpoint (captures Location header on HTTP redirect)
    redirect_url=$(curl -sI -m 4 "http://connectivitycheck.gstatic.com/generate_204" 2>/dev/null | grep -i '^Location:' | awk '{print $2}' | tr -d '\r\n')
    
    # 2. Probe Firefox detection endpoint if not found
    if [ -z "$redirect_url" ]; then
        redirect_url=$(curl -sI -m 4 "http://detectportal.firefox.com/success.txt" 2>/dev/null | grep -i '^Location:' | awk '{print $2}' | tr -d '\r\n')
    fi

    # 3. Probe Apple captive endpoint if not found
    if [ -z "$redirect_url" ]; then
        redirect_url=$(curl -sI -m 4 "http://captive.apple.com/hotspot-detect.html" 2>/dev/null | grep -i '^Location:' | awk '{print $2}' | tr -d '\r\n')
    fi

    # 4. If a valid HTTP/HTTPS URL was detected in Location header, return it
    if [[ "$redirect_url" =~ ^https?:// ]]; then
        echo "$redirect_url"
        return 0
    fi

    # 5. Check if gateway IP responds to HTTP
    if [ -n "$gateway" ] && curl -s -m 2 "http://${gateway}" >/dev/null 2>&1; then
        echo "http://${gateway}"
        return 0
    fi

    # 6. Default fallback: neverssl.com (unencrypted HTTP designed to trigger portal intercepts)
    echo "http://neverssl.com"
}

# Function to check connectivity state
check_portal() {
    # Method 1: Check NetworkManager connectivity status
    local conn
    conn=$(nmcli -t -f CONNECTIVITY general status 2>/dev/null)
    if [ "$conn" = "full" ]; then
        return 1 # Definitely normal internet, no portal
    fi

    # Verify active gateway exists
    local gateway
    gateway=$(get_gateway)
    if [ -z "$gateway" ]; then
        return 1 # Not connected to any gateway
    fi

    # Method 2: Active probe via Google generate_204
    # Genuine connection returns HTTP 204 No Content.
    # Captive portal returns HTTP 301/302/307/308 redirect or HTTP 200 with HTML portal.
    local http_code
    http_code=$(curl -s -o /dev/null -w "%{http_code}" -m 4 "http://connectivitycheck.gstatic.com/generate_204" 2>/dev/null)

    if [ "$http_code" = "204" ]; then
        return 1 # Normal internet verified
    elif [[ "$http_code" =~ ^(301|302|303|307|308)$ ]]; then
        return 0 # Captive portal HTTP redirect detected!
    elif [ "$http_code" = "200" ]; then
        return 0 # Intercepted 204 with HTML body
    fi

    # Method 3: Fallback probe via Firefox endpoint
    # Genuine connection returns HTTP 200 with body "success".
    local ff_probe ff_code ff_body
    ff_probe=$(curl -s -w "\n%{http_code}" -m 4 "http://detectportal.firefox.com/success.txt" 2>/dev/null)
    ff_code=$(echo "$ff_probe" | tail -n 1)
    ff_body=$(echo "$ff_probe" | head -n -1 | tr -d '\r\n ')

    if [ "$ff_code" = "200" ] && [ "$ff_body" = "success" ]; then
        return 1 # Normal internet verified
    elif [[ "$ff_code" =~ ^(301|302|303|307|308)$ ]]; then
        return 0 # Captive portal HTTP redirect detected!
    elif [ "$ff_code" = "200" ] && [ -n "$ff_body" ] && [ "$ff_body" != "success" ]; then
        return 0 # Intercepted HTML portal page!
    fi

    # Method 4: Trust NetworkManager portal status as last resort
    if [ "$conn" = "portal" ]; then
        return 0
    fi

    # All other cases (e.g. timeout 000, offline) are not captive portals
    return 1
}

# Function to launch browser
open_browser() {
    local target_url="$1"
    
    if command -v brave >/dev/null 2>&1; then
        brave "$target_url" >/dev/null 2>&1 &
    elif [ -n "$BROWSER" ] && command -v "$BROWSER" >/dev/null 2>&1; then
        "$BROWSER" "$target_url" >/dev/null 2>&1 &
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$target_url" >/dev/null 2>&1 &
    else
        notify-send -a "Network" -u critical -i network-error "Browser Not Found" "Tidak dapat menemukan browser (Brave / xdg-open)."
        return 1
    fi
}

# ------------------------------------------------------------------------------
# Argument Handling
# ------------------------------------------------------------------------------

# 1. Auto mode: wait briefly for DHCP and launch if portal is detected
if [ "$1" = "--auto" ]; then
    sleep 3
    if check_portal; then
        GATEWAY=$(get_gateway)
        PORTAL_URL=$(detect_portal_url "$GATEWAY")
        notify-send -a "Network" -u critical -i network-wireless \
            "Captive Portal Terdeteksi" \
            "Wi-Fi memerlukan login web.\nMembuka browser: ${PORTAL_URL}"
        open_browser "$PORTAL_URL"
    fi
    exit 0
fi

# 2. Check mode: print status and exit code
if [ "$1" = "--check" ]; then
    if check_portal; then
        echo "portal"
        exit 0
    else
        echo "online"
        exit 1
    fi
fi

# 3. Manual invocation: trigger portal login
GATEWAY=$(get_gateway)
if [ -z "$GATEWAY" ]; then
    notify-send -a "Network" -u critical -i network-offline \
        "Tidak Terhubung" \
        "Tidak ada koneksi jaringan atau gateway aktif."
    exit 1
fi

PORTAL_URL=$(detect_portal_url "$GATEWAY")

if check_portal; then
    notify-send -a "Network" -u critical -i network-wireless \
        "Captive Portal Terdeteksi" \
        "Wi-Fi memerlukan login web.\nMembuka browser: ${PORTAL_URL}"
else
    notify-send -a "Network" -i network-wireless \
        "Pemeriksaan Captive Portal" \
        "Internet terdeteksi aktif/normal.\nMembuka web browser: ${PORTAL_URL}"
fi

open_browser "$PORTAL_URL"
exit 0
