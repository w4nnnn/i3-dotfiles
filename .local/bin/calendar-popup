#!/usr/bin/env python3
import sys
import os
import signal
import subprocess

# If already running, kill existing instance and exit (toggle behavior)
pid_file = "/tmp/catppuccin_calendar.pid"
if os.path.exists(pid_file):
    try:
        with open(pid_file, "r") as f:
            old_pid = int(f.read().strip())
        os.remove(pid_file)
        os.kill(old_pid, signal.SIGTERM)
        sys.exit(0)
    except Exception:
        pass

with open(pid_file, "w") as f:
    f.write(str(os.getpid()))

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

# Load Theme from dotfiles library
lib_path = os.path.expanduser("~/.local/lib")
if lib_path not in sys.path:
    sys.path.insert(0, lib_path)

try:
    from dotfiles.themes import get_current_theme
    t = get_current_theme()
except ImportError:
    t = {
        "bg_rgba": "rgba(30, 30, 46, 0.85)",
        "accent": "#cba6f7",
        "fg": "#cdd6f4",
        "accent_contrast": "#11111b",
        "yellow": "#fab387",
        "blue": "#89b4fa",
    }

bg_card = t.get("bg_rgba", "rgba(30, 30, 46, 0.85)")
accent = t.get("accent", "#cba6f7")
fg = t.get("fg", "#cdd6f4")
contrast = t.get("accent_contrast", "#11111b")
highlight = t.get("yellow", "#fab387")
btn = t.get("blue", "#89b4fa")

class CatppuccinCalendar(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("CatppuccinCalendar")
        self.set_role("calendar-popup")
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_resizable(False)
        self.taking_screenshot = False

        # Support true RGBA transparency on X11
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)

        # Apply Dynamic CSS styling
        css = f"""
        window {{
            background-color: transparent;
        }}
        #calendar-card {{
            background-color: {bg_card};
            border: 2px solid {accent};
            border-radius: 16px;
            padding: 16px;
        }}
        calendar {{
            background-color: transparent;
            color: {fg};
            border: none;
            font-family: 'JetBrainsMono Nerd Font';
            font-size: 10pt;
        }}
        calendar:selected {{
            background-color: {accent};
            color: {contrast};
            border-radius: 6px;
        }}
        calendar.header {{
            color: {accent};
            font-weight: bold;
        }}
        calendar.highlight {{
            color: {highlight};
        }}
        calendar.button {{
            color: {btn};
        }}
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css.encode())
        Gtk.StyleContext.add_provider_for_screen(
            screen,
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        # Dedicated card box to cleanly hold padding and border
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        card.set_name("calendar-card")
        self.add(card)

        self.calendar = Gtk.Calendar()
        self.calendar.set_display_options(
            Gtk.CalendarDisplayOptions.SHOW_HEADING |
            Gtk.CalendarDisplayOptions.SHOW_DAY_NAMES
        )
        card.pack_start(self.calendar, True, True, 0)

        # Close on Escape, allow Screenshot on PrintScreen, close on Focus Out
        self.connect("key-press-event", self.on_key_press)
        self.connect("focus-out-event", self.on_focus_out)
        self.connect("destroy", self.cleanup)

        # Show and position directly below Polybar in screen center
        self.show_all()
        self.set_position_below_bar()
        self.apply_cursor()

    def apply_cursor(self):
        display = Gdk.Display.get_default()
        cursor = Gdk.Cursor.new_from_name(display, "default")
        if not cursor:
            cursor = Gdk.Cursor.new_from_name(display, "left_ptr")
        if cursor and self.get_window():
            self.get_window().set_cursor(cursor)

    def set_position_below_bar(self):
        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor() or display.get_monitor_at_point(0, 0)
        geom = monitor.get_geometry()
        min_sz, nat_sz = self.get_preferred_size()
        pos_x = geom.x + (geom.width - nat_sz.width) // 2
        pos_y = geom.y + 44  # Just below 36px Polybar
        self.move(pos_x, pos_y)

    def on_key_press(self, widget, event):
        if event.keyval in (Gdk.KEY_Escape, Gdk.KEY_Return):
            self.close_and_exit()
            return True
        elif event.keyval == Gdk.KEY_Print:
            self.taking_screenshot = True
            bin_dir = os.path.expanduser("~/.local/bin")
            if event.state & Gdk.ModifierType.SHIFT_MASK:
                subprocess.Popen([os.path.join(bin_dir, "screenshot"), "full"])
            else:
                subprocess.Popen([os.path.join(bin_dir, "screenshot"), "select"])
            GLib.timeout_add(1500, lambda: setattr(self, "taking_screenshot", False))
            return True
        return False

    def on_focus_out(self, widget, event):
        if getattr(self, "taking_screenshot", False):
            return False
        self.close_and_exit()
        return False

    def close_and_exit(self):
        self.destroy()
        Gtk.main_quit()

    def cleanup(self, *args):
        if os.path.exists(pid_file):
            try:
                os.remove(pid_file)
            except Exception:
                pass

if __name__ == "__main__":
    win = CatppuccinCalendar()
    Gtk.main()
