#!/usr/bin/env python3
import sys
import os
import signal
import subprocess

# If already running, kill existing instance and exit (toggle behavior)
pid_file = "/tmp/catppuccin_calendar.pid"
if os.path.exists(pid_file):
    try:
        with open(pid_file, "r") as f:
            old_pid = int(f.read().strip())
        os.remove(pid_file)
        os.kill(old_pid, signal.SIGTERM)
        sys.exit(0)
    except Exception:
        pass

with open(pid_file, "w") as f:
    f.write(str(os.getpid()))

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

# Load Theme Preference
THEME_PREF_FILE = os.path.expanduser("~/.config/control-center-theme")
current_theme_key = "catppuccin"
if os.path.exists(THEME_PREF_FILE):
    try:
        with open(THEME_PREF_FILE) as f:
            t_key = f.read().strip()
            if t_key:
                current_theme_key = t_key
    except Exception:
        pass

THEMES = {
    "catppuccin": {
        "bg_card": "rgba(30, 30, 46, 0.82)",
        "accent": "#cba6f7",
        "fg": "#cdd6f4",
        "contrast": "#11111b",
        "highlight": "#fab387",
        "btn": "#89b4fa",
    },
    "tokyo-night": {
        "bg_card": "rgba(26, 27, 38, 0.82)",
        "accent": "#7aa2f7",
        "fg": "#c0caf5",
        "contrast": "#16161e",
        "highlight": "#e0af68",
        "btn": "#bb9af7",
    },
    "nord": {
        "bg_card": "rgba(46, 52, 64, 0.82)",
        "accent": "#88c0d0",
        "fg": "#eceff4",
        "contrast": "#242933",
        "highlight": "#ebcb8b",
        "btn": "#81a1c1",
    },
    "oled": {
        "bg_card": "rgba(9, 9, 11, 0.85)",
        "accent": "#38bdf8",
        "fg": "#ffffff",
        "contrast": "#000000",
        "highlight": "#f59e0b",
        "btn": "#34d399",
    },
    "light": {
        "bg_card": "rgba(255, 255, 255, 0.85)",
        "accent": "#0284c7",
